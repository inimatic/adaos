	"python.defaultInterpreterPath": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
	"python.analysis.typeCheckingMode": "off",
	"cSpell.language": "en,ru",
	"editor.formatOnSave": true,
	"black-formatter.args": ["--line-length", "180"],
	"plantuml.includepaths": ["docs/diagrams/style", "docs/diagrams/src"],
	"plantuml.diagramsRoot": "docs/diagrams/src",
	"plantuml.exportOutDir": "docs/diagrams/out",
	"python.pylanceLspNotebooksEnabled": false,
	"jupyter.pylanceHandlesNotebooks": false,
	"scm.experimental.showHistoryGraph": false,
	"git.scanRepositories": ["docs-development"],
	"git.ignoredRepositories": ["internals"],
	"git.repositoryScanIgnoredFolders": [
		"node_modules",
		".venv",
		".tmp",
		".codex-tmp",
		".pytest_cache",
		".ruff_cache",
		".adaos",
		".runtime",
		"build",
		"site",
		"reports",
		"e2e/artifacts",
		"test-results"
	],
	"files.watcherExclude": {
		"**/.tmp/**": true,
		"**/.codex-tmp/**": true,
		"**/.pytest_cache/**": true,
		"**/.ruff_cache/**": true,
		"**/.adaos/tmp/**": true,
		"**/.adaos/cache/**": true,
		"**/.adaos/build/**": true,
		"**/.adaos/gc/**": true,
		"**/.adaos/diagnostics/**": true,
		"**/.adaos/recovery/**": true,
		"**/.adaos/test_runs/**": true,
		"**/.adaos/test-artifacts/**": true,
		"**/.adaos/state/**": true,
		"**/.adaos/workspace/**": true,
		"**/.adaos/trials/**": true,
		"**/.adaos/logs/**": true,
		"**/.runtime/**": true,
		"**/build/**": true,
		"**/site/**": true,
		"**/reports/**": true,
		"**/e2e/artifacts/**": true,
		"**/test-results/**": true,
		"**/node_modules/**": true,
		"**/.venv/**": true
	},
	"search.exclude": {
		"**/.tmp/**": true,
		"**/.codex-tmp/**": true,
		"**/.pytest_cache/**": true,
		"**/.ruff_cache/**": true,
		"**/.adaos/tmp/**": true,
		"**/.adaos/cache/**": true,
		"**/.adaos/build/**": true,
		"**/.adaos/gc/**": true,
		"**/.adaos/diagnostics/**": true,
		"**/.adaos/recovery/**": true,
		"**/.adaos/test_runs/**": true,
		"**/.adaos/test-artifacts/**": true,
		"**/.adaos/state/**": true,
		"**/.adaos/workspace/**": true,
		"**/.adaos/trials/**": true,
		"**/.adaos/logs/**": true,
		"**/.runtime/**": true,
		"**/build/**": true,
		"**/site/**": true,
		"**/reports/**": true,
		"**/e2e/artifacts/**": true,
		"**/test-results/**": true,
		"**/node_modules/**": true,
		"**/.venv/**": true
	},
	"workbench.iconTheme": "vscode-icons",
	"[python]": {
		"editor.formatOnType": true
	},
	"prettier.configPath": "src/adaos/integrations/adaos-client/.prettierrc",
	"editor.defaultFormatter": "esbenp.prettier-vscode",
	"liveServer.settings.donotShowInfoMsg": true,
	"[markdown]": {
		"editor.defaultFormatter": "DavidAnson.vscode-markdownlint"
	},
	"eslint.codeActionsOnSave.rules": null,
	"files.insertFinalNewline": false,
	"yaml.schemas": {
		"./src/adaos/abi/scenario.schema.json": ".adaos/scenarios/**/scenario.yaml",
		"./src/adaos/abi/skill.schema.json": ".adaos/skills/**/skill.yaml"
	}
}
