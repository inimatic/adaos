{
  "schema": "adaos.e2e.application_journey.v1",
  "steps": [
    {"id":"new","type":"command","widget":"registration_actions","command":"register"},
    {"id":"project","type":"fill","widget":"register_editor","field":"project","value":"${marker}-project"},
    {"id":"title","type":"fill","widget":"register_editor","field":"title","value":"${marker}-image"},
    {"id":"type","type":"select","widget":"register_editor","field":"type","label":"Изображение"},
    {"id":"edition","type":"fill","widget":"register_editor","field":"edition","value":"1"},
    {"id":"url","type":"fill","widget":"register_editor","field":"url","value":"https://interactive-examples.mdn.mozilla.net/media/cc0-images/grapefruit-slice-332-332.jpg"},
    {"id":"cover","type":"fill","widget":"register_editor","field":"cover","value":"https://interactive-examples.mdn.mozilla.net/media/cc0-images/grapefruit-slice-332-332.jpg"},
    {"id":"editor","type":"screenshot"},
    {"id":"save","type":"submit","widget":"register_editor","command":"save","tool":"register_media","capture":{"image":"item.id"}},
    {"id":"image-row","type":"row","widget":"media_collection","text":"${marker}-image"},
    {"id":"image-rendered","type":"media","widget":"media_details","state":"ready","kind":"image"},
    {"id":"image-view","type":"screenshot"},
    {"id":"comment","type":"command","widget":"open-comment_editor","command":"new"},
    {"id":"parent-caption","type":"value","widget":"comment_editor","field":"title","value":"${marker}-image"},
    {"id":"region-kind","type":"select","widget":"comment_editor","field":"position_kind","label":"По области"},
    {"id":"region","type":"fill","widget":"comment_editor","field":"region","value":"Upper left caption"},
    {"id":"comment-text","type":"fill","widget":"comment_editor","field":"text","value":"${marker}-comment"},
    {"id":"request-fix","type":"submit","widget":"comment_editor","command":"cmd_request_fix","tool":"request_fix"},
    {"id":"comment-visible","type":"text","widget":"comments_collection","text":"${marker}-comment"},
    {"id":"needs-changes","type":"text","widget":"media_details","text":"Есть замечания"},
    {"id":"approval-editor","type":"command","widget":"media_details","command":"click:edit-media_approve_editor"},
    {"id":"reject-approval","type":"submit","widget":"media_approve_editor","command":"cmd_approve","tool":"approve_media","ok":false,"error":"review_rejected"},
    {"id":"close-rejected","type":"dismiss"},
    {"id":"resolve-editor","type":"row","widget":"comments_collection","text":"${marker}-comment"},
    {"id":"resolve","type":"submit","widget":"resolve_comment","command":"resolve","tool":"resolve_comment"},
    {"id":"resolved","type":"text","widget":"comments_collection","text":"Решено"},
    {"id":"approval-editor-again","type":"command","widget":"media_details","command":"click:edit-media_approve_editor"},
    {"id":"approve","type":"submit","widget":"media_approve_editor","command":"cmd_approve","tool":"approve_media"},
    {"id":"approved","type":"text","widget":"media_details","text":"Одобрено"},
    {"id":"next-edition","type":"command","widget":"registration_actions","command":"edition"},
    {"id":"retained-project","type":"value","widget":"edition_editor","field":"project","value":"${marker}-project"},
    {"id":"next-number","type":"fill","widget":"edition_editor","field":"edition","value":"2"},
    {"id":"next-title","type":"fill","widget":"edition_editor","field":"title","value":"${marker}-edition-two"},
    {"id":"save-edition","type":"submit","widget":"edition_editor","command":"save","tool":"register_media"},
    {"id":"new-not-approved","type":"text","widget":"media_details","text":"Ожидает проверки"},
    {"id":"new-comments-empty","type":"notText","widget":"comments_collection","text":"${marker}-comment"},
    {"id":"history-kept","type":"text","widget":"review_history","text":"approved"},
    {"id":"old-edition","type":"row","widget":"media_collection","text":"${marker}-image"},
    {"id":"old-comments-kept","type":"text","widget":"comments_collection","text":"${marker}-comment"},
    {"id":"old-approval-kept","type":"text","widget":"media_details","text":"Одобрено"},
    {"id":"new-video","type":"command","widget":"registration_actions","command":"register"},
    {"id":"video-project","type":"fill","widget":"register_editor","field":"project","value":"${marker}-project"},
    {"id":"video-title","type":"fill","widget":"register_editor","field":"title","value":"${marker}-video"},
    {"id":"video-type","type":"select","widget":"register_editor","field":"type","label":"Видео"},
    {"id":"video-edition","type":"fill","widget":"register_editor","field":"edition","value":"1"},
    {"id":"video-url","type":"fill","widget":"register_editor","field":"url","value":"https://interactive-examples.mdn.mozilla.net/media/cc0-videos/flower.mp4"},
    {"id":"video-cover","type":"fill","widget":"register_editor","field":"cover","value":"https://interactive-examples.mdn.mozilla.net/media/cc0-images/grapefruit-slice-332-332.jpg"},
    {"id":"save-video","type":"submit","widget":"register_editor","command":"save","tool":"register_media"},
    {"id":"video-row","type":"row","widget":"media_collection","text":"${marker}-video"},
    {"id":"video-playback","type":"media","widget":"media_details","state":"ready","kind":"video"},
    {"id":"video-view","type":"screenshot"},
    {"id":"video-comments-empty","type":"notText","widget":"comments_collection","text":"${marker}-comment"},
    {"id":"broken-edition","type":"command","widget":"registration_actions","command":"edition"},
    {"id":"broken-number","type":"fill","widget":"edition_editor","field":"edition","value":"2"},
    {"id":"broken-title","type":"fill","widget":"edition_editor","field":"title","value":"${marker}-unavailable"},
    {"id":"broken-url","type":"fill","widget":"edition_editor","field":"url","value":"https://interactive-examples.mdn.mozilla.net/media/cc0-videos/adaos-e2e-missing.mp4"},
    {"id":"save-broken","type":"submit","widget":"edition_editor","command":"save","tool":"register_media"},
    {"id":"unavailable","type":"media","widget":"media_details","state":"error","kind":"video"},
    {"id":"reload","type":"reload"},
    {"id":"persisted-old","type":"row","widget":"media_collection","text":"${marker}-image"},
    {"id":"persisted-approval","type":"text","widget":"media_details","text":"Одобрено"},
    {"id":"persisted-comment","type":"text","widget":"comments_collection","text":"${marker}-comment"},
    {"id":"cancel-new","type":"command","widget":"registration_actions","command":"register"},
    {"id":"cancel-title","type":"fill","widget":"register_editor","field":"title","value":"${marker}-cancelled"},
    {"id":"cancel","type":"dismiss"},
    {"id":"not-created","type":"notText","widget":"media_collection","text":"${marker}-cancelled"},
    {"id":"filters","type":"click","selector":"[data-webui-widget-id=queries-media_collection] .query-toolbar__toggle"},
    {"id":"project-filter","type":"fill","selector":"[data-query-id=query-q_project] input","value":"${marker}-project"},
    {"id":"filtered-project","type":"text","widget":"media_collection","text":"${marker}-image"},
    {"id":"wrong-project","type":"fill","selector":"[data-query-id=query-q_project] input","value":"${marker}-missing-project"},
    {"id":"empty-filter","type":"notText","widget":"media_collection","text":"${marker}-image"},
    {"id":"restore-project","type":"fill","selector":"[data-query-id=query-q_project] input","value":"${marker}-project"},
    {"id":"restored-project","type":"text","widget":"media_collection","text":"${marker}-image"},
    {"id":"finished","type":"screenshot"}
  ]
}
