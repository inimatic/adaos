{
  "schema": "adaos.e2e.application_journey.v1",
  "steps": [
    {"id":"new","type":"command","widget":"open-editor_create_ticket","command":"new"},
    {"id":"title","type":"fill","widget":"editor_create_ticket","field":"title","value":"${marker}"},
    {"id":"description","type":"fill","widget":"editor_create_ticket","field":"description","value":"Saved detail content"},
    {"id":"priority","type":"select","widget":"editor_create_ticket","field":"priority","label":"High"},
    {"id":"due","type":"fill","widget":"editor_create_ticket","field":"due_date","value":"2001-01-01"},
    {"id":"editor","type":"screenshot"},
    {"id":"save","type":"submit","widget":"editor_create_ticket","command":"create_ticket","tool":"create_ticket","capture":{"item":"item.id"}},
    {"id":"new-card","type":"text","selector":"[data-webui-board-lane-id=new] [data-webui-board-item-id='${item}']","text":"${marker}"},
    {"id":"details","type":"click","selector":"[data-webui-board-item-id='${item}'] .board-card__main"},
    {"id":"detail-content","type":"text","widget":"ticket_details","text":"Saved detail content"},
    {"id":"board-preserved","type":"text","widget":"tickets_board","text":"${marker}"},
    {"id":"drag","type":"drag","layouts":["wide"],"selector":"[data-webui-board-item-id='${item}'] .board-card__drag-handle","target":"[data-webui-board-lane-id=in_progress] .board-lane__items"},
    {"id":"compact-move","type":"select","layouts":["compact"],"selector":"[data-webui-board-item-id='${item}'] .board-card__move select","label":"In progress"},
    {"id":"moved","type":"text","selector":"[data-webui-board-lane-id=in_progress] [data-webui-board-item-id='${item}']","text":"${marker}"},
    {"id":"saved-status","type":"text","widget":"ticket_details","text":"In progress"},
    {"id":"stale-injection","type":"nextToolArguments","tool":"update_ticket","arguments":{"revision":1}},
    {"id":"stale-move","type":"select","selector":"[data-webui-board-item-id='${item}'] .board-card__move select","label":"Blocked"},
    {"id":"rollback-error","type":"text","widget":"tickets_board","text":"Could not move"},
    {"id":"rollback-lane","type":"text","selector":"[data-webui-board-lane-id=in_progress] [data-webui-board-item-id='${item}']","text":"${marker}"},
    {"id":"assign-editor","type":"command","widget":"ticket_details","command":"click:edit-editor_assign_ticket"},
    {"id":"owner","type":"select","widget":"editor_assign_ticket","field":"owner","label":"Sam"},
    {"id":"assign","type":"submit","widget":"editor_assign_ticket","command":"assign_ticket","tool":"update_ticket"},
    {"id":"owner-visible","type":"text","widget":"ticket_details","text":"Sam"},
    {"id":"status-editor","type":"command","widget":"ticket_details","command":"click:edit-editor_move_status"},
    {"id":"done","type":"select","widget":"editor_move_status","field":"status","label":"Done"},
    {"id":"save-status","type":"submit","widget":"editor_move_status","command":"move_ticket_status","tool":"update_ticket","confirm":"Move status"},
    {"id":"done-card","type":"text","selector":"[data-webui-board-lane-id=done] [data-webui-board-item-id='${item}']","text":"${marker}"},
    {"id":"reload","type":"reload"},
    {"id":"persisted-card","type":"text","selector":"[data-webui-board-lane-id=done] [data-webui-board-item-id='${item}']","text":"${marker}"},
    {"id":"select-persisted","type":"click","selector":"[data-webui-board-item-id='${item}'] .board-card__main"},
    {"id":"persisted-owner","type":"text","widget":"ticket_details","text":"Sam"},
    {"id":"new-cancel","type":"command","widget":"open-editor_create_ticket","command":"new"},
    {"id":"cancel-title","type":"fill","widget":"editor_create_ticket","field":"title","value":"${marker}-cancelled-draft"},
    {"id":"cancel","type":"command","widget":"editor_create_ticket","command":"cancel"},
    {"id":"not-created","type":"notText","widget":"tickets_board","text":"${marker}-cancelled-draft"},
    {"id":"finished","type":"screenshot"}
  ]
}
