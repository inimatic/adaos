    {"id":"rejected-move","type":"submit","widget":"v_ed_reschedule","command":"cmd_reschedule","tool":"schedule_move","ok":false,"error":"outside_working_interval"},
    {"id":"move-draft-kept","type":"value","widget":"v_ed_reschedule","field":"appointments.start_time","value":"08:00"},
    {"id":"valid-move-time","type":"fill","widget":"v_ed_reschedule","field":"appointments.start_time","value":"10:00"},
    {"id":"move","type":"submit","widget":"v_ed_reschedule","command":"cmd_reschedule","tool":"schedule_move"},
