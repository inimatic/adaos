    {"id":"canceled-visible","type":"text","widget":"v_day_appts","text":"Отменено"},
    {"id":"reload","type":"reload"},
    {"id":"reloaded-filter-open","type":"click","selector":"[data-webui-widget-id=\"queries-v_day_appts\"] .query-toolbar__toggle"},
    {"id":"reloaded-day","type":"fill","selector":"[data-webui-widget-id=\"queries-v_day_appts\"] input[type=date]","value":"2114-02-01"},
