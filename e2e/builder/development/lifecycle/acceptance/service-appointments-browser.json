    {"id":"free-service","type":"select","widget":"filters-v_free_slots","field":"query_qs_service","label":"${marker}-service"},
    {"id":"apply-free-filter","type":"command","widget":"filters-v_free_slots","command":"apply"},
    {"id":"freed-interval","type":"text","widget":"v_free_slots","text":"09:00"},
    {"id":"choose-free-slot","type":"row","widget":"v_free_slots","text":"09:00"},
    {"id":"book-slot","type":"command","widget":"book-slot","command":"book"},
    {"id":"slot-date-prefilled","type":"value","widget":"v_ed_create_appt","field":"appointments.date","value":"2114-02-01"},
    {"id":"slot-time-prefilled","type":"value","widget":"v_ed_create_appt","field":"appointments.start_time","value":"09:00"},
    {"id":"slot-client","type":"select","widget":"v_ed_create_appt","field":"client_ref","label":"${marker}"},
    {"id":"slot-create-enabled","type":"enabled","widget":"v_ed_create_appt","command":"cmd_create_appt"},
    {"id":"slot-editor","type":"screenshot"},
    {"id":"cancel-draft","type":"dismiss"},
    {"id":"draft-closed","type":"count","widget":"v_ed_create_appt","count":0}
