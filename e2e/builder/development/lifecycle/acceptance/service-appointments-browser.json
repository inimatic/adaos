    {"id":"client-visible","type":"text","widget":"directory-clients","text":"${marker}"},
    {"id":"new-master","type":"command","widget":"new-masters","command":"new"},
    {"id":"master-name","type":"fill","widget":"create-masters","field":"masters.name","value":"${marker}-master"},
    {"id":"working-days","type":"fill","widget":"create-masters","field":"work_days","value":"1,2,3,4,5,6,7"},
    {"id":"working-hours","type":"fill","widget":"create-masters","field":"work_intervals","value":"09:00-17:00"},
    {"id":"master-save","type":"submit","widget":"create-masters","command":"save","tool":"schedule_save_entity"},
    {"id":"master-visible","type":"text","widget":"directory-masters","text":"${marker}-master"},
    {"id":"new-service","type":"command","widget":"new-services","command":"new"},
    {"id":"service-name","type":"fill","widget":"create-services","field":"services.name","value":"${marker}-service"},
    {"id":"duration","type":"fill","widget":"create-services","field":"services.duration_min","value":"30"},
    {"id":"service-save","type":"submit","widget":"create-services","command":"save","tool":"schedule_save_entity"},
    {"id":"service-visible","type":"text","widget":"directory-services","text":"${marker}-service"},
    {"id":"day-filter-open","type":"click","selector":"[data-webui-widget-id=\"queries-v_day_appts\"] .query-toolbar__toggle"},
