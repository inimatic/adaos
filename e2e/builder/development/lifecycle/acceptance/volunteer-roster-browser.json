{
  "schema": "adaos.e2e.application_journey.v1",
  "steps": [
    {"id":"new-volunteer","type":"command","widget":"open-volunteer-editor","command":"new"},
    {"id":"name","type":"fill","widget":"volunteer_editor","field":"name","value":"${marker}"},
    {"id":"role","type":"select","widget":"volunteer_editor","field":"Volunteer.role","label":"Greeter"},
    {"id":"email","type":"fill","widget":"volunteer_editor","field":"contact_email","value":"browser@example.com"},
    {"id":"availability","type":"fill","widget":"volunteer_editor","field":"availability","value":"2116-02-01T08:00Z/2116-02-01T18:00Z"},
    {"id":"save-volunteer","type":"submit","widget":"volunteer_editor","command":"save","tool":"roster_save"},
    {"id":"volunteer-visible","type":"text","widget":"volunteers_collection","text":"${marker}"},
    {"id":"select-volunteer","type":"row","widget":"volunteers_collection","text":"${marker}"},
    {"id":"edit-volunteer","type":"command","widget":"open-volunteer-editor","command":"edit"},
    {"id":"email-restored","type":"value","widget":"volunteer_editor","field":"contact_email","value":"browser@example.com"},
    {"id":"change-name","type":"fill","widget":"volunteer_editor","field":"name","value":"${marker}-edited"},
    {"id":"save-edited","type":"submit","widget":"volunteer_editor","command":"save","tool":"roster_save"},
    {"id":"new-shift","type":"command","widget":"open-shift-editor","command":"new"},
    {"id":"shift-role","type":"select","widget":"shift_editor","field":"Shift.role","label":"Greeter"},
    {"id":"shift-start","type":"fill","widget":"shift_editor","field":"start","value":"2116-02-01T09:00Z"},
    {"id":"shift-end","type":"fill","widget":"shift_editor","field":"end","value":"2116-02-01T10:00Z"},
    {"id":"shift-capacity","type":"fill","widget":"shift_editor","field":"required_count","value":"1"},
    {"id":"save-shift","type":"submit","widget":"shift_editor","command":"save","tool":"roster_save","capture":{"shift":"item.id"}},
    {"id":"new-assignment","type":"command","widget":"open-assignment_editor","command":"new"},
    {"id":"assignment-shift","type":"select","widget":"assignment_editor","field":"shift_id","value":"${shift}"},
    {"id":"assignment-person","type":"select","widget":"assignment_editor","field":"volunteer_id","label":"${marker}-edited / Greeter"},
    {"id":"assignment-note","type":"fill","widget":"assignment_editor","field":"notes","value":"${marker}-assignment"},
    {"id":"assignment-editor","type":"screenshot"},
    {"id":"assign","type":"submit","widget":"assignment_editor","command":"assign_person","tool":"roster_save"},
    {"id":"assignment-visible","type":"text","widget":"assignments_collection","text":"${marker}-edited"},
    {"id":"second-shift","type":"command","widget":"open-shift-editor","command":"new"},
    {"id":"second-role","type":"select","widget":"shift_editor","field":"Shift.role","label":"Greeter"},
    {"id":"second-start","type":"fill","widget":"shift_editor","field":"start","value":"2116-02-01T09:30Z"},
    {"id":"second-end","type":"fill","widget":"shift_editor","field":"end","value":"2116-02-01T10:30Z"},
    {"id":"second-capacity","type":"fill","widget":"shift_editor","field":"required_count","value":"1"},
    {"id":"save-second","type":"submit","widget":"shift_editor","command":"save","tool":"roster_save","capture":{"otherShift":"item.id","otherShiftLabel":"item.label"}},
    {"id":"conflicting-assignment","type":"command","widget":"open-assignment_editor","command":"new"},
    {"id":"conflict-shift","type":"select","widget":"assignment_editor","field":"shift_id","value":"${otherShift}"},
    {"id":"conflict-person","type":"select","widget":"assignment_editor","field":"volunteer_id","label":"${marker}-edited / Greeter"},
    {"id":"conflict-note","type":"fill","widget":"assignment_editor","field":"notes","value":"Keep this draft"},
    {"id":"conflict-refused","type":"submit","widget":"assignment_editor","command":"assign_person","tool":"roster_save","ok":false,"error":"overlap"},
    {"id":"draft-retained","type":"value","widget":"assignment_editor","field":"notes","value":"Keep this draft"},
    {"id":"close-draft","type":"dismiss"},
    {"id":"select-assignment","type":"row","widget":"assignments_collection","text":"${marker}-edited"},
    {"id":"reassign-target","type":"select","widget":"assignment_editor","field":"shift_id","value":"${otherShift}"},
    {"id":"reassign","type":"submit","widget":"assignment_editor","command":"reassign","tool":"roster_save"},
    {"id":"reload","type":"reload"},
    {"id":"persisted-volunteer","type":"text","widget":"volunteers_collection","text":"${marker}-edited"},
    {"id":"persisted-assignment","type":"row","widget":"assignments_collection","text":"${marker}-edited"},
    {"id":"new-shift-retained","type":"text","selector":"[data-webui-widget-id=assignment_editor] [data-webui-field-id=shift_id] select option:checked","text":"${otherShiftLabel}"},
    {"id":"remove","type":"submit","widget":"assignment_editor","command":"remove_person","tool":"roster_cancel","confirm":"Remove"},
    {"id":"cancelled-history","type":"text","widget":"assignments_collection","text":"Cancelled"},
    {"id":"finished","type":"screenshot"}
  ]
}
