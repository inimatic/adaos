{
  "schema": "adaos.notifications.manifest.v1",
  "categories": [{
    "id": "task.completed", "title_key": "task.completed.title", "purpose_key": "task.completed.purpose",
    "source_event": "task.completed.v1", "payload_schema": {
      "type": "object", "properties": {"title": {"type": "string", "maxLength": 500}},
      "required": ["title"], "additionalProperties": false
    },
    "recipient_policy": "current_user", "default_mode": "center_only", "maximum_urgency": "important",
    "sensitivity": "private", "template": {"en": "Ready: {title}", "ru": "Готово: {title}"},
    "lifetime_seconds": 86400, "grouping": {"replacement": "same_source_object"}, "material_updates": true
  }]
}
