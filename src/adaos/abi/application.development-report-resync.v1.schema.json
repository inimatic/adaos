{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://adaos.dev/abi/application.development-report-resync.v1.schema.json",
  "title": "AdaOS Development Report Status Resync v1", "type": "object", "additionalProperties": false,
  "required": ["schema", "request_id", "report_id", "requester_subnet_ref", "after_revision", "limit", "created_at"],
  "properties": {"schema": {"const": "adaos.application.development_report_resync.v1"}, "request_id": {"$ref": "#/$defs/id"}, "report_id": {"$ref": "#/$defs/id"}, "requester_subnet_ref": {"$ref": "#/$defs/subnet"}, "after_revision": {"type": "integer", "minimum": 0}, "limit": {"type": "integer", "minimum": 1, "maximum": 200}, "created_at": {"type": "string", "format": "date-time"}},
  "$defs": {"id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$"}, "subnet": {"type": "string", "pattern": "^subnet:[a-z0-9][a-z0-9_.-]{0,127}$"}}
}
