{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adaos.dev/abi/application.permission-profile.v1.schema.json",
  "title": "AdaOS Application Permission Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "required", "optional"],
  "properties": {
    "schema": {"const": "adaos.application.permission_profile.v1"},
    "required": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/permissionDeclaration"}},
    "optional": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/permissionDeclaration"}},
    "secrets": {"type": "array", "uniqueItems": true, "items": {"type": "object"}},
    "data_practices": {"type": "object"},
    "llm_model_use": {"type": "array", "uniqueItems": true, "items": {"type": "object"}},
    "notifications": {"type": "array", "uniqueItems": true, "items": {"type": "object"}},
    "background_actions": {"type": "array", "uniqueItems": true, "items": {"type": "object"}},
    "external_providers": {"type": "array", "uniqueItems": true, "items": {"type": "object"}},
    "privacy_labels": {"type": "object"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$"},
    "permissionDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "purpose", "approval_policy"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "title": {"type": "string", "minLength": 1, "maxLength": 160},
        "purpose": {"type": "string", "minLength": 1, "maxLength": 500},
        "authorization_details": {"type": "object"},
        "approval_policy": {"$ref": "#/$defs/id"},
        "sensitive": {"type": "boolean"}
      }
    }
  }
}
