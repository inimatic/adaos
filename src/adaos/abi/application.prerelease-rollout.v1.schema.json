{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adaos.dev/schemas/application.prerelease-rollout.v1.schema.json",
  "title": "AdaOS Application Prerelease Rollout v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "application_id",
    "release_digest",
    "publisher_ref",
    "percentage",
    "paused",
    "minimum_health_subnets",
    "failure_threshold",
    "salt",
    "status",
    "halted_reason",
    "revision",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema": { "const": "adaos.application.prerelease_rollout.v1" },
    "application_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$" },
    "release_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "publisher_ref": { "type": "string", "pattern": "^subnet:[a-z0-9][a-z0-9_.-]{0,127}$" },
    "percentage": { "type": "integer", "minimum": 0, "maximum": 100 },
    "paused": { "type": "boolean" },
    "minimum_health_subnets": { "type": "integer", "minimum": 1, "maximum": 10000 },
    "failure_threshold": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
    "salt": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "status": { "enum": ["active", "paused", "halted"] },
    "halted_reason": { "type": ["string", "null"] },
    "revision": { "type": "integer", "minimum": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
