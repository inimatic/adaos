{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adaos.dev/abi/application.requirement.v1.schema.json",
  "title": "AdaOS Application Requirement v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "requirement_ref", "capability_ref", "contract_range", "environment_target", "policy_constraints", "evidence_threshold", "requirement_digest"],
  "properties": {
    "schema": {"const": "adaos.application.requirement.v1"},
    "requirement_ref": {"type": "string", "pattern": "^requirement:"},
    "capability_ref": {"type": "string", "pattern": "^capability:"},
    "contract_range": {"type": "string", "minLength": 1},
    "environment_target": {
      "type": "object", "additionalProperties": false,
      "required": ["profile_ref", "allowed_modes"],
      "properties": {
        "profile_ref": {"type": "string", "pattern": "^profile:"},
        "allowed_modes": {"type": "array", "minItems": 1, "items": {"enum": ["simulation", "sandbox", "production"]}, "uniqueItems": true}
      }
    },
    "policy_constraints": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "locality": {"enum": ["local", "remote_allowed"]},
        "privacy": {"type": "string", "minLength": 1},
        "required_authorities": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "evidence_threshold": {
      "type": "object", "additionalProperties": false,
      "required": ["required_claim_kinds", "allow_stale"],
      "properties": {
        "required_claim_kinds": {"type": "array", "items": {"enum": ["capability_conformance", "state_compatibility"]}, "uniqueItems": true},
        "allow_stale": {"type": "boolean"}
      }
    },
    "requirement_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
