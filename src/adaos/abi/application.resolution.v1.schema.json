{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adaos.dev/abi/application.resolution.v1.schema.json",
  "title": "AdaOS Application Resolution v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "resolution_ref", "semantic_revision_digest", "requirement_ref", "requirement_digest", "environment_profile_ref", "environment_profile_digest", "policy_digest", "selected_contracts", "binding_definition", "project_release_digest", "package_closure", "delivery", "binding_instances", "provisioning_obligations", "state_attachments", "evidence", "rejection_explanations", "created_at", "resolution_digest"],
  "properties": {
    "schema": {"const": "adaos.application.resolution.v1"},
    "resolution_ref": {"type": "string", "pattern": "^application-resolution:"},
    "semantic_revision_digest": {"$ref": "#/$defs/digest"},
    "requirement_ref": {"type": "string", "pattern": "^requirement:"},
    "requirement_digest": {"$ref": "#/$defs/digest"},
    "environment_profile_ref": {"type": "string", "pattern": "^profile:"},
    "environment_profile_digest": {"$ref": "#/$defs/digest"},
    "policy_digest": {"$ref": "#/$defs/digest"},
    "selected_contracts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["kind", "ref", "version", "digest"],
        "properties": {
          "kind": {"enum": ["capability", "state"]},
          "ref": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "digest": {"$ref": "#/$defs/digest"}
        }
      }
    },
    "binding_definition": {
      "type": "object", "additionalProperties": false,
      "required": ["ref", "digest"],
      "properties": {"ref": {"type": "string", "pattern": "^binding-definition:"}, "digest": {"$ref": "#/$defs/digest"}}
    },
    "project_release_digest": {"$ref": "#/$defs/digest"},
    "package_closure": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["kind", "id", "version", "digest"],
        "properties": {
          "kind": {"enum": ["skill", "scenario"]},
          "id": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "digest": {"$ref": "#/$defs/digest"}
        }
      }
    },
    "delivery": {
      "type": "object", "additionalProperties": false,
      "required": ["delivery_digest", "package_digest", "physical_member"],
      "properties": {
        "delivery_digest": {"$ref": "#/$defs/digest"},
        "package_digest": {"$ref": "#/$defs/digest"},
        "physical_member": {"type": "string", "minLength": 1}
      }
    },
    "binding_instances": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["ref", "revision_digest", "authority_epoch"],
        "properties": {"ref": {"type": "string", "pattern": "^binding-instance:"}, "revision_digest": {"$ref": "#/$defs/digest"}, "authority_epoch": {"type": "integer", "minimum": 1}}
      }
    },
    "provisioning_obligations": {"type": "array", "items": {"type": "object"}},
    "state_attachments": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["port_id", "state_space_ref", "revision_digest", "generation", "authority_epoch", "relation_digest"],
        "properties": {
          "port_id": {"type": "string", "minLength": 1},
          "state_space_ref": {"type": "string", "pattern": "^state-space:"},
          "revision_digest": {"$ref": "#/$defs/digest"},
          "generation": {"type": "integer", "minimum": 1},
          "authority_epoch": {"type": "integer", "minimum": 1},
          "relation_digest": {"$ref": "#/$defs/digest"}
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["claim_ref", "claim_digest", "assessment_digest", "status"],
        "properties": {
          "claim_ref": {"type": "string", "pattern": "^evidence-claim:"},
          "claim_digest": {"$ref": "#/$defs/digest"},
          "assessment_digest": {"$ref": "#/$defs/digest"},
          "status": {"enum": ["admissible", "stale"]}
        }
      }
    },
    "rejection_explanations": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {"code": {"type": "string", "minLength": 1}, "message": {"type": "string", "minLength": 1}, "subject_ref": {"type": "string", "minLength": 1}}
      }
    },
    "created_at": {"type": "string", "minLength": 1},
    "resolution_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
