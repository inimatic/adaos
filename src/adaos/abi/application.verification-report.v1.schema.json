{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adaos.dev/abi/application.verification-report.v1.schema.json",
  "title": "AdaOS Application Verification Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "application_id", "release_digest", "source_commit", "permission_profile_digest", "observed_capabilities_digest", "overall", "checks", "warnings", "attestations", "residual_risks", "created_at", "report_digest"],
  "properties": {
    "schema": {"const": "adaos.application.verification_report.v1"},
    "application_id": {"$ref": "#/$defs/id"},
    "release_digest": {"$ref": "#/$defs/digest"},
    "source_commit": {"$ref": "#/$defs/ref"},
    "permission_profile_digest": {"$ref": "#/$defs/digest"},
    "observed_capabilities_digest": {"$ref": "#/$defs/digest"},
    "overall": {"enum": ["passed", "failed", "warning", "inconclusive"]},
    "checks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/check"}},
    "warnings": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "attestations": {"type": "array", "items": {"type": "object"}},
    "residual_risks": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "created_at": {"type": "string", "format": "date-time"},
    "report_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$"},
    "ref": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,255}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "gate", "result"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "gate": {"enum": ["hard_gate", "warning", "attestation"]},
        "result": {"enum": ["passed", "failed", "inconclusive", "skipped"]},
        "evidence": {"type": "string", "minLength": 1, "maxLength": 500},
        "message": {"type": "string", "minLength": 1, "maxLength": 500},
        "actor_ref": {"$ref": "#/$defs/ref"}
      }
    }
  }
}
