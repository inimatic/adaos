{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adaos.dev/abi/artifact.candidate.v1.schema.json",
  "title": "AdaOS Artifact Candidate v1",
  "type": "object",
  "required": ["schema", "candidate_id", "candidate_digest", "project_id", "version", "source_ref", "base_release", "base_release_digest", "base_source_ref", "package_digest", "release_digest", "change_ids", "created_at", "updated_at", "status", "validation_evidence", "trials"],
  "properties": {
    "schema": {"const": "adaos.artifact.candidate.v1"},
    "candidate_id": {"type": "string", "minLength": 1},
    "candidate_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "project_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$"},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:[-+][0-9A-Za-z.-]+)?$"},
    "source_ref": {"type": "object"},
    "base_release": {"type": "string", "minLength": 1},
    "base_release_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "base_source_ref": {"type": "object"},
    "package_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "release_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "change_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "created_at": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "validated", "trial", "accepted", "rejected", "stale"]},
    "source_tree": {"type": "string", "minLength": 1},
    "verification_source_ref": {"type": "object"},
    "validation_evidence": {"type": "array", "items": {"type": "object"}},
    "trials": {"type": "array", "items": {"type": "object"}},
    "stale_reason": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
