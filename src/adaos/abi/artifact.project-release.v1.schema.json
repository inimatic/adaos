{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adaos.dev/abi/artifact.project-release.v1.schema.json",
  "title": "AdaOS Project Release v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "project_id",
    "version",
    "source_ref",
    "components",
    "resolved_dependencies",
    "permissions",
    "migrations",
    "validation_evidence",
    "release_digest"
  ],
  "properties": {
    "schema": { "const": "adaos.artifact.project_release.v1" },
    "project_id": { "$ref": "#/$defs/artifactId" },
    "version": { "$ref": "#/$defs/version" },
    "source_ref": { "$ref": "#/$defs/sourceRef" },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/packageRef" }
    },
    "resolved_dependencies": {
      "type": "array",
      "items": { "$ref": "#/$defs/resolvedDependency" }
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "migrations": {
      "type": "array",
      "items": { "type": "object" }
    },
    "validation_evidence": {
      "type": "array",
      "items": { "type": "object" }
    },
    "schema_locks": {
      "type": "array",
      "items": { "$ref": "#/$defs/contractLock" }
    },
    "migration_locks": {
      "type": "array",
      "items": { "$ref": "#/$defs/contractLock" }
    },
    "validation_evidence_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/digest" }
    },
    "composition_lock": { "$ref": "#/$defs/projectCompositionLock" },
    "release_digest": { "$ref": "#/$defs/digest" }
  },
  "dependentRequired": {
    "schema_locks": ["migration_locks", "validation_evidence_refs"],
    "migration_locks": ["schema_locks", "validation_evidence_refs"],
    "validation_evidence_refs": ["schema_locks", "migration_locks"]
  },
  "$defs": {
    "artifactId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "contractLock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lock_id", "digest"],
      "properties": {
        "lock_id": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "sourceRef": {
      "type": "object",
      "required": ["schema", "forge", "repository", "revision", "path_scope"],
      "properties": {
        "schema": { "const": "adaos.artifact.source_ref.v1" },
        "forge": { "type": "string", "minLength": 1 },
        "repository": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 7 },
        "path_scope": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "packageRef": {
      "type": "object",
      "required": ["schema", "kind", "artifact_id", "version", "digest", "manifest_digest", "source_ref"],
      "properties": {
        "schema": { "const": "adaos.artifact.package_ref.v1" },
        "kind": { "enum": ["skill", "scenario"] },
        "artifact_id": { "$ref": "#/$defs/artifactId" },
        "version": { "$ref": "#/$defs/version" },
        "digest": { "$ref": "#/$defs/digest" },
        "manifest_digest": { "$ref": "#/$defs/digest" },
        "source_ref": { "$ref": "#/$defs/sourceRef" },
        "builder_id": { "type": "string", "minLength": 1 },
        "build_policy_digest": { "$ref": "#/$defs/digest" },
        "materialization_path": {
          "type": "string",
          "pattern": "^(scenarios|skills)/[a-z0-9][a-z0-9_.-]*$"
        },
        "schema_locks": {
          "type": "array",
          "items": { "$ref": "#/$defs/contractLock" }
        },
        "conversational_lock": { "$ref": "#/$defs/contractLock" },
        "workflow_lock": { "$ref": "#/$defs/contractLock" },
        "workflow_validation_lock": { "$ref": "#/$defs/contractLock" },
        "workflow_adapter_locks": {
          "type": "array",
          "items": { "$ref": "#/$defs/workflowAdapterLock" }
        },
        "workflow_binding_digest": { "$ref": "#/$defs/digest" },
        "workflow_role_policy_digest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false,
      "dependentRequired": {
        "builder_id": ["build_policy_digest", "materialization_path", "schema_locks"],
        "build_policy_digest": ["builder_id", "materialization_path", "schema_locks"],
        "materialization_path": ["builder_id", "build_policy_digest", "schema_locks"],
        "schema_locks": ["builder_id", "build_policy_digest", "materialization_path"],
        "workflow_lock": ["builder_id", "build_policy_digest", "materialization_path", "schema_locks"],
        "conversational_lock": ["builder_id", "build_policy_digest", "materialization_path", "schema_locks"],
        "workflow_validation_lock": ["workflow_lock", "workflow_adapter_locks", "workflow_binding_digest", "workflow_role_policy_digest"],
        "workflow_adapter_locks": ["workflow_lock", "workflow_validation_lock", "workflow_binding_digest", "workflow_role_policy_digest"],
        "workflow_binding_digest": ["workflow_lock", "workflow_validation_lock", "workflow_adapter_locks", "workflow_role_policy_digest"],
        "workflow_role_policy_digest": ["workflow_lock", "workflow_validation_lock", "workflow_adapter_locks", "workflow_binding_digest"]
      }
    },
    "workflowAdapterLock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter_id", "kind", "contract_digest", "owner"],
      "properties": {
        "adapter_id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["guard", "activity", "compensation"] },
        "contract_digest": { "$ref": "#/$defs/digest" },
        "owner": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scope", "package"],
          "properties": {
            "scope": { "enum": ["platform", "package", "dependency"] },
            "package": { "type": ["string", "null"] }
          }
        }
      }
    },
    "resolvedDependency": {
      "type": "object",
      "required": ["kind", "artifact_id", "version", "package_digest", "optional"],
      "properties": {
        "kind": { "enum": ["skill", "scenario"] },
        "artifact_id": { "$ref": "#/$defs/artifactId" },
        "version": { "$ref": "#/$defs/version" },
        "package_digest": { "$ref": "#/$defs/digest" },
        "version_spec": { "type": "string" },
        "optional": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "projectCompositionLock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "project_definition_digest",
        "profiles",
        "members",
        "project_dependencies",
        "entrypoints",
        "compatibility",
        "lifecycle"
      ],
      "properties": {
        "schema": { "const": "adaos.artifact.project_composition_lock.v1" },
        "project_definition_digest": { "$ref": "#/$defs/digest" },
        "profiles": {
          "type": "array", "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "members": {
          "type": "array", "minItems": 1,
          "items": { "$ref": "#/$defs/projectMemberLock" }
        },
        "project_dependencies": {
          "type": "array",
          "items": { "$ref": "#/$defs/projectDependencyLock" }
        },
        "entrypoints": { "type": "array", "items": { "type": "object" } },
        "compatibility": { "type": "object" },
        "lifecycle": { "type": "object" }
      }
    },
    "projectMemberLock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "package_digest", "role", "exposure", "lifecycle", "relations"],
      "properties": {
        "ref": { "type": "string", "pattern": "^(skill|scenario):[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$" },
        "package_digest": { "$ref": "#/$defs/digest" },
        "role": { "enum": ["primary", "implementation", "supporting"] },
        "exposure": { "enum": ["application", "project_only", "advanced"] },
        "lifecycle": { "enum": ["bound", "shared"] },
        "relations": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "enum": ["realizes", "presents", "evaluates", "uses"] }
        }
      }
    },
    "projectDependencyLock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_ref", "version_spec", "release_digest"],
      "properties": {
        "project_ref": { "type": "string", "pattern": "^project:[a-z0-9][a-z0-9_.-]{0,127}$" },
        "version_spec": { "type": "string", "maxLength": 80 },
        "release_digest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
