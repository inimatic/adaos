{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adaos.dev/abi/artifact.project-release.v1.schema.json",
  "title": "AdaOS Project Release v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "project_id",
    "version",
    "source_ref",
    "components",
    "resolved_dependencies",
    "permissions",
    "migrations",
    "validation_evidence",
    "release_digest"
  ],
  "properties": {
    "schema": { "const": "adaos.artifact.project_release.v1" },
    "project_id": { "$ref": "#/$defs/artifactId" },
    "version": { "$ref": "#/$defs/version" },
    "source_ref": { "$ref": "#/$defs/sourceRef" },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/packageRef" }
    },
    "resolved_dependencies": {
      "type": "array",
      "items": { "$ref": "#/$defs/resolvedDependency" }
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "migrations": {
      "type": "array",
      "items": { "type": "object" }
    },
    "validation_evidence": {
      "type": "array",
      "items": { "type": "object" }
    },
    "release_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "artifactId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sourceRef": {
      "type": "object",
      "required": ["schema", "forge", "repository", "revision", "path_scope"],
      "properties": {
        "schema": { "const": "adaos.artifact.source_ref.v1" },
        "forge": { "type": "string", "minLength": 1 },
        "repository": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 7 },
        "path_scope": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "packageRef": {
      "type": "object",
      "required": ["schema", "kind", "artifact_id", "version", "digest", "manifest_digest", "source_ref"],
      "properties": {
        "schema": { "const": "adaos.artifact.package_ref.v1" },
        "kind": { "enum": ["skill", "scenario"] },
        "artifact_id": { "$ref": "#/$defs/artifactId" },
        "version": { "$ref": "#/$defs/version" },
        "digest": { "$ref": "#/$defs/digest" },
        "manifest_digest": { "$ref": "#/$defs/digest" },
        "source_ref": { "$ref": "#/$defs/sourceRef" }
      },
      "additionalProperties": false
    },
    "resolvedDependency": {
      "type": "object",
      "required": ["kind", "artifact_id", "version", "package_digest", "optional"],
      "properties": {
        "kind": { "enum": ["skill", "scenario"] },
        "artifact_id": { "$ref": "#/$defs/artifactId" },
        "version": { "$ref": "#/$defs/version" },
        "package_digest": { "$ref": "#/$defs/digest" },
        "version_spec": { "type": "string" },
        "optional": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  }
}
