{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adaos.dev/abi/artifact.release-attestation-set.v1.schema.json",
  "title": "AdaOS Immutable Release Attestation Set v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "project_id",
    "release_digest",
    "attestations",
    "attestation_set_digest"
  ],
  "properties": {
    "schema": { "const": "adaos.artifact.release_attestation_set.v1" },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]*$"
    },
    "release_digest": { "$ref": "#/$defs/digest" },
    "attestations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/reference" }
    },
    "attestation_set_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_kind",
        "subject_digest",
        "project_id",
        "attestation_digest",
        "issuer",
        "key_id",
        "predicate_type",
        "predicate_digest"
      ],
      "properties": {
        "subject_kind": { "enum": ["package", "release"] },
        "subject_digest": { "$ref": "#/$defs/digest" },
        "project_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_.-]*$"
        },
        "attestation_digest": { "$ref": "#/$defs/digest" },
        "issuer": { "type": "string", "minLength": 1, "maxLength": 512 },
        "key_id": { "$ref": "#/$defs/digest" },
        "predicate_type": { "type": "string", "minLength": 1, "maxLength": 512 },
        "predicate_digest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
