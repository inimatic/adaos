{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adaos.dev/abi/artifact.trust-store.v1.schema.json",
  "title": "AdaOS Artifact Trust Store v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "revision", "keys"],
  "properties": {
    "schema": { "const": "adaos.artifact.trust_store.v1" },
    "revision": { "type": "integer", "minimum": 1 },
    "keys": {
      "type": "array",
      "items": { "$ref": "#/$defs/trustKey" }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "trustKey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "key_id",
        "issuer",
        "algorithm",
        "public_key_b64",
        "purposes"
      ],
      "properties": {
        "schema": { "const": "adaos.artifact.trust_key.v1" },
        "key_id": { "$ref": "#/$defs/digest" },
        "issuer": { "type": "string", "minLength": 1, "maxLength": 512 },
        "algorithm": { "const": "ed25519" },
        "public_key_b64": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{43}=$"
        },
        "purposes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["package", "release"] }
        },
        "not_before": { "type": "string", "format": "date-time" },
        "not_after": { "type": "string", "format": "date-time" },
        "revoked_at": { "type": "string", "format": "date-time" },
        "revocation_reason": { "type": "string", "minLength": 1 }
      },
      "dependentRequired": {
        "revoked_at": ["revocation_reason"],
        "revocation_reason": ["revoked_at"]
      }
    }
  }
}
