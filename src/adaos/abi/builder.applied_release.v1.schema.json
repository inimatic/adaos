{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adaos.dev/abi/builder.applied_release.v1.schema.json",
  "title": "AdaOS Builder Applied Release Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "project_id", "candidate_id", "version", "release_digest", "package_digest",
    "draft_ref", "validation_evidence", "approval", "activation", "rollback", "recorded_at"
  ],
  "properties": {
    "schema": { "const": "adaos.builder.applied_release.v1" },
    "project_id": { "type": "string", "minLength": 1 },
    "candidate_id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "release_digest": { "$ref": "#/$defs/digest" },
    "package_digest": { "$ref": "#/$defs/digest" },
    "draft_ref": {
      "type": "object",
      "additionalProperties": true,
      "required": ["draft_id", "revision"],
      "properties": {
        "draft_id": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 }
      }
    },
    "validation_evidence": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approval_id", "actor_id", "policy_evidence"],
      "properties": {
        "approval_id": { "type": "string", "minLength": 1 },
        "actor_id": { "type": "string", "minLength": 1 },
        "actor_type": { "type": "string" },
        "approved_at": { "type": ["string", "null"], "format": "date-time" },
        "policy_evidence": { "type": "array", "minItems": 1, "items": { "type": "object" } }
      }
    },
    "activation": {
      "type": "object",
      "additionalProperties": true,
      "required": ["operation_id", "runtime_slot", "health_receipt"],
      "properties": {
        "operation_id": { "type": "string", "minLength": 1 },
        "runtime_slot": { "type": "string", "minLength": 1 },
        "health_receipt": { "type": "object" }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": true,
      "required": ["mode", "operation_ref"],
      "properties": {
        "mode": { "enum": ["slot_switch", "workspace_lock_restore", "artifact_restore", "manual"] },
        "operation_ref": { "type": "string", "minLength": 1 }
      }
    },
    "setup_plan_digest": { "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
    "recorded_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
