{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaos.builder.automation_projection.v1",
  "title": "AdaOS Builder Automation Projection",
  "description": "Compact render-safe state of one Builder Automation session.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "stage",
    "status",
    "phase",
    "busy",
    "terminal",
    "can_submit",
    "webspace_id",
    "iteration",
    "steps"
  ],
  "properties": {
    "schema": { "const": "adaos.builder.automation_projection.v1" },
    "stage": { "const": "automation" },
    "session_id": { "type": ["string", "null"] },
    "status": { "type": "string", "minLength": 1 },
    "phase": { "type": "string", "minLength": 1 },
    "busy": { "type": "boolean" },
    "terminal": { "type": "boolean" },
    "can_submit": { "type": "boolean" },
    "webspace_id": { "type": "string", "minLength": 1 },
    "project": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "type": "string", "enum": ["skill", "scenario"] },
        "id": { "type": "string", "minLength": 1 },
        "companion_skill_id": { "type": ["string", "null"] },
        "companion_skill_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "iteration": { "type": "integer", "minimum": 0 },
    "task_id": { "type": ["string", "null"] },
    "result_branch": { "type": ["string", "null"] },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label_i18n", "state"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label_i18n": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key"],
            "properties": {
              "key": { "type": "string", "minLength": 1 }
            }
          },
          "state": {
            "type": "string",
            "enum": ["pending", "current", "completed", "error"]
          }
        }
      }
    },
    "progress": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "properties": {
        "task_id": { "type": "string" },
        "status": { "type": "string" },
        "message": { "type": "string" },
        "updated_at": { "type": "string" }
      }
    },
    "summary": { "type": ["string", "null"] },
    "error": { "type": ["string", "null"] },
    "updated_at": { "type": ["string", "null"] }
  }
}
