{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaos.builder.binding_profile.v1",
  "title": "AdaOS Builder Preview Binding Profile",
  "type": "object",
  "required": [
    "schema", "profile_id", "mode", "logical_schema_ref", "source_ref",
    "sensitivity", "capabilities", "read_policy", "write_policy", "owner",
    "expires_at", "redaction", "implementation_mappings"
  ],
  "properties": {
    "schema": { "const": "adaos.builder.binding_profile.v1" },
    "profile_id": { "type": "string", "minLength": 1, "maxLength": 160 },
    "mode": { "enum": ["mock", "fixture", "sandbox", "live_readonly", "live"] },
    "logical_schema_ref": { "type": "string", "minLength": 1, "maxLength": 500 },
    "source_ref": { "type": "string", "minLength": 1, "maxLength": 500 },
    "sensitivity": { "enum": ["public", "internal", "personal", "secret"] },
    "capabilities": { "type": "array", "uniqueItems": true, "maxItems": 100, "items": { "type": "string", "minLength": 1, "maxLength": 160 } },
    "read_policy": { "enum": ["none", "fixture", "sandbox", "scoped_live"] },
    "write_policy": { "enum": ["none", "sandbox", "scoped_live"] },
    "owner": { "type": "string", "minLength": 1, "maxLength": 240 },
    "expires_at": { "type": ["string", "null"], "format": "date-time" },
    "redaction": { "enum": ["none", "policy", "required"] },
    "implementation_mappings": {
      "type": "array", "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["logical_ref", "implementation_ref", "status"],
        "properties": {
          "logical_ref": { "type": "string", "minLength": 1, "maxLength": 500 },
          "implementation_ref": { "type": ["string", "null"], "maxLength": 500 },
          "status": { "enum": ["mapped", "fixture_only", "missing"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
