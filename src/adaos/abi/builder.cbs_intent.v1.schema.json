{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaos.builder.cbs_intent.v1",
  "title": "Compact package-neutral CBS authoring intent",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "requirements"],
  "properties": {
    "schema": { "const": "adaos.builder.cbs_intent.v1" },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "capability_ref", "contract_range", "origin"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$" },
          "capability_ref": { "type": "string", "pattern": "^capability:[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$" },
          "contract_range": { "type": "string", "minLength": 1, "maxLength": 80 },
          "origin": { "enum": ["human_explicit", "builder_inferred"] },
          "locality": { "enum": ["local_only", "remote_allowed"] },
          "privacy": { "type": "string", "minLength": 1, "maxLength": 80 },
          "required_authorities": {
            "type": "array",
            "maxItems": 32,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 160 }
          },
          "required_claim_kinds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "uniqueItems": true,
            "items": { "enum": ["capability_conformance", "state_compatibility"] }
          }
        }
      }
    }
  }
}
