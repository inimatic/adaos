{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaos.builder.change.v1",
  "title": "AdaOS Builder Change",
  "type": "object",
  "required": ["schema", "change_id", "project_ref", "request", "route", "gate", "status", "issues", "runs"],
  "properties": {
    "schema": { "const": "adaos.builder.change.v1" },
    "change_id": { "type": "string", "minLength": 1, "maxLength": 160 },
    "change_set_id": { "type": "string", "minLength": 1, "maxLength": 160 },
    "project_ref": { "type": "string", "pattern": "^(scenario|skill):[^/\\\\]+$" },
    "request": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "request_addenda": { "type": "array", "maxItems": 50, "items": { "type": "string", "minLength": 1, "maxLength": 4000 } },
    "route": { "enum": ["prototype_first", "implementation_direct", "automation_direct"] },
    "gate": { "enum": ["prototype", "implementation", "automation", "trial", "publication", "complete"] },
    "status": { "type": "string", "minLength": 1, "maxLength": 80 },
    "issues": { "type": "array", "minItems": 1, "maxItems": 50, "items": { "type": "object" } },
    "runs": { "type": "array", "maxItems": 100, "items": { "type": "object" } },
    "acceptance_constraints": { "type": "array", "maxItems": 100, "items": { "$ref": "builder.acceptance_constraint.v1.schema.json" } },
    "source_message_ids": { "type": "array", "maxItems": 100, "items": { "type": "string", "minLength": 1 } },
    "member_change_ids": { "type": "array", "maxItems": 100, "items": { "type": "string", "minLength": 1 } },
    "base_ref": { "type": ["object", "null"] },
    "base_generation": { "type": "integer", "minimum": 0 },
    "affected_refs": {
      "type": "array", "maxItems": 500, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "context_packet_digest": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
    "supersedes_change_id": { "type": ["string", "null"], "maxLength": 160 },
    "created_at": { "type": ["string", "null"], "format": "date-time" },
    "updated_at": { "type": ["string", "null"], "format": "date-time" }
  },
  "additionalProperties": false
}
