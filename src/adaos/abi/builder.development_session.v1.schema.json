{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaos.builder.development_session.v1",
  "title": "AdaOS Builder development-session policy",
  "type": "object",
  "required": ["schema", "session_id", "project_ref", "base_release", "focus", "targets", "context_members", "artifact_inputs", "scratch", "handoff", "status", "created_at", "created_by"],
  "properties": {
    "schema": {"const": "adaos.builder.development_session.v1"},
    "session_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,159}$"},
    "project_ref": {"type": "string", "pattern": "^project:[a-z0-9][a-z0-9_.-]{0,127}$"},
    "base_release": {"type": ["object", "null"]},
    "focus": {"type": "object", "required": ["ref"], "properties": {"ref": {"$ref": "#/$defs/componentRef"}}, "additionalProperties": false},
    "targets": {
      "type": "object", "required": ["primary", "secondary"],
      "properties": {
        "primary": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"$ref": "#/$defs/target"}},
        "secondary": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/target"}}
      },
      "additionalProperties": false
    },
    "context_members": {"type": "array", "maxItems": 200, "items": {"$ref": "#/$defs/contextMember"}},
    "artifact_inputs": {"type": "array", "maxItems": 200, "items": {"$ref": "#/$defs/artifactInput"}},
    "instruction_inputs": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/instructionInput"}},
    "subject_refs": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"$ref": "#/$defs/subjectRef"}},
    "contract_inputs": {"type": "array", "maxItems": 200, "items": {"$ref": "#/$defs/contractInput"}},
    "acceptance_profiles": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 160}},
    "acceptance_requirements": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/acceptanceRequirement"}},
    "scratch": {
      "type": "object", "required": ["owner", "access", "path"],
      "properties": {"owner": {"const": "session"}, "access": {"const": "read-write"}, "path": {"type": "string", "minLength": 1}},
      "additionalProperties": false
    },
    "handoff": {
      "type": "object", "required": ["prohibited_actions"],
      "properties": {
        "automation_brief_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "research_prototype_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "artifact_manifest_digests": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
        "request": {"type": "string", "minLength": 1, "maxLength": 20000},
        "execution_budget": {
          "type": "object",
          "required": ["budget_view", "max_wall_seconds", "max_model_tokens", "max_attempts", "max_human_interventions"],
          "properties": {
            "budget_view": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"},
            "max_wall_seconds": {"type": "integer", "minimum": 60, "maximum": 86400},
            "max_model_tokens": {"type": "integer", "minimum": 1},
            "max_attempts": {"type": "integer", "minimum": 1, "maximum": 20},
            "max_human_interventions": {"type": "integer", "minimum": 0, "maximum": 100}
          },
          "additionalProperties": false
        },
        "agent_profile": {
          "type": "object",
          "required": ["provider", "model", "reasoning_effort", "tool_profile"],
          "properties": {
            "provider": {"type": "string", "minLength": 1, "maxLength": 128},
            "model": {"type": "string", "minLength": 1, "maxLength": 128},
            "reasoning_effort": {"enum": ["low", "medium", "high", "xhigh"]},
            "tool_profile": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"}
          },
          "additionalProperties": false
        },
        "prohibited_actions": {"type": "array", "maxItems": 200, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "status": {"enum": ["ready", "active", "stale", "closed"]},
    "created_at": {"type": "string", "format": "date-time"},
    "created_by": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "componentRef": {"type": "string", "pattern": "^(skill|scenario):[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "subjectRef": {
      "type": "object", "required": ["kind", "ref"],
      "properties": {
        "kind": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,79}$"},
        "ref": {"type": "string", "minLength": 1, "maxLength": 500},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "revision": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "integer", "minimum": 0}]}
      },
      "additionalProperties": false
    },
    "contractInput": {
      "type": "object", "required": ["kind", "digest"],
      "properties": {
        "kind": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,79}$"},
        "ref": {"type": "string", "minLength": 1, "maxLength": 500},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "media_type": {"type": "string", "minLength": 1, "maxLength": 160},
        "path": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "target": {
      "type": "object", "required": ["ref", "access", "context", "source_path"],
      "properties": {"ref": {"$ref": "#/$defs/componentRef"}, "access": {"const": "read-write"}, "context": {"const": "full"}, "source_path": {"type": "string", "minLength": 1}},
      "additionalProperties": false
    },
    "contextMember": {
      "type": "object", "required": ["ref", "relation", "access", "context"],
      "properties": {"ref": {"$ref": "#/$defs/componentRef"}, "relation": {"enum": ["presentation", "dependency", "project", "contract-consumer"]}, "access": {"const": "read-only"}, "context": {"enum": ["none", "contract", "docs", "paths", "full"]}, "paths": {"type": "array", "items": {"type": "string"}}},
      "additionalProperties": false
    },
    "artifactInput": {
      "type": "object", "required": ["ref", "access", "manifest_digest", "root_path"],
      "properties": {
        "ref": {"type": "string", "pattern": "^artifact://skill/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "access": {"const": "read-only"},
        "manifest_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "root_path": {"type": "string", "minLength": 1},
        "audience": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
        "context_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "instructionInput": {
      "type": "object",
      "required": ["ref", "kind", "access", "media_type", "content_digest", "path"],
      "properties": {
        "ref": {"type": "string", "pattern": "^instruction://builder/[A-Za-z0-9_.-]+/[a-z][a-z0-9_.-]{0,63}$"},
        "kind": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$"},
        "access": {"const": "read-only"},
        "media_type": {"type": "string", "minLength": 1},
        "digest_mode": {"enum": ["canonical-json", "bytes"]},
        "content_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "path": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "acceptanceRequirement": {
      "type": "object",
      "required": ["id", "profile", "provider_ref", "operation", "required"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"},
        "profile": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,159}$"},
        "provider_ref": {"type": "string", "pattern": "^skill:[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
        "operation": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,127}$"},
        "required": {"type": "boolean"},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
