{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaos.builder.domain_pack.v1",
  "title": "AdaOS Builder domain pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "pack_id", "version", "classification"],
  "properties": {
    "schema": {"const": "adaos.builder.domain_pack.v1"},
    "pack_id": {"type": "string", "pattern": "^[a-z0-9._-]+$", "maxLength": 120},
    "version": {"type": "string", "minLength": 1, "maxLength": 40},
    "classification": {"enum": ["compatibility", "development", "product"]},
    "ui_adapter": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.]+$"},
    "ui_recipes": {"type": "array", "items": {"type": "object"}},
    "prompt_rules": {"type": "array", "items": {"type": "object"}},
    "prototype_policy": {"type": "object"},
    "repair_guidance": {"type": "object"}
  }
}
