{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaos.builder.e2e_case.v1",
  "title": "AdaOS Builder E2E Case",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "case_id", "title", "locale", "steps"],
  "properties": {
    "schema": {"const": "adaos.builder.e2e_case.v1"},
    "case_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$", "maxLength": 120},
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "description": {"type": "string", "maxLength": 2000},
    "locale": {"enum": ["en", "ru"]},
    "tags": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "requirements": {"type": "object"},
    "prohibited_assumptions": {"type": "array", "items": {"type": "string"}},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$", "maxLength": 120},
          "type": {"enum": ["observe.path", "builder.chat", "builder.session", "builder.wait", "scenario.validate", "browser.probe"]},
          "required": {"type": "boolean"},
          "input": {"type": "object"},
          "expect": {"$ref": "#/$defs/expectation"},
          "retry": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "max_attempts": {"type": "integer", "minimum": 1, "maximum": 5},
              "backoff_seconds": {"type": "number", "minimum": 0, "maximum": 30},
              "on": {
                "type": "array",
                "uniqueItems": true,
                "items": {"enum": ["unavailable", "exception", "failed_expectation"]}
              }
            }
          },
          "timeout_seconds": {"type": "number", "minimum": 1, "maximum": 1800}
        }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "policy": {"enum": ["always", "on-success", "never"]},
        "retain_on_failure": {"type": "boolean"}
      }
    }
  },
  "$defs": {
    "expectation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "paths_present": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "paths_absent": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "values": {"type": "object"},
        "values_in": {"type": "object", "additionalProperties": {"type": "array", "minItems": 1}},
        "text_contains": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}}}
      }
    }
  }
}
