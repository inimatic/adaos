{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaos.builder.e2e_checkpoint.v1",
  "title": "AdaOS Builder E2E case checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "run_manifest_digest", "case_id", "case_digest", "repetition", "stage", "next_step_index", "context", "steps", "full_outputs", "evidence_refs", "started_at", "elapsed_ms", "updated_at"],
  "properties": {
    "schema": {"const": "adaos.builder.e2e_checkpoint.v1"},
    "run_id": {"type": "string", "minLength": 1},
    "run_manifest_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "case_id": {"type": "string", "minLength": 1},
    "case_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "repetition": {"type": "integer", "minimum": 1},
    "stage": {"enum": ["executing", "attribution", "cleanup", "complete"]},
    "next_step_index": {"type": "integer", "minimum": 0},
    "active_step": {"type": ["object", "null"]},
    "context": {"type": "object"},
    "steps": {"type": "array", "items": {"type": "object"}},
    "full_outputs": {"type": "array"},
    "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "failure": {"type": ["object", "null"]},
    "input_attribution": {"type": ["object", "null"]},
    "cleanup": {"type": ["object", "null"]},
    "started_at": {"type": "string", "format": "date-time"},
    "elapsed_ms": {"type": "number", "minimum": 0},
    "updated_at": {"type": "string", "format": "date-time"}
  }
}
