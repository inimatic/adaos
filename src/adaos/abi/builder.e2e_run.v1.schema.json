{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaos.builder.e2e_run.v1",
  "title": "AdaOS Builder E2E Resolved Run",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "suite", "adapter", "profile", "cases", "environment", "input_attribution", "started_at"],
  "properties": {
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["retain_test_projects", "date", "stage", "publication"],
      "properties": {
        "retain_test_projects": {"type": "boolean"},
        "date": {"type": ["string", "null"], "pattern": "^[0-9]{8}$"},
        "stage": {"const": "prototype"},
        "publication": {"const": "none"}
      }
    },
    "schema": {"const": "adaos.builder.e2e_run.v1"},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "suite": {"type": "object", "required": ["suite_id", "version", "digest", "cohort"]},
    "adapter": {"type": "string", "minLength": 1},
    "profile": {"type": "string", "minLength": 1},
    "generation_contract": {"enum": ["webui.v1", "semantic.v1", "semantic.v2"]},
    "repetitions": {"type": "integer", "minimum": 1},
    "browser": {"enum": ["auto", "on", "off"]},
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prototype_grader"],
      "properties": {
        "prototype_grader": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "model", "version"],
          "properties": {
            "kind": {"const": "model"},
            "model": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "cases": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["case_id", "digest", "locale"]}},
    "selection": {"type": "object"},
    "environment": {"type": "object"},
    "input_attribution": {"type": "object", "required": ["domain_packs", "case_digests"]},
    "baseline": {"type": ["object", "null"]},
    "started_at": {"type": "string", "format": "date-time"}
  }
}
