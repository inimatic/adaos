{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaos.builder.e2e_suite.v1",
  "title": "AdaOS Builder E2E Suite",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "suite_id", "version", "cohort", "case_refs"],
  "properties": {
    "schema": {"const": "adaos.builder.e2e_suite.v1"},
    "suite_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$", "maxLength": 120},
    "version": {"type": "string", "minLength": 1, "maxLength": 40},
    "title": {"type": "string", "maxLength": 200},
    "description": {"type": "string", "maxLength": 2000},
    "cohort": {"enum": ["development", "regression", "sealed-held-out", "adversarial"]},
    "case_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 240}
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "adapter": {"enum": ["legacy_dev_chat.v1", "sdk.v1", "fixture.v1"]},
        "profile": {"type": "string", "maxLength": 80},
        "generation_contract": {"enum": ["webui.v1", "semantic.v1"]},
        "repetitions": {"type": "integer", "minimum": 1, "maximum": 20},
        "timeout_seconds": {"type": "number", "minimum": 1, "maximum": 1800},
        "browser": {"enum": ["auto", "on", "off"]},
        "grader_model": {"type": "string", "minLength": 1, "maxLength": 120},
        "require_client_profile": {"type": "boolean"},
        "domain_packs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "tags": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "gates": {"type": "object"}
  }
}
