{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaos.builder.issue.v1",
  "title": "AdaOS Builder Issue",
  "type": "object",
  "required": ["schema", "issue_id", "title", "lane", "status", "acceptance_criteria"],
  "properties": {
    "schema": { "const": "adaos.builder.issue.v1" },
    "issue_id": { "type": "string", "minLength": 1, "maxLength": 80 },
    "title": { "type": "string", "minLength": 1, "maxLength": 240 },
    "lane": { "enum": ["prototype", "implementation", "automation"] },
    "status": { "enum": ["open", "in_progress", "resolved", "deferred"] },
    "priority": { "type": ["string", "null"], "maxLength": 40 },
    "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "criterion_ids": {
      "description": "Canonical source criterion identities of an automatically partitioned child; declared coverage only.",
      "type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    },
    "source_criterion_ids": {
      "description": "Stable identities retained by the non-executable split parent.",
      "type": "array", "minItems": 21, "maxItems": 980, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    },
    "source_acceptance_criteria": {
      "description": "Verbatim original criteria retained for review; every criterion must map to an executable child before acceptance.",
      "type": "array", "minItems": 21, "maxItems": 980,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    },
    "semantic_refs": {
      "type": "array",
      "maxItems": 100,
      "items": { "type": "string", "minLength": 1, "maxLength": 300 },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
