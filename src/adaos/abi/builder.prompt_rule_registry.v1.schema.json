{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaos.builder.prompt_rule_registry.v1",
  "title": "AdaOS Builder Prompt Rule Registry",
  "type": "object",
  "required": ["schema", "version", "published_at", "authority_ref", "items"],
  "properties": {
    "schema": {"const": "adaos.builder.prompt_rule_registry.v1"},
    "version": {"type": "string", "minLength": 1},
    "published_at": {"type": "string", "format": "date-time"},
    "authority_ref": {"type": "string", "minLength": 1},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "source", "applicability", "rules"],
        "properties": {
          "id": {"type": "string", "pattern": "^adaos\\."},
          "title": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "applicability": {
            "type": "object",
            "properties": {
              "always": {"type": "boolean"},
              "target_types": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "match_any": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "profiles": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "target_path_globs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "target_ref_prefixes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "facet_keys": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "concepts": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "surface_kinds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "operation_kinds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "data_planes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "effects": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "requires": {"type": "array", "uniqueItems": true, "items": {"enum": ["i18n", "access", "conversation", "lifecycle"]}}
            },
            "additionalProperties": false,
            "anyOf": [
              {"required": ["always"]},
              {"required": ["match_any"]},
              {"required": ["profiles"]},
              {"required": ["target_path_globs"]},
              {"required": ["target_ref_prefixes"]},
              {"required": ["facet_keys"]},
              {"required": ["concepts"]},
              {"required": ["surface_kinds"]},
              {"required": ["operation_kinds"]},
              {"required": ["data_planes"]},
              {"required": ["effects"]},
              {"required": ["requires"]}
            ]
          },
          "rules": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
