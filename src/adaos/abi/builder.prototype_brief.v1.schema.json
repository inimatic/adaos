{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaos.builder.prototype_brief.v1",
  "title": "AdaOS Builder interpreted Prototype brief",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "brief_id",
    "digest",
    "intent_ref",
    "intent_digest",
    "problem",
    "outcome",
    "actors",
    "principal_jobs",
    "entities",
    "operations",
    "representative_states",
    "boundaries",
    "constraints",
    "assumptions",
    "open_questions",
    "capability_gaps",
    "interpretation"
  ],
  "properties": {
    "schema": { "const": "adaos.builder.prototype_brief.v1" },
    "brief_id": { "type": "string", "pattern": "^brief:[a-f0-9]{24}$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "intent_ref": { "type": "string", "pattern": "^intent:[a-f0-9]{24}$" },
    "intent_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "problem": { "$ref": "#/$defs/knowledgeField" },
    "outcome": { "$ref": "#/$defs/knowledgeField" },
    "actors": { "$ref": "#/$defs/knowledgeField" },
    "principal_jobs": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidencedStatement" }
    },
    "residual_requirements": {
      "type": "array",
      "description": "Exact user clauses that remain requirements but were not classified by deterministic interpretation.",
      "items": { "$ref": "#/$defs/evidencedStatement" }
    },
    "entities": { "$ref": "#/$defs/knowledgeField" },
    "exclusions": {
      "type": "array",
      "description": "Explicit user scope exclusions; not required work or Automation debt.",
      "items": { "$ref": "#/$defs/evidencedStatement" }
    },
    "information_requirements": {
      "type": "array",
      "items": { "$ref": "#/$defs/informationRequirement" }
    },
    "collection_requirements": {
      "type": "array",
      "items": { "$ref": "#/$defs/collectionRequirement" }
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "statement", "target", "effect_scope", "authority", "evidence"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "kind": {
              "enum": ["list", "inspect", "search", "filter", "sort", "create", "update", "assign", "transition", "delete", "archive", "other"]
            },
            "statement": { "type": "string", "minLength": 1 },
            "source_clause": { "type": "string", "minLength": 1 },
          "target": { "$ref": "#/$defs/knowledgeField" },
          "effect_scope": { "enum": ["read", "prototype", "external", "unknown"] },
          "authority": { "enum": ["allowed", "denied", "unknown"] },
          "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "representative_states": { "$ref": "#/$defs/knowledgeField" },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data_effects", "external_effects", "destructive_effects"],
      "properties": {
        "data_effects": { "$ref": "#/$defs/knowledgeField" },
        "external_effects": { "$ref": "#/$defs/knowledgeField" },
        "destructive_effects": { "$ref": "#/$defs/knowledgeField" }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locale", "responsive", "accessibility", "content_volume"],
      "properties": {
        "locale": { "$ref": "#/$defs/knowledgeField" },
        "responsive": { "$ref": "#/$defs/knowledgeField" },
        "accessibility": { "$ref": "#/$defs/knowledgeField" },
        "content_volume": { "$ref": "#/$defs/knowledgeField" }
      }
    },
    "assumptions": { "type": "array", "items": { "$ref": "#/$defs/evidencedStatement" } },
    "open_questions": { "type": "array", "items": { "$ref": "#/$defs/evidencedStatement" } },
    "capability_gaps": { "type": "array", "items": { "$ref": "#/$defs/evidencedStatement" } },
    "interface_context": { "$ref": "#/$defs/interfaceContext" },
    "task_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "source", "requirements", "facts", "transitions", "constraints", "clause_roles", "design_freedom", "proposal_digest", "previous_digest", "admission_basis"],
      "properties": {
        "schema": {"const": "adaos.builder.task_contract.v1"},
        "source": {"type": "object"},
        "requirements": {"type": "array", "items": {"type": "object"}},
        "facts": {"type": "array", "items": {"type": "object"}},
        "transitions": {"type": "array", "items": {"type": "object"}},
        "constraints": {"type": "array", "items": {"type": "object"}},
        "clause_roles": {"type": "array", "items": {"type": "object"}},
        "design_freedom": {"type": "array", "items": {"type": "string"}},
        "reaffirmations": {
          "type": "array", "maxItems": 128,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["requirement_ref", "source_digest", "clause_ids", "statement", "source_targets", "reference_rule", "previous_brief_ref", "previous_brief_digest", "prior_requirements"],
            "properties": {
              "requirement_ref": {"type": "string"}, "source_digest": {"type": "string"},
              "clause_ids": {"type": "array", "items": {"type": "string"}}, "statement": {"type": "string"},
              "source_targets": {"type": "array", "minItems": 1, "items": {"type": "string"}},
              "reference_rule": {"const": "preservation_reference_constructor.v1"},
              "previous_brief_ref": {"type": "string"}, "previous_brief_digest": {"type": "string"},
              "prior_requirements": {"type": "array", "minItems": 1, "items": {
                "type": "object", "additionalProperties": false,
                "required": ["requirement_ref", "baseline_digest", "semantic_refs", "closure_digest"],
                "properties": {"requirement_ref": {"type": "string"}, "baseline_digest": {"type": "string"},
                  "semantic_refs": {"type": "array", "items": {"type": "string"}}, "closure_digest": {"type": "string"}}
              }}
            }
          }
        },
        "proposal_digest": {"type": "string"},
        "normalized_proposal_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "interpretation_normalizations": {
          "type": "array", "maxItems": 128,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["kind", "path", "from", "to", "owner_ref", "baseline_digest"],
            "properties": {
              "kind": {"const": "unique_existing_collection_selector"},
              "path": {"type": "string", "pattern": "^\\$\\.constraints\\[[0-9]+\\]\\.subject$"},
              "from": {"type": "string", "maxLength": 160},
              "to": {"anyOf": [{"const": ""}, {"type": "string", "pattern": "^view:[A-Za-z0-9_.-]{1,160}$"}], "description": "Core-resolved typed existing view reference. Empty is retained compatibility for historical unique-selector receipts only."},
              "owner_ref": {"type": "string", "pattern": "^view:"},
              "baseline_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
              "resolution": {
                "type": "object", "additionalProperties": false,
                "required": ["ref", "baseline_digest", "role", "presentation", "section_ref", "resource_ref", "owner_digest", "source_clause_ids"],
                "properties": {
                  "ref": {"type": "string", "pattern": "^view:"},
                  "baseline_digest": {"type": "string"},
                  "role": {"enum": ["collection", "details", "editor"]},
                  "presentation": {"type": ["string", "null"]},
                  "section_ref": {"type": ["string", "null"]},
                  "resource_ref": {"type": "string", "pattern": "^resource:"},
                  "owner_digest": {"type": "string"},
                  "source_clause_ids": {"type": "array", "items": {"type": "string"}}
                }
              }
            }
          }
        },
        "derivation": {"type": "object", "additionalProperties": false,
          "required": ["kind", "prior_brief_ref", "prior_task_ref", "prior_source_digest"],
          "properties": {"kind": {"const": "exact_source_replay"}, "prior_brief_ref": {"type": "string"},
            "prior_task_ref": {"type": "string"}, "prior_source_digest": {"type": "string"},
            "meaning_source_digest": {"type": "string"}}},
        "previous_digest": {"type": ["string", "null"]},
        "admission_basis": {"const": "source_coverage_literal_grounding_and_typed_invariants"}
      }
    },
    "interpretation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "confidence", "unresolved_fields"],
      "properties": {
        "mode": { "enum": ["deterministic_explicit", "model_assisted"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "unresolved_fields": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    }
  },
  "$defs": {
    "knowledgeField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "evidence"],
      "properties": {
        "state": { "enum": ["known", "unknown", "not_required"] },
        "value": {},
        "evidence": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "evidencedStatement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "evidence", "confidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "informationRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "interaction", "statement", "evidence", "confidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["attachment", "text", "number", "choice", "boolean", "date", "time", "other"] },
        "interaction": { "enum": ["capture", "present"] },
        "statement": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "collectionRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "interaction", "statement", "evidence", "confidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "const": "repeated_collection" },
        "interaction": { "enum": ["present", "capture_each"] },
        "statement": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "interfaceContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "authority", "surface", "viewports", "layout", "initial_selection", "capability_refs", "acceptance"],
      "properties": {
        "schema": { "const": "adaos.builder.interface_context.v1" },
        "authority": { "const": "accepted_design_contract" },
        "surface": { "enum": ["document", "workspace", "public_site", "tool"] },
        "viewports": {
          "type": "array", "minItems": 1, "maxItems": 3,
          "items": { "$ref": "#/$defs/interfaceViewport" }
        },
        "layout": { "$ref": "#/$defs/interfaceLayout" },
        "initial_selection": {
          "anyOf": [
            {
              "type": "object", "additionalProperties": false,
              "required": ["resource_ref", "record_id"],
              "properties": {
                "resource_ref": { "$ref": "#/$defs/interfaceId" },
                "record_id": { "$ref": "#/$defs/interfaceId" }
              }
            },
            { "type": "null" }
          ]
        },
        "capability_refs": {
          "type": "array", "maxItems": 24, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 120 }
        },
        "region_content_budgets": {
          "type": "array", "maxItems": 8,
          "items": { "$ref": "#/$defs/interfaceRegionContentBudget" }
        },
        "acceptance": {
          "type": "array", "maxItems": 24,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "kind", "statement"],
            "properties": {
              "id": { "$ref": "#/$defs/interfaceId" },
              "kind": { "enum": ["geometry", "interaction", "responsive", "content"] },
              "statement": { "type": "string", "minLength": 1, "maxLength": 500 }
            }
          }
        }
      }
    },
    "interfaceId": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$" },
    "interfaceViewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "viewport_width_px", "shell_reserved_px", "page_gutter_px", "usable_width_px", "region_gap_px"],
      "properties": {
        "id": { "enum": ["compact", "medium", "wide"] },
        "viewport_width_px": { "type": "integer", "minimum": 320, "maximum": 3840 },
        "shell_reserved_px": { "type": "integer", "minimum": 0, "maximum": 640 },
        "page_gutter_px": { "type": "integer", "minimum": 0, "maximum": 128 },
        "usable_width_px": { "type": "integer", "minimum": 280, "maximum": 3840 },
        "region_gap_px": { "type": "integer", "minimum": 0, "maximum": 64 }
      }
    },
    "interfaceLayout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pattern", "density", "content_width", "scroll", "regions"],
      "properties": {
        "pattern": { "enum": ["flow", "split", "grid", "focus_detail", "workbench"] },
        "density": { "enum": ["compact", "comfortable"] },
        "content_width": { "enum": ["fluid", "reading", "wide"] },
        "scroll": { "enum": ["page", "regions"] },
        "regions": {
          "type": "array", "minItems": 1, "maxItems": 8,
          "items": { "$ref": "#/$defs/interfaceRegion" }
        }
      }
    },
    "interfaceRegion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "priority", "scroll", "wide", "compact", "min_px", "preferred_px", "max_px", "grow"],
      "properties": {
        "id": { "$ref": "#/$defs/interfaceId" },
        "role": { "enum": ["navigation", "toolbar", "collection", "main", "detail", "inspector", "utility", "status", "commands"] },
        "priority": { "type": "integer", "minimum": 0, "maximum": 100 },
        "scroll": { "enum": ["page", "region", "none"] },
        "wide": { "enum": ["pane", "stack"] },
        "compact": { "enum": ["stack", "drawer", "sheet", "hidden", "overflow", "route"] },
        "min_px": { "type": ["integer", "null"], "minimum": 160, "maximum": 1600 },
        "preferred_px": { "type": ["integer", "null"], "minimum": 160, "maximum": 1600 },
        "max_px": { "type": ["integer", "null"], "minimum": 160, "maximum": 2400 },
        "grow": { "type": "number", "minimum": 0, "maximum": 10 }
      }
    },
    "interfaceRegionContentBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region_ref", "wide_inner_width_px", "max_table_columns", "collection_presentations", "form_columns"],
      "properties": {
        "region_ref": { "$ref": "#/$defs/interfaceId" },
        "wide_inner_width_px": { "type": "integer", "minimum": 120, "maximum": 2368 },
        "max_table_columns": { "type": "integer", "minimum": 1, "maximum": 12 },
        "collection_presentations": {
          "type": "array", "minItems": 1, "maxItems": 7, "uniqueItems": true,
          "items": { "enum": ["list", "table", "cards", "board", "tree", "chart", "accordion"] },
          "description": "Accepted presentations in preference order for this region."
        },
        "form_columns": { "type": "integer", "minimum": 1, "maximum": 4 }
      }
    }
  }
}
