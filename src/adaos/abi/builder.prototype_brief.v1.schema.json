{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaos.builder.prototype_brief.v1",
  "title": "AdaOS Builder interpreted Prototype brief",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "brief_id",
    "digest",
    "intent_ref",
    "intent_digest",
    "problem",
    "outcome",
    "actors",
    "principal_jobs",
    "entities",
    "operations",
    "representative_states",
    "boundaries",
    "constraints",
    "assumptions",
    "open_questions",
    "capability_gaps",
    "interpretation"
  ],
  "properties": {
    "schema": { "const": "adaos.builder.prototype_brief.v1" },
    "brief_id": { "type": "string", "pattern": "^brief:[a-f0-9]{24}$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "intent_ref": { "type": "string", "pattern": "^intent:[a-f0-9]{24}$" },
    "intent_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "problem": { "$ref": "#/$defs/knowledgeField" },
    "outcome": { "$ref": "#/$defs/knowledgeField" },
    "actors": { "$ref": "#/$defs/knowledgeField" },
    "principal_jobs": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidencedStatement" }
    },
    "residual_requirements": {
      "type": "array",
      "description": "Exact user clauses that remain requirements but were not classified by deterministic interpretation.",
      "items": { "$ref": "#/$defs/evidencedStatement" }
    },
    "entities": { "$ref": "#/$defs/knowledgeField" },
    "exclusions": {
      "type": "array",
      "description": "Explicit user scope exclusions; not required work or Automation debt.",
      "items": { "$ref": "#/$defs/evidencedStatement" }
    },
    "information_requirements": {
      "type": "array",
      "items": { "$ref": "#/$defs/informationRequirement" }
    },
    "collection_requirements": {
      "type": "array",
      "items": { "$ref": "#/$defs/collectionRequirement" }
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "statement", "target", "effect_scope", "authority", "evidence"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "kind": {
              "enum": ["list", "inspect", "search", "filter", "sort", "create", "update", "assign", "transition", "delete", "archive", "other"]
            },
            "statement": { "type": "string", "minLength": 1 },
            "source_clause": { "type": "string", "minLength": 1 },
          "target": { "$ref": "#/$defs/knowledgeField" },
          "effect_scope": { "enum": ["read", "prototype", "external", "unknown"] },
          "authority": { "enum": ["allowed", "denied", "unknown"] },
          "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "representative_states": { "$ref": "#/$defs/knowledgeField" },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data_effects", "external_effects", "destructive_effects"],
      "properties": {
        "data_effects": { "$ref": "#/$defs/knowledgeField" },
        "external_effects": { "$ref": "#/$defs/knowledgeField" },
        "destructive_effects": { "$ref": "#/$defs/knowledgeField" }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locale", "responsive", "accessibility", "content_volume"],
      "properties": {
        "locale": { "$ref": "#/$defs/knowledgeField" },
        "responsive": { "$ref": "#/$defs/knowledgeField" },
        "accessibility": { "$ref": "#/$defs/knowledgeField" },
        "content_volume": { "$ref": "#/$defs/knowledgeField" }
      }
    },
    "assumptions": { "type": "array", "items": { "$ref": "#/$defs/evidencedStatement" } },
    "open_questions": { "type": "array", "items": { "$ref": "#/$defs/evidencedStatement" } },
    "capability_gaps": { "type": "array", "items": { "$ref": "#/$defs/evidencedStatement" } },
    "interface_context": { "$ref": "#/$defs/interfaceContext" },
    "interpretation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "confidence", "unresolved_fields"],
      "properties": {
        "mode": { "enum": ["deterministic_explicit", "model_assisted"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "unresolved_fields": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    }
  },
  "$defs": {
    "knowledgeField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "evidence"],
      "properties": {
        "state": { "enum": ["known", "unknown", "not_required"] },
        "value": {},
        "evidence": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "evidencedStatement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "evidence", "confidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "informationRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "interaction", "statement", "evidence", "confidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["attachment", "text", "number", "choice", "boolean", "date", "time", "other"] },
        "interaction": { "enum": ["capture", "present"] },
        "statement": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "collectionRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "interaction", "statement", "evidence", "confidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "const": "repeated_collection" },
        "interaction": { "enum": ["present", "capture_each"] },
        "statement": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "interfaceContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "authority", "surface", "viewports", "layout", "initial_selection", "capability_refs", "acceptance"],
      "properties": {
        "schema": { "const": "adaos.builder.interface_context.v1" },
        "authority": { "const": "accepted_design_contract" },
        "surface": { "enum": ["document", "workspace", "public_site", "tool"] },
        "viewports": {
          "type": "array", "minItems": 1, "maxItems": 3,
          "items": { "$ref": "#/$defs/interfaceViewport" }
        },
        "layout": { "$ref": "#/$defs/interfaceLayout" },
        "initial_selection": {
          "anyOf": [
            {
              "type": "object", "additionalProperties": false,
              "required": ["resource_ref", "record_id"],
              "properties": {
                "resource_ref": { "$ref": "#/$defs/interfaceId" },
                "record_id": { "$ref": "#/$defs/interfaceId" }
              }
            },
            { "type": "null" }
          ]
        },
        "capability_refs": {
          "type": "array", "maxItems": 24, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 120 }
        },
        "acceptance": {
          "type": "array", "maxItems": 24,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "kind", "statement"],
            "properties": {
              "id": { "$ref": "#/$defs/interfaceId" },
              "kind": { "enum": ["geometry", "interaction", "responsive", "content"] },
              "statement": { "type": "string", "minLength": 1, "maxLength": 500 }
            }
          }
        }
      }
    },
    "interfaceId": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$" },
    "interfaceViewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "viewport_width_px", "shell_reserved_px", "page_gutter_px", "usable_width_px", "region_gap_px"],
      "properties": {
        "id": { "enum": ["compact", "medium", "wide"] },
        "viewport_width_px": { "type": "integer", "minimum": 320, "maximum": 3840 },
        "shell_reserved_px": { "type": "integer", "minimum": 0, "maximum": 640 },
        "page_gutter_px": { "type": "integer", "minimum": 0, "maximum": 128 },
        "usable_width_px": { "type": "integer", "minimum": 280, "maximum": 3840 },
        "region_gap_px": { "type": "integer", "minimum": 0, "maximum": 64 }
      }
    },
    "interfaceLayout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pattern", "density", "content_width", "scroll", "regions"],
      "properties": {
        "pattern": { "enum": ["flow", "split", "grid", "focus_detail", "workbench"] },
        "density": { "enum": ["compact", "comfortable"] },
        "content_width": { "enum": ["fluid", "reading", "wide"] },
        "scroll": { "enum": ["page", "regions"] },
        "regions": {
          "type": "array", "minItems": 1, "maxItems": 8,
          "items": { "$ref": "#/$defs/interfaceRegion" }
        }
      }
    },
    "interfaceRegion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "priority", "scroll", "wide", "compact", "min_px", "preferred_px", "max_px", "grow"],
      "properties": {
        "id": { "$ref": "#/$defs/interfaceId" },
        "role": { "enum": ["navigation", "toolbar", "collection", "main", "detail", "inspector", "utility", "status", "commands"] },
        "priority": { "type": "integer", "minimum": 0, "maximum": 100 },
        "scroll": { "enum": ["page", "region", "none"] },
        "wide": { "enum": ["pane", "stack"] },
        "compact": { "enum": ["stack", "drawer", "sheet", "hidden", "overflow", "route"] },
        "min_px": { "type": ["integer", "null"], "minimum": 160, "maximum": 1600 },
        "preferred_px": { "type": ["integer", "null"], "minimum": 160, "maximum": 1600 },
        "max_px": { "type": ["integer", "null"], "minimum": 160, "maximum": 2400 },
        "grow": { "type": "number", "minimum": 0, "maximum": 10 }
      }
    }
  }
}
