{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaos.builder.prototype_workflow_slice.v1",
  "title": "AdaOS Builder Constrained Conversational Workflow Prototype Slice",
  "type": "object",
  "required": [
    "schema", "slice_id", "source_definition_ref", "source_definition_digest",
    "source_generation", "profile", "entry_command", "definition",
    "activity_requirements", "retry_transition_ids", "locales", "stories",
    "story_outcomes"
  ],
  "properties": {
    "schema": { "const": "adaos.builder.prototype_workflow_slice.v1" },
    "slice_id": { "type": "string", "minLength": 1, "maxLength": 160 },
    "source_definition_ref": { "type": "string", "minLength": 1, "maxLength": 500 },
    "source_definition_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "source_generation": { "type": "integer", "minimum": 0 },
    "profile": { "const": "conversational_mvp" },
    "entry_command": { "type": "string", "minLength": 1, "maxLength": 160 },
    "definition": { "type": "object" },
    "activity_requirements": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "required": ["activity_id", "input_schema", "output_schema", "implementation_status"],
        "properties": {
          "activity_id": { "type": "string", "minLength": 1, "maxLength": 160 },
          "input_schema": { "type": "object" },
          "output_schema": { "type": "object" },
          "implementation_status": { "enum": ["prototype_only", "mapped", "missing"] },
          "implementation_ref": { "type": ["string", "null"], "maxLength": 500 }
        },
        "additionalProperties": false
      }
    },
    "retry_transition_ids": {
      "type": "array", "maxItems": 1, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 160 }
    },
    "locales": {
      "type": "object",
      "required": ["en", "ru"],
      "properties": {
        "en": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string" } },
        "ru": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "stories": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": { "type": "object" }
    },
    "story_outcomes": {
      "type": "object",
      "required": ["success", "failure", "input_required"],
      "properties": {
        "success": { "type": "string", "minLength": 1, "maxLength": 240 },
        "failure": { "type": "string", "minLength": 1, "maxLength": 240 },
        "input_required": { "type": "string", "minLength": 1, "maxLength": 240 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
