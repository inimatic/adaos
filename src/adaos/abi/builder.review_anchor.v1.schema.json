{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaos.builder.review_anchor.v1",
  "title": "AdaOS Builder Review Anchor",
  "type": "object",
  "required": ["schema", "review_id", "change_id", "artifact_ref", "target_ref", "comment", "status", "author_ref", "created_at"],
  "properties": {
    "schema": { "const": "adaos.builder.review_anchor.v1" },
    "review_id": { "type": "string", "minLength": 1, "maxLength": 160 },
    "change_id": { "type": "string", "minLength": 1, "maxLength": 160 },
    "artifact_ref": { "type": "string", "minLength": 1, "maxLength": 300 },
    "target_ref": { "type": "string", "pattern": "^(widget|field|surface):" },
    "comment": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "status": { "enum": ["open", "submitted", "accepted", "accepted_as_constraint", "converted_to_issue", "dismissed", "withdrawn", "rejected", "resolved", "superseded"] },
    "author_ref": { "type": "string", "minLength": 1, "maxLength": 300 },
    "source_revision": { "type": ["string", "null"], "maxLength": 160 },
    "current_revision": { "type": ["string", "null"], "maxLength": 160 },
    "anchor_state": { "enum": ["stable", "moved", "unresolved"] },
    "anchor_snapshot": { "type": "object", "additionalProperties": true },
    "revision_history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["revision", "observed_at", "anchor_state"],
        "properties": {
          "revision": { "type": "string", "minLength": 1, "maxLength": 160 },
          "observed_at": { "type": "string", "format": "date-time" },
          "anchor_state": { "enum": ["stable", "moved", "unresolved"] }
        }
      }
    },
    "issue_id": { "type": ["string", "null"], "maxLength": 80 },
    "constraint_ref": { "type": ["string", "null"], "maxLength": 300 },
    "resolution_ref": { "type": ["string", "null"], "maxLength": 300 },
    "disposition_reason": { "type": ["string", "null"], "maxLength": 2000 },
    "superseded_by_ref": { "type": ["string", "null"], "maxLength": 300 },
    "tombstone": { "type": "boolean" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": ["string", "null"], "format": "date-time" }
  },
  "additionalProperties": false
}
