{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaos.builder.run.v1",
  "title": "AdaOS Builder Run",
  "type": "object",
  "required": ["schema", "run_id", "change_id", "activity", "executor", "purpose", "adoption_status", "status"],
  "properties": {
    "schema": { "const": "adaos.builder.run.v1" },
    "run_id": { "type": "string", "minLength": 1, "maxLength": 160 },
    "change_id": { "type": "string", "minLength": 1, "maxLength": 160 },
    "activity": { "type": "string", "minLength": 1, "maxLength": 120 },
    "executor": { "type": "string", "minLength": 1, "maxLength": 160 },
    "purpose": { "enum": ["iteration", "experiment", "evaluation", "recovery"] },
    "adoption_status": { "enum": ["not_applicable", "pending", "adopted", "discarded"] },
    "status": { "enum": ["queued", "running", "succeeded", "failed", "cancelled", "superseded"] },
    "context_packet_digest": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
    "environment_ref": { "type": ["string", "null"], "maxLength": 300 },
    "input_refs": { "$ref": "#/$defs/refs" },
    "output_refs": { "$ref": "#/$defs/refs" },
    "evidence_refs": { "$ref": "#/$defs/refs" },
    "workflow_metrics": { "type": ["object", "null"] },
    "execution_metrics": { "anyOf": [{ "$ref": "#/$defs/execution_metrics" }, { "type": "null" }] },
    "started_at": { "type": ["string", "null"], "format": "date-time" },
    "completed_at": { "type": ["string", "null"], "format": "date-time" },
    "error": { "type": ["string", "null"], "maxLength": 4000 }
  },
  "$defs": {
    "execution_metrics": {
      "type": "object", "required": ["source"], "additionalProperties": false,
      "properties": {
        "source": { "enum": ["builder.llm_result", "core.semantic_graph"] },
        "model": { "type": "string", "minLength": 1, "maxLength": 160 },
        "resolved_model": { "type": "string", "minLength": 1, "maxLength": 160 },
        "reasoning_effort": { "type": "string", "minLength": 1, "maxLength": 40 },
        "input_tokens": { "type": "integer", "minimum": 0 },
        "cached_input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "reasoning_tokens": { "type": "integer", "minimum": 0 },
        "llm_calls": { "type": "integer", "minimum": 0 },
        "repair_attempts": { "type": "integer", "minimum": 0 },
        "usage_complete": { "type": "boolean" },
        "attempt_observations": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/attempt_observation" } },
        "cost_usd": { "type": "number", "minimum": 0 },
        "cost_basis": { "enum": ["estimate", "metered", "invoiced", "zero_model"] },
        "root_execution_ms": { "type": "number", "minimum": 0 },
        "root_queue_ms": { "type": "number", "minimum": 0 },
        "client_wait_ms": { "type": "number", "minimum": 0 },
        "source_refs": { "type": "array", "maxItems": 16, "items": { "type": "string", "minLength": 1, "maxLength": 500 } }
      },
      "dependentRequired": { "cost_usd": ["cost_basis"] }
    },
    "attempt_observation": {
      "type": "object", "additionalProperties": false, "required": ["job_id", "status"],
      "properties": {
        "job_id": { "type": "string", "minLength": 1, "maxLength": 500 },
        "status": { "enum": ["observed", "conflict"] },
        "model": { "type": "string", "minLength": 1, "maxLength": 160 },
        "input_tokens": { "type": "integer", "minimum": 0 },
        "cached_input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "reasoning_tokens": { "type": "integer", "minimum": 0 },
        "cost_usd": { "type": "number", "minimum": 0 },
        "cost_basis": { "enum": ["estimate", "metered", "invoiced"] },
        "root_execution_ms": { "type": "number", "minimum": 0 },
        "root_queue_ms": { "type": "number", "minimum": 0 }
      },
      "dependentRequired": { "cost_usd": ["cost_basis"] }
    },
    "refs": {
      "type": "array",
      "maxItems": 100,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    }
  },
  "additionalProperties": false
}
