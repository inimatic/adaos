{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaos.builder.semantic_prototype_candidate.v2",
  "title": "Strict multi-resource model output for an AdaOS semantic Prototype",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "document_id", "title", "layout",
    "resources", "relationships", "views", "capability_surfaces", "commands", "representative_states",
    "requirement_bindings", "capability_gaps"
  ],
  "properties": {
    "schema": { "type": "string", "const": "adaos.builder.semantic_prototype_candidate.v2" },
    "document_id": { "$ref": "#/$defs/id" },
    "title": { "$ref": "#/$defs/localizedText" },
    "layout": {
      "anyOf": [
        { "type": "string", "enum": ["flow", "split", "grid", "focus_detail"] },
        { "$ref": "#/$defs/layout" }
      ]
    },
    "resources": {
      "type": "array", "minItems": 1, "maxItems": 8,
      "items": { "$ref": "#/$defs/resource" }
    },
    "relationships": {
      "type": "array", "maxItems": 16,
      "items": { "$ref": "#/$defs/relationship" }
    },
    "views": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": { "$ref": "#/$defs/view" }
    },
    "capability_surfaces": {
      "type": "array", "maxItems": 8,
      "description": "Allowlisted non-CRUD surfaces expressed as semantic capabilities. The compiler, not the model, owns their runtime widget and URL contracts.",
      "items": { "$ref": "#/$defs/capabilitySurface" }
    },
    "commands": {
      "type": "array", "maxItems": 24,
      "items": { "$ref": "#/$defs/command" }
    },
    "representative_states": {
      "type": "array", "maxItems": 12,
      "items": { "$ref": "#/$defs/representativeState" }
    },
    "requirement_bindings": {
      "type": "array", "maxItems": 256,
      "description": "Evidence links accumulated across accepted source turns, not additional UI components. Multiple requirements may refer to the same semantic nodes.",
      "items": { "$ref": "#/$defs/requirementBinding" }
    },
    "automation_requirements": {
      "type": "array", "maxItems": 32,
      "items": { "$ref": "#/$defs/automationRequirement" }
    },
    "capability_gaps": {
      "type": "array", "maxItems": 32,
      "items": { "$ref": "#/$defs/capabilityGap" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$" },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pattern", "density", "content_width", "scroll", "regions"],
      "properties": {
        "pattern": { "enum": ["flow", "split", "grid", "focus_detail", "workbench"] },
        "density": { "enum": ["compact", "comfortable"] },
        "content_width": { "enum": ["fluid", "reading", "wide"] },
        "scroll": { "enum": ["page", "regions"] },
        "regions": {
          "type": "array", "minItems": 1, "maxItems": 8,
          "items": { "$ref": "#/$defs/layoutRegion" }
        }
      },
      "description": "Explicit workspace geometry. Region sizes are the usable inline pixel budget after the application shell, not viewport percentages."
    },
    "layoutRegion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "priority", "scroll", "wide", "compact", "min_px", "preferred_px", "max_px", "grow"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "role": { "enum": ["navigation", "toolbar", "collection", "main", "detail", "inspector", "utility", "status", "commands"] },
        "priority": { "type": "integer", "minimum": 0, "maximum": 100 },
        "scroll": { "enum": ["page", "region", "none"] },
        "wide": { "enum": ["pane", "stack"] },
        "compact": { "enum": ["stack", "drawer", "sheet", "hidden", "overflow", "route"] },
        "min_px": { "type": ["integer", "null"], "minimum": 160, "maximum": 1600 },
        "preferred_px": { "type": ["integer", "null"], "minimum": 160, "maximum": 1600 },
        "max_px": { "type": ["integer", "null"], "minimum": 160, "maximum": 2400 },
        "grow": { "type": "number", "minimum": 0, "maximum": 10 }
      }
    },
    "capabilitySurface": {
      "$ref": "#/$defs/sitePreviewSurface"
    },
    "sitePreviewSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "capability_ref", "region_role", "title", "site_id", "route", "min_height_px"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "capability_ref": { "type": "string", "const": "visual.sitePreview" },
        "region_role": { "$ref": "#/$defs/id", "description": "A declared layout region id, or primary/supporting/actions for a legacy string layout." },
        "title": { "$ref": "#/$defs/localizedText" },
        "site_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
        "route": { "type": "string", "pattern": "^/(?:[A-Za-z0-9._~-]+/?)*$", "maxLength": 256 },
        "min_height_px": { "type": "integer", "minimum": 320, "maximum": 1200 }
      }
    },
    "scalar": {
      "type": ["string", "number", "boolean", "null"]
    },
    "fieldValue": {
      "anyOf": [
        { "$ref": "#/$defs/scalar" },
        { "type": "array", "maxItems": 20, "items": { "type": "string" } }
      ]
    },
    "localizedText": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [{ "required": ["en"] }, { "required": ["ru"] }],
      "properties": {
        "en": { "type": "string", "minLength": 1, "maxLength": 500 },
        "ru": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "item_semantics", "item_label", "fields", "records"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "item_semantics": { "type": "string", "minLength": 1, "maxLength": 500 },
        "item_label": { "$ref": "#/$defs/localizedText" },
        "read_only_when": { "anyOf": [{ "$ref": "#/$defs/condition" }, { "type": "null" }], "description": "Optional record lock evaluated on the stored record before update/delete, not on the edited draft. Null unless the request needs read-only records in a specific state. Creation remains allowed." },
        "fields": {
          "type": "array", "minItems": 1, "maxItems": 24,
          "items": { "$ref": "#/$defs/field" }
        },
        "records": {
          "type": "array", "maxItems": 12,
          "items": { "$ref": "#/$defs/record" }
        }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from_resource_ref", "from_field_ref", "to_resource_ref", "to_field_ref", "cardinality"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "from_resource_ref": { "$ref": "#/$defs/id" },
        "from_field_ref": { "$ref": "#/$defs/id" },
        "to_resource_ref": { "$ref": "#/$defs/id" },
        "to_field_ref": { "$ref": "#/$defs/id", "description": "many_to_one/one_to_one: from is a foreign key, to is the unique target identity. one_to_many: from is the unique parent identity, to is the child's foreign key. Prefer implicit id on either end: write the literal field reference id, never an empty string or null; record.id exists without declaring an editable id field. Reference values must exactly match record.id, never a mutable display label. A declared target field must be unique and cannot be renamed while referenced. one_to_one also requires unique source values. Model many-to-many with an explicit link resource and two many_to_one relationships. Display labels use label_field_refs for the to resource; inverse selectors use the parent collection labels." },
        "label_field_refs": { "type": "array", "maxItems": 3, "uniqueItems": true, "items": { "$ref": "#/$defs/id" }, "description": "Target fields safe to display in selectors. Empty uses target collection labels, or the target identity if it has no collection. Never include private details here." },
        "cardinality": { "type": "string", "enum": ["one_to_one", "one_to_many", "many_to_one"] }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "label"],
      "properties": {
        "value": { "$ref": "#/$defs/scalar" },
        "label": { "$ref": "#/$defs/localizedText" }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_ref", "operator", "value"],
      "properties": {
        "field_ref": { "$ref": "#/$defs/id" },
        "operator": { "type": "string", "enum": ["equals", "not_equals", "nonempty", "empty"] },
        "value": { "$ref": "#/$defs/scalar" }
      }
    },
    "statePredicate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_ref", "operator", "operand"],
      "properties": {
        "field_ref": { "$ref": "#/$defs/id" },
        "operator": { "type": "string", "enum": ["eq", "neq", "lt", "lte", "gt", "gte"] },
        "operand": {
          "anyOf": [
            {
              "type": "object", "additionalProperties": false,
              "required": ["kind", "value", "field_ref"],
              "properties": {
                "kind": { "type": "string", "enum": ["value"] },
                "value": { "$ref": "#/$defs/scalar" },
                "field_ref": { "type": "null" }
              }
            },
            {
              "type": "object", "additionalProperties": false,
              "required": ["kind", "value", "field_ref"],
              "properties": {
                "kind": { "type": "string", "enum": ["field"] },
                "value": { "type": "null" },
                "field_ref": { "$ref": "#/$defs/id" }
              }
            }
          ]
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "value_type", "required", "editable", "options", "visible_when"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "$ref": "#/$defs/localizedText" },
        "help_text": { "anyOf": [{ "$ref": "#/$defs/localizedText" }, { "type": "null" }] },
        "placeholder": { "anyOf": [{ "$ref": "#/$defs/localizedText" }, { "type": "null" }] },
        "value_type": { "type": "string", "enum": ["short_text", "long_text", "markdown", "number", "date", "boolean", "choice", "multi_choice", "attachment", "attachments"] },
        "required": { "type": "boolean" },
        "editable": { "type": "boolean" },
        "options": { "type": "array", "maxItems": 24, "items": { "$ref": "#/$defs/option" } },
        "visible_when": {
          "anyOf": [{ "$ref": "#/$defs/condition" }, { "type": "null" }]
        }
      }
    },
    "fieldEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_ref", "value"],
      "properties": {
        "field_ref": { "$ref": "#/$defs/id" },
        "value": { "$ref": "#/$defs/fieldValue" }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "values"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "values": { "type": "array", "minItems": 1, "maxItems": 24, "items": { "$ref": "#/$defs/fieldValue" } }
      }
    },
    "viewFilter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_ref", "state_ref"],
      "properties": {
        "field_ref": { "$ref": "#/$defs/id" },
        "state_ref": { "$ref": "#/$defs/id" }
      }
    },
    "queryControl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "label", "field_ref"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "type": "string", "enum": ["search", "filter"] },
        "label": { "$ref": "#/$defs/localizedText" },
        "field_ref": {
          "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }]
        }
      }
    },
    "emptyState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "detail"],
      "properties": {
        "title": { "$ref": "#/$defs/localizedText" },
        "detail": {
          "anyOf": [{ "$ref": "#/$defs/localizedText" }, { "type": "null" }]
        }
      }
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "resource_ref", "role", "region_role", "presentation", "title", "field_refs", "filter", "query_controls", "empty_state"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "resource_ref": { "$ref": "#/$defs/id" },
        "role": { "type": "string", "enum": ["collection", "details", "editor"] },
        "region_role": { "$ref": "#/$defs/id", "description": "A declared layout region id, or primary/supporting/actions for a legacy string layout." },
        "surface": {
          "type": "string", "enum": ["inline", "modal", "side_sheet"],
          "description": "Editor surface. Collections and details use inline. Choose modal for a short focused edit, side_sheet for contextual editing, inline for persistent work; this is a design choice, not a quality gate."
        },
        "media": { "anyOf": [{ "$ref": "#/$defs/media" }, { "type": "null" }] },
        "presentation": {
          "anyOf": [
            { "type": "string", "enum": ["list", "table", "cards", "board", "tree", "chart", "accordion"] },
            { "type": "null" }
          ]
        },
        "compact_presentation": {
          "anyOf": [
            { "type": "string", "enum": ["cards"] },
            { "type": "null" }
          ],
          "description": "Responsive override for a table collection. cards keeps the wide layout tabular and renders labeled record cards on compact screens. Null preserves the presentation at every breakpoint."
        },
        "title": { "$ref": "#/$defs/localizedText" },
        "field_refs": { "type": "array", "maxItems": 24, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "presentation_options": { "anyOf": [{ "$ref": "#/$defs/presentationOptions" }, { "type": "null" }] },
        "section": { "anyOf": [{ "$ref": "#/$defs/viewSection" }, { "type": "null" }] },
        "field_display": { "type": "array", "maxItems": 24, "items": { "$ref": "#/$defs/fieldDisplay" } },
        "scope_filters": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/scopeFilter" }, "description": "Permanent equality predicates defining this collection, independent of user search/filter controls. Reset never removes these. Empty for an unrestricted view. Do not also offer a query control for the same field." },
        "selection": { "anyOf": [{ "$ref": "#/$defs/selectionPolicy" }, { "type": "null" }], "description": "Explicit collection interaction contract. Keep row activation separate from record commands: select changes selection, while edit/delete use declared command exposure." },
        "initial_selection_id": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }], "description": "Collection record selected on first render. It must name one fixture record of this view's resource; null starts unselected." },
        "selection_filter": { "anyOf": [{ "$ref": "#/$defs/selectionFilter" }, { "type": "null" }], "description": "Selection-driven relationship projection. Match this collection's field_ref to source_field_ref (null means id) of the selected source record. effect=filter narrows the target; effect=emphasize keeps the global collection visible and marks related rows. Requires an exact declared singular relationship. Do not duplicate this field in other filters." },
        "activation_source_view_ref": {
          "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }],
          "description": "Details-only link to the collection whose row activation reveals this projection. Set the source collection selection.row_activation=open_details. Null for collections and editors."
        },
        "filter": {
          "anyOf": [{ "$ref": "#/$defs/viewFilter" }, { "type": "null" }]
        },
        "query_controls": { "type": "array", "maxItems": 6, "items": { "$ref": "#/$defs/queryControl" } },
        "empty_state": {
          "anyOf": [{ "$ref": "#/$defs/emptyState" }, { "type": "null" }]
        }
      }
    },
    "selectionFilter": {
      "type": "object", "additionalProperties": false, "required": ["field_ref", "source_view_ref", "effect", "empty_selection"],
      "properties": {
        "field_ref": { "$ref": "#/$defs/id" },
        "source_view_ref": { "$ref": "#/$defs/id" },
        "source_field_ref": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }], "description": "Selected source record field, not the target field. Null means implicit id." },
        "effect": { "enum": ["filter", "emphasize"], "description": "filter narrows the target collection; emphasize keeps every target row visible and marks related rows." },
        "empty_selection": { "type": "string", "const": "show_all", "description": "Before a source row is selected the target stays visible. Additional empty-selection policies remain an ABI extension point." }
      }
    },
    "selectionPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "indicator", "row_activation"],
      "properties": {
        "mode": { "enum": ["none", "single"] },
        "indicator": { "enum": ["none", "radio", "row_accent"] },
        "row_activation": { "enum": ["none", "select", "open_details"] }
      }
    },
    "scopeFilter": {
      "type": "object", "additionalProperties": false, "required": ["field_ref", "value"],
      "properties": { "field_ref": { "$ref": "#/$defs/id" }, "value": { "type": ["string", "number", "boolean"] } }
    },
    "viewSection": {
      "type": "object", "additionalProperties": false, "required": ["id", "title", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "title": { "$ref": "#/$defs/localizedText" },
        "kind": { "enum": ["tab", "settings"] }
      },
      "description": "Optional content partition. Views with the same section id share a tab or an application Settings modal. Repeat the same title/kind for that id. Null keeps a view shared. The compiler supplies navigation and retains selection. Settings still use real resources and commands; this does not implement external effects."
    },
    "presentationOptions": {
      "type": "object", "additionalProperties": false,
      "required": ["group_field_ref", "parent_field_ref", "value_field_ref", "draggable"],
      "properties": {
        "group_field_ref": { "type": ["string", "null"] },
        "parent_field_ref": { "type": ["string", "null"] },
        "value_field_ref": { "type": ["string", "null"] },
        "order_field_ref": { "type": ["string", "null"] },
        "draggable": { "type": "boolean" }
      },
      "description": "List: draggable=true plus order_field_ref enables persisted rank ordering when the numeric order field is editable. Board: group_field_ref is a writable string choice for lanes; draggable persists lane changes (not rank within a lane). Accordion: group_field_ref groups expandable records. Tree: parent_field_ref links nullable parent record ids. Chart: group_field_ref is the x label, value_field_ref is a number; one point per record, no invented aggregation. Otherwise null."
    },
    "fieldDisplay": {
      "type": "object", "additionalProperties": false, "required": ["field_ref", "overflow", "align"],
      "properties": {
        "field_ref": { "$ref": "#/$defs/id" },
        "overflow": { "enum": ["wrap", "truncate"] },
        "align": { "enum": ["start", "center", "end"] }
      },
      "description": "Optional per-visible-field text policy for lists/cards/tables. Wrap is the default; truncate is an explicit compact summary with full text available on hover."
    },
    "media": {
      "type": "object", "additionalProperties": false,
      "required": ["source_field_ref", "kind_field_ref", "poster_field_ref"],
      "properties": {
        "source_field_ref": { "$ref": "#/$defs/id" },
        "kind_field_ref": { "type": ["string", "null"] },
        "poster_field_ref": { "type": ["string", "null"] }
      },
      "description": "Details: render image/video/audio from a declared source field, with optional kind (image/video/audio) and poster fields. Collections: show source as a cover image. Null means text-only; a filename alone is not a viewer."
    },
    "guard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["when", "require_nonempty"],
      "properties": {
        "when": { "$ref": "#/$defs/condition" },
        "require_nonempty": { "type": "array", "maxItems": 12, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "view_ref", "label", "confirmation", "input_field_refs", "fixed_values", "guard"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "type": "string", "enum": ["create", "update", "transition", "delete"] },
        "view_ref": { "$ref": "#/$defs/id" },
        "label": { "$ref": "#/$defs/localizedText" },
        "confirmation": {
          "anyOf": [{ "$ref": "#/$defs/localizedText" }, { "type": "null" }]
        },
        "input_field_refs": { "type": "array", "maxItems": 24, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "fixed_values": { "type": "array", "maxItems": 12, "items": { "$ref": "#/$defs/fieldEntry" } },
        "exposure": { "$ref": "#/$defs/commandExposure" },
        "guard": {
          "anyOf": [{ "$ref": "#/$defs/guard" }, { "type": "null" }]
        }
      }
    },
    "commandExposure": {
      "type": "object", "additionalProperties": false,
      "required": ["placement", "presentation"],
      "properties": {
        "placement": { "enum": ["collection_header", "row_action", "editor_primary", "editor_danger"] },
        "presentation": { "enum": ["button", "icon"] }
      },
      "description": "User-visible placement of a command. Create normally belongs in collection_header, record editing in row_action, and destructive commands sharing an editor with update belong in editor_danger."
    },
    "representativeState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "view_ref", "proof", "filters", "min_items", "max_items"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "$ref": "#/$defs/localizedText" },
        "view_ref": { "$ref": "#/$defs/id" },
        "proof": { "$ref": "#/$defs/stateProof" },
        "filters": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/statePredicate" } },
        "min_items": { "type": "integer", "minimum": 0 },
        "max_items": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "stateProof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "visible_field_refs"],
      "properties": {
        "kind": { "type": "string", "enum": ["collection_empty", "collection_items", "field_predicate", "query_empty"] },
        "visible_field_refs": { "type": "array", "maxItems": 8, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
      }
    },
    "requirementBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement_ref", "semantic_refs"],
      "properties": {
        "requirement_ref": { "type": "string", "minLength": 1 },
        "semantic_refs": {
          "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
          "items": { "$ref": "#/$defs/semanticRef" }
        }
      }
    },
    "semanticRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "type": "string", "enum": ["resource", "relationship", "field", "view", "query", "surface", "command", "state"] },
        "id": { "$ref": "#/$defs/id" }
      }
    },
    "automationRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement_ref", "reason", "disclosure", "acceptance"],
      "properties": {
        "requirement_ref": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "enum": ["business_rule", "external_integration"] },
        "disclosure": { "$ref": "#/$defs/localizedText" },
        "acceptance": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    },
    "capabilityGap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement_ref", "code", "detail"],
      "properties": {
        "requirement_ref": { "type": "string", "minLength": 1 },
        "code": { "type": "string", "minLength": 1 },
        "detail": { "type": "string", "minLength": 1 }
      }
    }
  }
}
