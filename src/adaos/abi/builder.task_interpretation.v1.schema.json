{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaos.builder.task_interpretation.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "source_digest", "clause_roles", "requirements", "facts", "transitions", "constraints", "questions", "design_freedom"],
  "properties": {
    "schema": {"type": "string", "const": "adaos.builder.task_interpretation.v1"},
    "source_digest": {"type": "string"},
    "clause_roles": {"type": "array", "items": {"$ref": "#/$defs/clauseRole"}},
    "requirements": {"type": "array", "items": {"$ref": "#/$defs/requirement"}},
    "facts": {"type": "array", "items": {"$ref": "#/$defs/fact"}},
    "transitions": {"type": "array", "items": {"$ref": "#/$defs/transition"}},
    "constraints": {"type": "array", "items": {"$ref": "#/$defs/constraint"}},
    "questions": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/question"}},
    "design_freedom": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "scalar": {"anyOf": [{"type": "string"}, {"type": "number"}, {"type": "boolean"}, {"type": "null"}]},
    "clauseRefs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "clauseRole": {
      "type": "object", "additionalProperties": false, "required": ["clause_id", "roles"],
      "properties": {
        "clause_id": {"type": "string"},
        "roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "enum": ["product", "fact", "policy", "verification", "exclusion", "design", "question", "formatting"]}}
      }
    },
    "requirement": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "clause_ids", "statement", "kind", "operation", "verification_family", "supersedes"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "clause_ids": {"$ref": "#/$defs/clauseRefs"},
        "statement": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "enum": ["behavior", "information", "collection", "data_state", "ui", "authoring", "policy", "verification", "exclusion"]},
        "operation": {"anyOf": [{"type": "string", "enum": ["list", "inspect", "search", "filter", "sort", "create", "update", "assign", "transition", "delete", "archive", "other"]}, {"type": "null"}]},
        "verification_family": {"type": "string", "enum": ["value", "transition", "preservation", "query", "layout", "locale", "policy", "runtime"]},
        "supersedes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "fact": {
      "type": "object", "additionalProperties": false,
      "required": ["clause_ids", "subject", "field", "source_field", "value", "record_evidence", "field_evidence"],
      "properties": {
        "clause_ids": {"$ref": "#/$defs/clauseRefs"}, "subject": {"type": "string"},
        "field": {"type": "string", "description": "Proposed stable field identifier; reversible design, not a source quote."},
        "source_field": {"type": "string", "description": "Exact source spelling of the field label. Never translate it."},
        "value": {"$ref": "#/$defs/scalar"},
        "record_evidence": {"type": "string", "minLength": 1, "description": "Exact contiguous source excerpt for this one record, containing its identity and field evidence. Do not include other record sentences."},
        "field_evidence": {"type": "string", "minLength": 1, "description": "Exact substring of record_evidence containing this source_field and its value, e.g. reading 12."}
      }
    },
    "transition": {
      "type": "object", "additionalProperties": false,
      "required": ["clause_ids", "requirement_id", "command_label", "field", "from_value", "to_value", "preserve_other_fields"],
      "properties": {
        "clause_ids": {"$ref": "#/$defs/clauseRefs"}, "requirement_id": {"type": "string"},
        "command_label": {"type": "string"}, "field": {"type": "string"},
        "from_value": {"$ref": "#/$defs/scalar"}, "to_value": {"$ref": "#/$defs/scalar"},
        "preserve_other_fields": {"type": "boolean"}
      }
    },
    "constraint": {
      "type": "object", "additionalProperties": false,
      "required": ["clause_ids", "kind", "subject", "values"],
      "properties": {
        "clause_ids": {"$ref": "#/$defs/clauseRefs"},
        "kind": {"type": "string", "enum": ["section_title", "visible_text", "search_fields", "locale", "viewport", "forbid_external"]},
        "subject": {"type": "string"}, "values": {"type": "array", "items": {"type": "string"}}
      }
    },
    "question": {
      "type": "object", "additionalProperties": false, "required": ["clause_ids", "question"],
      "properties": {"clause_ids": {"$ref": "#/$defs/clauseRefs"}, "question": {"type": "string", "minLength": 1}}
    }
  }
}
