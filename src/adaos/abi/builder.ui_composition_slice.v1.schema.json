{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaos.builder.ui_composition_slice.v1",
  "title": "AdaOS Builder UI Composition Slice",
  "type": "object",
  "required": [
    "schema", "slice_id", "source_revision", "target", "parent_ref",
    "siblings", "order", "ancestors", "composition", "actions", "bindings",
    "acceptance", "renderer_evidence"
  ],
  "properties": {
    "schema": { "const": "adaos.builder.ui_composition_slice.v1" },
    "slice_id": { "type": "string", "minLength": 1, "maxLength": 160 },
    "source_revision": { "type": "string", "minLength": 1, "maxLength": 80 },
    "target": {
      "type": "object",
      "required": ["ref", "kind", "id", "type", "label", "area"],
      "properties": {
        "ref": { "type": "string", "pattern": "^(widget|field):" },
        "kind": { "enum": ["widget", "field"] },
        "id": { "type": "string", "minLength": 1, "maxLength": 160 },
        "type": { "type": ["string", "null"], "maxLength": 160 },
        "label": { "type": ["string", "null"], "maxLength": 500 },
        "area": { "type": ["string", "null"], "maxLength": 160 }
      },
      "additionalProperties": false
    },
    "parent_ref": { "type": ["string", "null"], "maxLength": 240 },
    "siblings": { "type": "array", "maxItems": 100, "items": { "type": "string", "maxLength": 240 } },
    "order": { "type": "integer", "minimum": 0 },
    "ancestors": { "type": "array", "maxItems": 40, "items": { "type": "string", "maxLength": 240 } },
    "composition": {
      "type": "object",
      "required": ["collection", "layout", "responsive"],
      "properties": {
        "collection": { "type": "string", "maxLength": 80 },
        "layout": {},
        "responsive": {}
      },
      "additionalProperties": false
    },
    "actions": { "type": "array", "maxItems": 100 },
    "bindings": { "type": "object" },
    "acceptance": { "type": "array", "maxItems": 100, "items": { "type": "object" } },
    "renderer_evidence": {
      "type": "object",
      "required": ["kind", "target_ref", "visible_neighbor_refs", "budget", "truncated", "digest"],
      "properties": {
        "kind": { "const": "bounded_structured" },
        "target_ref": { "type": "string", "pattern": "^(widget|field):" },
        "visible_neighbor_refs": { "type": "array", "maxItems": 20, "items": { "type": "string", "maxLength": 240 } },
        "budget": { "type": "integer", "minimum": 1, "maximum": 20 },
        "truncated": { "type": "boolean" },
        "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
