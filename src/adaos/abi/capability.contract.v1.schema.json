{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adaos.dev/abi/capability.contract.v1.schema.json",
  "title": "AdaOS Capability Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "capability_ref", "version", "title", "operations", "invariants", "effects", "authority_requirements", "dependencies", "state_ports", "conformance_refs", "compatibility", "contract_digest"],
  "properties": {
    "schema": {"const": "adaos.capability.contract.v1"},
    "capability_ref": {"type": "string", "pattern": "^capability:[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$"},
    "version": {"$ref": "#/$defs/version"},
    "title": {"type": "string", "minLength": 1},
    "operations": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["operation_id", "input_schema", "output_schema", "errors"],
        "properties": {
          "operation_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
          "input_schema": {"type": "object"},
          "output_schema": {"type": "object"},
          "errors": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
        }
      }
    },
    "invariants": {"$ref": "#/$defs/textSet"},
    "effects": {"$ref": "#/$defs/textSet"},
    "authority_requirements": {"$ref": "#/$defs/textSet"},
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["capability_ref", "contract_range"],
        "properties": {
          "capability_ref": {"type": "string", "pattern": "^capability:"},
          "contract_range": {"type": "string", "minLength": 1},
          "optional": {"type": "boolean"}
        }
      }
    },
    "state_ports": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["port_id", "contract_ref", "contract_range", "access", "requirements"],
        "properties": {
          "port_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
          "contract_ref": {"type": "string", "pattern": "^state-contract:"},
          "contract_range": {"type": "string", "minLength": 1},
          "access": {"enum": ["reads", "writes", "appends", "caches"]},
          "requirements": {
            "type": "object", "additionalProperties": false,
            "properties": {
              "consistency_at_least": {"type": "string", "minLength": 1},
              "durability": {"type": "string", "minLength": 1},
              "isolation": {"type": "string", "minLength": 1},
              "mutation_authority": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "conformance_refs": {"$ref": "#/$defs/textSet"},
    "compatibility": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "backward_compatible_with": {"type": "array", "items": {"$ref": "#/$defs/version"}, "uniqueItems": true},
        "supersedes": {"type": "array", "items": {"type": "string", "pattern": "^capability:"}, "uniqueItems": true}
      }
    },
    "contract_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "textSet": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  }
}
