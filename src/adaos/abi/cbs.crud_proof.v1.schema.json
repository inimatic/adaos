{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adaos.dev/abi/cbs.crud_proof.v1.schema.json",
  "title": "AdaOS CBS CRUD Executable Proof Bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "source_digest", "semantic_revision_digest", "environment_profile", "application_requirement", "contracts", "packages", "binding_deliveries", "application_resolutions", "resolution_plans", "workspace_locks", "local_revisions", "state_evidence", "evidence_claims", "evidence_assessments", "telemetry", "trace_ids", "test_output", "invariants", "created_at", "proof_digest"],
  "properties": {
    "schema": {"const": "adaos.cbs.crud_proof.v1"},
    "run_id": {"type": "string", "minLength": 1},
    "source_digest": {"$ref": "#/$defs/digest"},
    "semantic_revision_digest": {"$ref": "#/$defs/digest"},
    "environment_profile": {"type": "object"},
    "application_requirement": {"type": "object"},
    "contracts": {"type": "array", "minItems": 2, "items": {"type": "object"}},
    "packages": {"type": "array", "minItems": 3, "items": {"type": "object"}},
    "binding_deliveries": {"type": "array", "minItems": 3, "items": {"type": "object"}},
    "application_resolutions": {"type": "array", "minItems": 3, "items": {"type": "object"}},
    "resolution_plans": {"type": "array", "minItems": 3, "items": {"type": "object"}},
    "workspace_locks": {"type": "array", "minItems": 4, "items": {"type": "object"}},
    "local_revisions": {"type": "array", "minItems": 4, "items": {"type": "object"}},
    "state_evidence": {"type": "array", "minItems": 2, "items": {"type": "object"}},
    "evidence_claims": {"type": "array", "minItems": 4, "items": {"type": "object"}},
    "evidence_assessments": {"type": "array", "minItems": 4, "items": {"type": "object"}},
    "telemetry": {"type": "object"},
    "trace_ids": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "test_output": {"type": "object"},
    "invariants": {
      "type": "object",
      "additionalProperties": false,
      "required": ["materialization_independence", "package_topology_independence", "state_continuity", "application_independence", "atomic_rebinding"],
      "properties": {
        "materialization_independence": {"const": true},
        "package_topology_independence": {"const": true},
        "state_continuity": {"const": true},
        "application_independence": {"const": true},
        "atomic_rebinding": {"const": true}
      }
    },
    "created_at": {"type": "string", "minLength": 1},
    "proof_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
