{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaos.consumer_contract_assessment.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "assessment_id",
    "digest",
    "recorded_at",
    "application_ref",
    "consumer_digest",
    "consumer_ref",
    "usage_lock_id",
    "change_id",
    "wave_id",
    "contract_ref",
    "source_contract_digest",
    "target_contract_digest",
    "environment_ref",
    "compatibility",
    "reason",
    "action_required",
    "policy_digest",
    "evidence_refs",
    "evidence_expires_at",
    "findings"
  ],
  "properties": {
    "schema": {
      "const": "adaos.consumer_contract_assessment.v1"
    },
    "assessment_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "application_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "consumer_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "consumer_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "usage_lock_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "change_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "wave_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "contract_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "source_contract_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "target_contract_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "environment_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "compatibility": {
      "enum": [
        "unaffected",
        "compatible",
        "deprecated_compatible",
        "migration_available",
        "verification_due",
        "incompatible",
        "unknown"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "action_required": {
      "type": "boolean"
    },
    "policy_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "maxItems": 512
    },
    "evidence_expires_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "maxItems": 4096
    }
  }
}
