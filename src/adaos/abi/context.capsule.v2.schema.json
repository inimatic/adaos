{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaos.context.capsule.v2",
  "title": "AdaOS Context Capsule",
  "type": "object",
  "required": ["schema", "capsule_id", "digest", "kind", "subject_refs", "authority_ref", "trust_class", "tainted", "sensitivity", "license", "retention_class", "origin", "valid_from", "recorded_at", "artifact_ref"],
  "properties": {
    "schema": {"const": "adaos.context.capsule.v2"},
    "capsule_id": {"type": "string", "pattern": "^ctxcap\\."},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "kind": {"type": "string", "minLength": 1},
    "subject_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "authority_ref": {"type": "string", "minLength": 1},
    "trust_class": {"enum": ["quarantined", "untrusted", "observed", "validated", "accepted"]},
    "tainted": {"type": "boolean"},
    "sensitivity": {"type": "string", "minLength": 1},
    "license": {"type": "string", "minLength": 1},
    "retention_class": {"type": "string", "minLength": 1},
    "origin": {"type": "object"},
    "source_digests": {"type": "object"},
    "policy_ref": {"type": ["string", "null"]},
    "locale": {"type": "string"},
    "valid_from": {"type": "string", "format": "date-time"},
    "valid_to": {"type": ["string", "null"], "format": "date-time"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "supersedes_refs": {"type": "array", "items": {"type": "string"}},
    "artifact_ref": {"type": "string", "pattern": "^artifact://context/sha256/[0-9a-f]{64}$"},
    "artifact_bytes": {"type": "integer", "minimum": 0},
    "metadata": {"type": "object"},
    "created_at": {"type": "string", "format": "date-time"},
    "revoked_at": {"type": ["string", "null"], "format": "date-time"},
    "revocation_reason": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
