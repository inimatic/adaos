{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaos.context.delta.v1",
  "title": "AdaOS Context Delta",
  "type": "object",
  "required": [
    "schema",
    "base_packet_ref",
    "base_packet_digest",
    "target_packet_ref",
    "target_packet_digest",
    "purpose",
    "audience",
    "changed",
    "removed",
    "unchanged",
    "replacement_sections"
  ],
  "properties": {
    "schema": {"const": "adaos.context.delta.v1"},
    "base_packet_ref": {"type": "string", "minLength": 1},
    "base_packet_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "target_packet_ref": {"type": "string", "minLength": 1},
    "target_packet_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "subject_refs": {"type": "array", "items": {"type": "string"}},
    "purpose": {"type": "string"},
    "audience": {"type": "string"},
    "changed": {"type": "array", "items": {"type": "object"}},
    "removed": {"type": "array", "items": {"type": "object"}},
    "unchanged": {"type": "array", "items": {"type": "object"}},
    "replacement_sections": {"type": "object"}
  },
  "additionalProperties": true
}
