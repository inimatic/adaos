{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaos.context.invalidation.v1",
  "title": "AdaOS Context Invalidation",
  "type": "object",
  "required": ["schema", "invalidation_id", "subject_ref", "reason", "event_ref", "recorded_at"],
  "properties": {
    "schema": {"const": "adaos.context.invalidation.v1"},
    "invalidation_id": {"type": "string", "pattern": "^ctxinv\\."},
    "subject_ref": {"type": "string", "minLength": 1},
    "source_digest": {"type": ["string", "null"]},
    "edge_type": {"type": ["string", "null"]},
    "reason": {"type": "string", "minLength": 1},
    "event_ref": {"type": "string", "minLength": 1},
    "recorded_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
