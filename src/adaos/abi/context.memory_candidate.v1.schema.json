{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaos.context.memory_candidate.v1",
  "title": "AdaOS Context Memory Candidate",
  "type": "object",
  "required": ["schema", "candidate_id", "kind", "status", "source_refs", "proposal_ref", "proposed_by", "proposed_by_kind", "authority_ref", "trust_class", "tainted", "validation_refs", "revision", "created_at", "updated_at"],
  "properties": {
    "schema": {"const": "adaos.context.memory_candidate.v1"},
    "candidate_id": {"type": "string", "pattern": "^ctxmem\\."},
    "kind": {"enum": ["authoritative", "procedural", "episodic", "working"]},
    "status": {"enum": ["proposed", "qualified", "promoted", "rejected", "rolled_back"]},
    "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "proposal_ref": {"type": "string", "pattern": "^artifact://context/"},
    "proposed_by": {"type": "string"},
    "proposed_by_kind": {"type": "string"},
    "authority_ref": {"type": "string"},
    "trust_class": {"type": "string"},
    "tainted": {"type": "boolean"},
    "validation_refs": {"type": "array", "items": {"type": "string"}},
    "qualified_by": {"type": ["string", "null"]},
    "promoted_capsule_id": {"type": ["string", "null"]},
    "supersedes_candidate_ref": {"type": ["string", "null"]},
    "reason": {"type": "string"},
    "revision": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
