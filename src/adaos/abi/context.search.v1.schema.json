{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaos.context.search.v1",
  "title": "AdaOS Context Capsule Search",
  "type": "object",
  "required": ["schema", "query", "count", "items"],
  "properties": {
    "schema": {"const": "adaos.context.search.v1"},
    "query": {"type": "string", "minLength": 1},
    "count": {"type": "integer", "minimum": 0},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["schema", "capsule_id", "digest", "kind", "subject_refs", "authority_ref", "trust_class", "tainted", "sensitivity", "locale", "recorded_at", "drill_down"],
        "properties": {
          "schema": {"const": "adaos.context.search_item.v1"},
          "capsule_id": {"type": "string", "pattern": "^ctxcap\\."},
          "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "kind": {"type": "string", "minLength": 1},
          "subject_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "authority_ref": {"type": "string", "minLength": 1},
          "trust_class": {"enum": ["quarantined", "untrusted", "observed", "validated", "accepted"]},
          "tainted": {"type": "boolean"},
          "sensitivity": {"type": "string", "minLength": 1},
          "locale": {"type": "string"},
          "recorded_at": {"type": "string", "format": "date-time"},
          "metadata": {"type": "object"},
          "drill_down": {
            "type": "object",
            "required": ["capsule_id"],
            "properties": {"capsule_id": {"type": "string", "pattern": "^ctxcap\\."}},
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
