{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaos.context.subject_binding.v1",
  "title": "AdaOS Context Subject Binding",
  "type": "object",
  "required": ["schema", "binding_id", "subject_ref", "purpose", "audience", "branch", "capsule_id", "revision", "updated_at"],
  "properties": {
    "schema": {"const": "adaos.context.subject_binding.v1"},
    "binding_id": {"type": "string", "pattern": "^ctxbind\\."},
    "subject_ref": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "audience": {"type": "string", "minLength": 1},
    "branch": {"type": "string", "minLength": 1},
    "capsule_id": {"type": "string", "pattern": "^ctxcap\\."},
    "revision": {"type": "integer", "minimum": 1},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
