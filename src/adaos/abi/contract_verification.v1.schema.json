{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaos.contract_verification.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "verification_id",
    "digest",
    "recorded_at",
    "application_ref",
    "consumer_digest",
    "change_id",
    "target_contract_digest",
    "environment_ref",
    "policy_digest",
    "kind",
    "result",
    "report_digest",
    "valid_until",
    "runner_ref"
  ],
  "properties": {
    "schema": {
      "const": "adaos.contract_verification.v1"
    },
    "verification_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "application_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "consumer_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "change_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "target_contract_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "environment_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "policy_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "kind": {
      "enum": [
        "contract_test",
        "runtime_smoke",
        "conformance"
      ]
    },
    "result": {
      "enum": [
        "passed",
        "failed"
      ]
    },
    "report_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "valid_until": {
      "type": "string",
      "format": "date-time"
    },
    "runner_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    }
  }
}
