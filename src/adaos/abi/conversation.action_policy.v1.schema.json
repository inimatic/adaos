{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaos.conversation.action_policy.v1",
  "title": "AdaOS Canonical Action Policy",
  "type": "object",
  "required": ["schema", "risk_class", "side_effect", "confirmation"],
  "properties": {
    "schema": { "const": "adaos.conversation.action_policy.v1" },
    "risk_class": {
      "enum": [
        "read",
        "local_reversible",
        "isolated_write",
        "trial_activation",
        "workspace_activation",
        "publication",
        "destructive"
      ]
    },
    "side_effect": { "enum": ["none", "reversible", "external", "destructive"] },
    "confirmation": { "enum": ["none", "required", "rich_review"] },
    "required_capabilities": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "policy_refs": {
      "type": "array",
      "maxItems": 50,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 300 }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$" }
  },
  "additionalProperties": false
}
