{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaos.conversation.channel_capability_profile.v1",
  "title": "AdaOS Channel Capability Profile",
  "type": "object",
  "required": ["schema", "profile_id", "version", "transport", "client", "surface", "capabilities", "limits", "locale", "accessibility", "handoff", "acknowledgement", "permission_boundary", "business_availability_boundary", "fresh_until", "updated_at"],
  "properties": {
    "schema": { "const": "adaos.conversation.channel_capability_profile.v1" },
    "profile_id": { "type": "string", "minLength": 1, "maxLength": 240 },
    "version": { "type": "integer", "minimum": 1 },
    "transport": { "type": "string", "minLength": 1, "maxLength": 80 },
    "client": { "type": "string", "minLength": 1, "maxLength": 120 },
    "surface": { "type": "string", "minLength": 1, "maxLength": 120 },
    "capabilities": { "type": "object", "additionalProperties": { "type": "boolean" } },
    "limits": { "type": "object", "additionalProperties": { "type": ["integer", "number", "string", "boolean", "null"] } },
    "locale": { "type": "string", "minLength": 2, "maxLength": 40 },
    "accessibility": { "type": "object" },
    "handoff": {
      "type": "object",
      "required": ["reconnect", "resume", "cross_channel"],
      "properties": {
        "reconnect": { "type": "boolean" },
        "resume": { "type": "boolean" },
        "cross_channel": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "acknowledgement": { "enum": ["none", "delivery", "read", "action"] },
    "permission_boundary": { "const": "separate" },
    "business_availability_boundary": { "const": "separate" },
    "fresh_until": { "type": ["string", "null"], "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object" }
  },
  "additionalProperties": false
}
