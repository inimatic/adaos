{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaos.conversation.interaction.v1",
  "title": "AdaOS Conversation Interaction",
  "type": "object",
  "required": [
    "schema", "interaction_id", "conversation_id", "owner", "prompt",
    "input_spec", "actions", "requirements", "required_capabilities", "optional_capabilities",
    "fallbacks", "status", "generation", "task_ref", "workflow_ref",
    "reply_route_ref", "expires_at", "created_at", "updated_at"
  ],
  "properties": {
    "schema": { "const": "adaos.conversation.interaction.v1" },
    "interaction_id": { "type": "string", "minLength": 1, "maxLength": 240 },
    "conversation_id": { "type": "string", "minLength": 1, "maxLength": 240 },
    "thread_id": { "type": ["string", "null"], "maxLength": 240 },
    "owner": { "type": "string", "minLength": 1, "maxLength": 240 },
    "prompt": { "type": "string", "minLength": 1, "maxLength": 8000 },
    "prompt_ref": { "type": ["string", "null"], "maxLength": 160 },
    "prompt_message": { "type": ["object", "null"] },
    "locale_context": { "type": ["object", "null"] },
    "input_spec": {
      "type": "object",
      "required": ["kind", "required_fields", "choices", "sensitive"],
      "properties": {
        "kind": { "enum": ["text", "choice", "multi_choice", "form", "confirmation"] },
        "required_fields": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 120 } },
        "choices": {
          "type": "array", "maxItems": 100,
          "items": {
            "type": "object", "required": ["value", "label"],
            "properties": {
              "value": { "type": "string", "minLength": 1, "maxLength": 240 },
              "label": { "type": "string", "minLength": 1, "maxLength": 240 },
              "description": { "type": ["string", "null"], "maxLength": 1000 }
            },
            "additionalProperties": false
          }
        },
        "sensitive": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "actions": {
      "type": "array", "maxItems": 100,
      "items": {
        "type": "object", "required": ["action_id", "label", "command", "value", "risk", "confirmation_required", "semantics", "target_ref", "expected_generation", "principal_scope", "command_context_ref"],
        "properties": {
          "action_id": { "type": "string", "minLength": 1, "maxLength": 160 },
          "label": { "type": "string", "minLength": 1, "maxLength": 240 },
          "label_ref": { "type": ["string", "null"], "maxLength": 160 },
          "label_message": { "type": ["object", "null"] },
          "command": { "type": "string", "minLength": 1, "maxLength": 160 },
          "value": {},
          "risk": { "type": "string", "minLength": 1, "maxLength": 80 },
          "confirmation_required": { "type": "boolean" },
          "semantics": {
            "type": "object",
            "required": ["schema", "preset", "effect_class", "operation", "executor", "mutates_domain", "records_consent", "terminal", "effect_ref", "schedule", "assertion_required"],
            "properties": {
              "schema": { "const": "adaos.conversation.action_semantics.v1" },
              "preset": { "enum": ["details", "preview", "open", "test", "snooze", "defer", "refuse", "cancel", "compensate", "custom"] },
              "effect_class": { "type": "string", "minLength": 1, "maxLength": 80 },
              "operation": { "type": "string", "minLength": 1, "maxLength": 160 },
              "executor": { "type": "string", "minLength": 1, "maxLength": 80 },
              "mutates_domain": { "type": "boolean" },
              "records_consent": { "type": "boolean" },
              "terminal": { "type": "boolean" },
              "effect_ref": {
                "type": ["object", "null"],
                "required": ["kind", "id", "digest"],
                "properties": {
                  "kind": { "type": "string", "minLength": 1, "maxLength": 80 },
                  "id": { "type": "string", "minLength": 1, "maxLength": 240 },
                  "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
                },
                "additionalProperties": false
              },
              "schedule": {
                "type": ["object", "null"],
                "required": ["resume_at", "consent_deadline"],
                "properties": {
                  "resume_at": { "type": "string", "format": "date-time" },
                  "consent_deadline": { "type": "string", "format": "date-time" }
                },
                "additionalProperties": false
              },
              "assertion_required": { "type": "boolean" }
            },
            "additionalProperties": false
          },
          "assurance": {
            "type": "object",
            "required": ["mode", "voice_permitted", "trusted_interface_required", "step_up_required"],
            "properties": {
              "mode": { "enum": ["voice_permitted", "trusted_interface_required", "step_up_required"] },
              "voice_permitted": { "type": "boolean" },
              "trusted_interface_required": { "type": "boolean" },
              "step_up_required": { "type": "boolean" }
            },
            "additionalProperties": false
          },
          "target_ref": { "type": ["object", "null"] },
          "expected_generation": { "type": "integer", "minimum": 0 },
          "principal_scope": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 160 } },
          "command_context_ref": { "type": ["object", "null"] }
        },
        "additionalProperties": false
      }
    },
    "requirements": { "type": "object" },
    "required_capabilities": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 120 } },
    "optional_capabilities": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 120 } },
    "fallbacks": { "type": "array", "uniqueItems": true, "items": { "enum": ["plain_text", "numbered_text", "deep_link", "web_view", "miniapp", "unsupported"] } },
    "status": { "enum": ["created", "projected", "awaiting_input", "partially_answered", "answered", "accepted", "completed", "validation_failed", "expired", "cancelled", "superseded"] },
    "generation": { "type": "integer", "minimum": 0 },
    "task_ref": { "type": ["object", "null"] },
    "workflow_ref": { "type": ["object", "null"] },
    "reply_route_ref": { "type": ["object", "null"] },
    "expires_at": { "type": ["string", "null"], "format": "date-time" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": ["string", "null"], "format": "date-time" },
    "metadata": { "type": "object" },
    "turn_trace_id": { "type": ["string", "null"], "maxLength": 240 },
    "trace": { "type": ["object", "null"] }
  },
  "additionalProperties": false
}
