{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaos.conversation.interaction_response.v1",
  "title": "AdaOS Conversation Interaction Response",
  "type": "object",
  "required": [
    "schema", "response_id", "interaction_id", "interaction_generation",
    "actor_id", "source", "values", "original_text", "action_token",
    "intent_proposal", "status", "validation", "supersedes_response_id",
    "presentation_id", "target_ref", "source_message_ref", "consumed_command",
    "rejection_reason", "idempotency_key", "created_at"
  ],
  "properties": {
    "schema": { "const": "adaos.conversation.interaction_response.v1" },
    "response_id": { "type": "string", "minLength": 1, "maxLength": 240 },
    "interaction_id": { "type": "string", "minLength": 1, "maxLength": 240 },
    "interaction_generation": { "type": "integer", "minimum": 0 },
    "actor_id": { "type": "string", "minLength": 1, "maxLength": 240 },
    "source": { "enum": ["action", "intent", "text", "form", "system"] },
    "values": { "type": "object" },
    "original_text": { "type": ["string", "null"], "maxLength": 8000 },
    "action_token": { "type": ["string", "null"], "maxLength": 300 },
    "intent_proposal": { "type": ["object", "null"] },
    "presentation_id": { "type": ["string", "null"], "maxLength": 240 },
    "target_ref": { "type": ["object", "null"] },
    "source_message_ref": { "type": ["object", "null"] },
    "consumed_command": { "type": ["object", "null"] },
    "assurance_receipt": {
      "type": ["object", "null"],
      "properties": {
        "mode": { "enum": ["voice_permitted", "trusted_interface_required", "step_up_required"] },
        "profile_id": { "type": "string", "minLength": 1, "maxLength": 240 },
        "profile_version": { "type": "integer", "minimum": 1 },
        "presentation_id": { "type": "string", "minLength": 1, "maxLength": 240 },
        "admitted": { "const": true },
        "capabilities": { "type": "object", "additionalProperties": { "type": "boolean" } }
      },
      "required": ["mode", "profile_id", "profile_version", "presentation_id", "admitted", "capabilities"],
      "additionalProperties": false
    },
    "rejection_reason": { "type": ["string", "null"], "maxLength": 240 },
    "status": { "enum": ["partial", "answered", "accepted", "rejected", "superseded"] },
    "validation": {
      "type": "object",
      "required": ["valid", "reason_code", "missing_fields"],
      "properties": {
        "valid": { "type": "boolean" },
        "reason_code": { "type": ["string", "null"], "maxLength": 160 },
        "missing_fields": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 120 } }
      },
      "additionalProperties": false
    },
    "supersedes_response_id": { "type": ["string", "null"], "maxLength": 240 },
    "idempotency_key": { "type": "string", "minLength": 1, "maxLength": 300 },
    "created_at": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object" },
    "turn_trace_id": { "type": ["string", "null"], "maxLength": 240 },
    "trace": { "type": ["object", "null"] }
  },
  "additionalProperties": false
}
