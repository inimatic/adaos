{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaos.conversation.output.v1",
  "title": "AdaOS Semantic Conversation Output",
  "type": "object",
  "required": [
    "schema",
    "output_id",
    "conversation_id",
    "kind",
    "audience",
    "risk_level",
    "reason",
    "summary",
    "content_parts",
    "details",
    "actions",
    "fields",
    "evidence_refs",
    "correlation",
    "next_expected_input",
    "channel_constraints",
    "handoff_target",
    "lifecycle",
    "provenance",
    "trace",
    "response_envelope_ref",
    "created_at"
  ],
  "properties": {
    "schema": { "const": "adaos.conversation.output.v1" },
    "output_id": { "$ref": "#/$defs/id" },
    "conversation_id": { "$ref": "#/$defs/refId" },
    "kind": {
      "enum": [
        "clarification",
        "confirmation",
        "accepted",
        "progress",
        "result",
        "repair",
        "refusal",
        "handoff"
      ]
    },
    "audience": { "enum": ["user", "developer", "operator"] },
    "risk_level": { "enum": ["none", "low", "medium", "high", "destructive"] },
    "reason": {
      "type": "object",
      "required": ["code", "explanation", "retryable", "source"],
      "properties": {
        "code": { "type": ["string", "null"], "maxLength": 240 },
        "explanation": { "type": ["string", "null"], "maxLength": 4000 },
        "retryable": { "type": "boolean" },
        "source": { "enum": ["conversation", "workflow", "skill", "policy", "provider", "system"] }
      },
      "additionalProperties": false
    },
    "summary": { "type": "string", "minLength": 1, "maxLength": 12000 },
    "content_parts": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["part_id", "kind", "text", "data", "artifact_ref", "media_type", "sensitivity"],
        "properties": {
          "part_id": { "$ref": "#/$defs/id" },
          "kind": { "enum": ["text", "json", "artifact", "media", "code", "table"] },
          "text": { "type": ["string", "null"], "maxLength": 12000 },
          "data": { "type": ["object", "null"] },
          "artifact_ref": { "oneOf": [{ "$ref": "#/$defs/ref" }, { "type": "null" }] },
          "media_type": { "type": ["string", "null"], "maxLength": 160 },
          "sensitivity": { "enum": ["public", "internal", "personal", "sensitive"] }
        },
        "additionalProperties": false
      }
    },
    "details": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["label", "value"],
        "properties": {
          "label": { "type": "string", "minLength": 1, "maxLength": 240 },
          "value": {},
          "sensitivity": { "enum": ["public", "internal", "personal", "sensitive"] }
        },
        "additionalProperties": false
      }
    },
    "actions": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "action_id",
          "label",
          "command",
          "risk_level",
          "target_refs",
          "requires_confirmation",
          "presentation_hint"
          ,"binding"
          ,"action_policy"
        ],
        "properties": {
          "action_id": { "$ref": "#/$defs/id" },
          "label": { "type": "string", "minLength": 1, "maxLength": 240 },
          "command": { "type": ["string", "null"], "maxLength": 160 },
          "risk_level": { "enum": ["none", "low", "medium", "high", "destructive"] },
          "target_refs": {
            "type": "array",
            "maxItems": 20,
            "items": { "$ref": "#/$defs/ref" }
          },
          "requires_confirmation": { "type": "boolean" },
          "presentation_hint": { "enum": ["primary", "secondary", "danger", "link", "hidden"] },
          "binding": {
            "type": "object",
            "required": ["kind", "affordance_id", "workflow_command", "skill_operation"],
            "properties": {
              "kind": { "enum": ["workflow_command", "skill_invocation", "query", "link", "none"] },
              "affordance_id": { "type": ["string", "null"], "maxLength": 160 },
              "workflow_command": { "type": ["string", "null"], "maxLength": 160 },
              "skill_operation": { "type": ["string", "null"], "maxLength": 160 }
            },
            "additionalProperties": false
          },
          "action_policy": { "$ref": "#/$defs/actionPolicy" },
          "metadata": { "type": "object" }
        },
        "additionalProperties": false
      }
    },
    "fields": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["field_id", "label", "kind", "required", "value"],
        "properties": {
          "field_id": { "$ref": "#/$defs/id" },
          "label": { "type": "string", "minLength": 1, "maxLength": 240 },
          "kind": { "enum": ["text", "number", "boolean", "choice", "multi_choice", "date", "json"] },
          "required": { "type": "boolean" },
          "value": {},
          "choices": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "required": ["value", "label"],
              "properties": {
                "value": { "type": "string", "minLength": 1, "maxLength": 240 },
                "label": { "type": "string", "minLength": 1, "maxLength": 240 }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "evidence_refs": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/ref" }
    },
    "correlation": {
      "type": "object",
      "required": [
        "turn_trace_id",
        "intent_proposal_id",
        "interaction_id",
        "workflow_ref",
        "workflow_event_id",
        "command_id",
        "run_ref",
        "reply_route_ref"
      ],
      "properties": {
        "turn_trace_id": { "type": ["string", "null"], "maxLength": 240 },
        "intent_proposal_id": { "type": ["string", "null"], "maxLength": 240 },
        "interaction_id": { "type": ["string", "null"], "maxLength": 240 },
        "workflow_ref": { "oneOf": [{ "$ref": "#/$defs/ref" }, { "type": "null" }] },
        "workflow_event_id": { "type": ["string", "null"], "maxLength": 240 },
        "command_id": { "type": ["string", "null"], "maxLength": 160 },
        "run_ref": { "oneOf": [{ "$ref": "#/$defs/ref" }, { "type": "null" }] },
        "reply_route_ref": { "oneOf": [{ "$ref": "#/$defs/ref" }, { "type": "null" }] }
      },
      "additionalProperties": false
    },
    "next_expected_input": {
      "type": "object",
      "required": ["kind", "interaction_id", "fields"],
      "properties": {
        "kind": { "enum": ["action", "text", "form", "none"] },
        "interaction_id": { "type": ["string", "null"], "maxLength": 240 },
        "fields": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/id" }
        }
      },
      "additionalProperties": false
    },
    "channel_constraints": {
      "type": "object",
      "required": ["preferred", "fallbacks", "requires_rich_view"],
      "properties": {
        "preferred": { "type": ["string", "null"], "maxLength": 80 },
        "fallbacks": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 80 }
        },
        "requires_rich_view": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "handoff_target": {
      "oneOf": [{ "$ref": "#/$defs/ref" }, { "type": "null" }]
    },
    "lifecycle": {
      "type": "object",
      "required": ["sequence", "update_kind", "supersedes_output_id", "terminal", "task_status"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1 },
        "update_kind": { "enum": ["snapshot", "delta"] },
        "supersedes_output_id": { "type": ["string", "null"], "maxLength": 240 },
        "terminal": { "type": "boolean" },
        "task_status": { "enum": ["none", "submitted", "working", "input_required", "completed", "failed", "cancelled", "unknown"] }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["source", "package_ref", "package_digest", "source_ref", "source_digest"],
      "properties": {
        "source": { "enum": ["conversation", "workflow", "skill", "repair", "system"] },
        "package_ref": { "oneOf": [{ "$ref": "#/$defs/ref" }, { "type": "null" }] },
        "package_digest": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
        "source_ref": { "oneOf": [{ "$ref": "#/$defs/ref" }, { "type": "null" }] },
        "source_digest": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "trace": { "$ref": "#/$defs/trace" },
    "response_envelope_ref": {
      "description": "Optional link to the current channel-neutral delivery envelope derived from this semantic output.",
      "oneOf": [{ "$ref": "#/$defs/ref" }, { "type": "null" }]
    },
    "metadata": { "type": "object" },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,239}$" },
    "refId": { "type": "string", "minLength": 1, "maxLength": 240 },
    "ref": {
      "type": "object",
      "required": ["kind", "id"],
      "properties": {
        "schema": { "type": ["string", "null"], "maxLength": 120 },
        "kind": { "type": "string", "minLength": 1, "maxLength": 120 },
        "id": { "type": "string", "minLength": 1, "maxLength": 240 },
        "version": { "type": ["string", "null"], "maxLength": 120 },
        "generation": { "type": ["integer", "null"], "minimum": 0 },
        "digest": { "type": ["string", "null"], "maxLength": 120 }
      },
      "additionalProperties": false
    },
    "trace": {
      "type": "object",
      "required": ["trace_id", "span_id", "parent_span_id", "traceparent"],
      "properties": {
        "trace_id": { "type": ["string", "null"], "pattern": "^[0-9a-f]{32}$" },
        "span_id": { "type": ["string", "null"], "pattern": "^[0-9a-f]{16}$" },
        "parent_span_id": { "type": ["string", "null"], "pattern": "^[0-9a-f]{16}$" },
        "traceparent": { "type": ["string", "null"], "maxLength": 128 }
      },
      "additionalProperties": false
    },
    "actionPolicy": {
      "type": "object",
      "required": ["schema", "risk_class", "side_effect", "confirmation"],
      "properties": {
        "schema": { "const": "adaos.conversation.action_policy.v1" },
        "risk_class": { "enum": ["read", "local_reversible", "isolated_write", "trial_activation", "workspace_activation", "publication", "destructive"] },
        "side_effect": { "enum": ["none", "reversible", "external", "destructive"] },
        "confirmation": { "enum": ["none", "required", "rich_review"] },
        "required_capabilities": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "policy_refs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 300 } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
