{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaos.conversation.rich_view.v1",
  "title": "AdaOS Declarative Conversation Rich View",
  "type": "object",
  "required": ["schema", "view_id", "version", "title_ref", "presentations"],
  "properties": {
    "schema": { "const": "adaos.conversation.rich_view.v1" },
    "view_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "version": { "type": "integer", "minimum": 1 },
    "title_ref": { "type": "string", "minLength": 1, "maxLength": 300 },
    "data_contract_ref": { "type": ["string", "null"], "maxLength": 300 },
    "presentations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["kind", "required_capabilities", "renderer_ref"],
        "properties": {
          "kind": { "enum": ["panel", "modal", "drawer", "compact_message", "deep_link"] },
          "required_capabilities": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 120 }
          },
          "renderer_ref": { "type": "string", "minLength": 1, "maxLength": 300 },
          "semantic_equivalence": { "enum": ["full", "bounded", "handoff"] },
          "max_inline_bytes": { "type": ["integer", "null"], "minimum": 1 }
        },
        "additionalProperties": false
      }
    },
    "metadata": { "type": "object" }
  },
  "additionalProperties": false
}
