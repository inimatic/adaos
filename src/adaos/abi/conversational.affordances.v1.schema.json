{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaos.conversational.affordances.v1",
  "title": "AdaOS Conversational Affordance Source",
  "type": "object",
  "required": ["schema", "package_id", "affordances"],
  "properties": {
    "schema": { "const": "adaos.conversational.affordances.v1" },
    "package_id": { "$ref": "#/$defs/id" },
    "affordances": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "label",
          "description",
          "workflow",
          "side_effect_class",
          "required_capabilities",
          "output_refs"
        ],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "kind": { "enum": ["workflow_command", "skill_invocation", "query", "view", "output_only"] },
          "label": { "type": "string", "minLength": 1, "maxLength": 240 },
          "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "workflow": {
            "type": ["object", "null"],
            "required": ["workflow_type", "command_id"],
            "properties": {
              "workflow_type": { "$ref": "#/$defs/id" },
              "command_id": { "$ref": "#/$defs/id" },
              "transition_id": { "type": ["string", "null"], "maxLength": 160 }
            },
            "additionalProperties": false
          },
          "skill_invocation": {
            "type": ["object", "null"],
            "required": ["skill_id", "operation_id"],
            "properties": {
              "skill_id": { "$ref": "#/$defs/id" },
              "operation_id": { "$ref": "#/$defs/id" }
            },
            "additionalProperties": false
          },
          "side_effect_class": { "enum": ["none", "read_only", "reversible", "external", "destructive"] },
          "required_capabilities": {
            "type": "array",
            "maxItems": 50,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/id" }
          },
          "presentation": {
            "type": "object",
            "properties": {
              "hint": { "enum": ["button", "form", "link", "text", "hidden"] },
              "priority": { "type": "integer", "minimum": 0, "maximum": 100 }
            },
            "additionalProperties": false
          },
          "output_refs": {
            "type": "array",
            "maxItems": 50,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/id" }
          },
          "metadata": { "type": "object" }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$" }
  },
  "additionalProperties": false
}
