{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaos.conversational.learning_export.v1",
  "title": "AdaOS Conversational Learning Export",
  "type": "object",
  "required": ["schema", "package_id", "package_digest", "privacy_review_ref", "locales", "content_policy", "stories"],
  "properties": {
    "schema": { "const": "adaos.conversational.learning_export.v1" },
    "package_id": { "$ref": "#/$defs/id" },
    "package_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "privacy_review_ref": { "type": "string", "minLength": 1, "maxLength": 500 },
    "locales": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 2, "maxLength": 40 }
    },
    "content_policy": { "const": "authored_semantics_without_runtime_transcripts" },
    "stories": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": ["story_id", "title", "locale", "channel", "story_kind", "steps"],
        "properties": {
          "story_id": { "$ref": "#/$defs/id" },
          "title": { "type": "string", "minLength": 1, "maxLength": 240 },
          "locale": { "type": "string", "minLength": 2, "maxLength": 40 },
          "channel": { "type": "string", "minLength": 1, "maxLength": 80 },
          "story_kind": { "enum": ["workflow", "skill", "dialog"] },
          "steps": {
            "type": "array",
            "minItems": 1,
            "maxItems": 200,
            "items": {
              "type": "object",
              "required": ["sequence", "intent_id", "command", "output_ref", "expected_state"],
              "properties": {
                "sequence": { "type": "integer", "minimum": 1 },
                "intent_id": { "type": ["string", "null"], "maxLength": 160 },
                "command": { "type": ["string", "null"], "maxLength": 160 },
                "output_ref": { "type": ["string", "null"], "maxLength": 160 },
                "expected_state": { "type": ["string", "null"], "maxLength": 160 }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$" }
  },
  "additionalProperties": false
}
