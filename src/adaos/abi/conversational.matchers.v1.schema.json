{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaos.conversational.matchers.v1",
  "title": "AdaOS Conversational Deterministic Matcher Source",
  "type": "object",
  "required": ["schema", "package_id", "matchers"],
  "properties": {
    "schema": { "const": "adaos.conversational.matchers.v1" },
    "package_id": { "$ref": "#/$defs/id" },
    "matchers": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "type": "object",
        "required": ["id", "kind", "intent_id", "locale", "pattern", "flags", "slots", "source"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "kind": { "enum": ["exact", "keyword", "regex"] },
          "intent_id": { "$ref": "#/$defs/id" },
          "locale": { "type": "string", "minLength": 2, "maxLength": 40 },
          "pattern": { "type": "string", "minLength": 1, "maxLength": 8000 },
          "flags": {
            "type": "array",
            "uniqueItems": true,
            "items": { "enum": ["ignore_case", "multiline", "dotall", "unicode"] }
          },
          "slots": {
            "type": "object",
            "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 160 }
          },
          "source": { "enum": ["authored", "teacher_candidate", "teacher_promoted", "migration"] },
          "provenance": { "type": "object" }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$" }
  },
  "additionalProperties": false
}
