{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaos.conversational.output.v1",
  "title": "AdaOS Conversational Output Source",
  "type": "object",
  "required": ["schema", "package_id", "outputs"],
  "properties": {
    "schema": { "const": "adaos.conversational.output.v1" },
    "package_id": { "$ref": "#/$defs/id" },
    "outputs": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": ["id", "kind", "audience", "summary", "details", "actions", "next_expected_input"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "kind": {
            "enum": [
              "clarification",
              "confirmation",
              "accepted",
              "progress",
              "result",
              "repair",
              "refusal",
              "handoff"
            ]
          },
          "audience": { "enum": ["user", "developer", "operator"] },
          "summary": { "type": "string", "minLength": 1, "maxLength": 12000 },
          "details": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "required": ["label", "value"],
              "properties": {
                "label": { "type": "string", "minLength": 1, "maxLength": 240 },
                "value": { "type": "string", "minLength": 1, "maxLength": 2000 }
              },
              "additionalProperties": false
            }
          },
          "actions": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "required": ["action_id", "label", "affordance_id"],
              "properties": {
                "action_id": { "$ref": "#/$defs/id" },
                "label": { "type": "string", "minLength": 1, "maxLength": 240 },
                "affordance_id": { "type": ["string", "null"], "maxLength": 160 }
              },
              "additionalProperties": false
            }
          },
          "next_expected_input": { "enum": ["action", "text", "form", "none"] },
          "metadata": { "type": "object" }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$" }
  },
  "additionalProperties": false
}
