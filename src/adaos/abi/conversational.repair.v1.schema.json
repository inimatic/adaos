{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaos.conversational.repair.v1",
  "title": "AdaOS Conversational Repair Source",
  "type": "object",
  "required": ["schema", "package_id", "policies"],
  "properties": {
    "schema": { "const": "adaos.conversational.repair.v1" },
    "package_id": { "$ref": "#/$defs/id" },
    "policies": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": ["id", "kind", "max_attempts", "output_ref", "terminal_outcome"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "kind": {
            "enum": [
              "no_match",
              "no_input",
              "correction",
              "interruption",
              "disambiguation",
              "cancel",
              "resume",
              "slot_change",
              "provider_outage"
            ]
          },
          "max_attempts": { "type": "integer", "minimum": 0, "maximum": 20 },
          "output_ref": { "$ref": "#/$defs/id" },
          "terminal_outcome": { "enum": ["retry", "clarification", "rejected", "deferred", "handoff"] },
          "metadata": { "type": "object" }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$" }
  },
  "additionalProperties": false
}
