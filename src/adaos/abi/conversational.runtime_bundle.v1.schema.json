{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaos.conversational.runtime_bundle.v1",
  "title": "AdaOS Compiled Conversational Runtime Bundle",
  "type": "object",
  "required": ["schema", "package_ref", "source_digest", "default_locale", "supported_locales", "catalog_digest", "catalogs", "intents", "matchers", "affordances", "outputs", "repair_policies", "provider_artifacts", "rollout"],
  "properties": {
    "schema": { "const": "adaos.conversational.runtime_bundle.v1" },
    "package_ref": { "type": "object" },
    "source_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "default_locale": { "type": "string", "minLength": 2, "maxLength": 40 },
    "supported_locales": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 2, "maxLength": 40 } },
    "catalog_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "catalogs": { "type": "object", "additionalProperties": { "type": "object", "additionalProperties": { "type": "string" } } },
    "intents": { "type": "object" },
    "matchers": { "type": "object" },
    "affordances": { "type": "object" },
    "outputs": { "type": "object" },
    "repair_policies": { "type": "object" },
    "provider_artifacts": { "type": "array", "items": { "type": "object" } },
    "rollout": { "type": "object" }
  },
  "additionalProperties": false
}
