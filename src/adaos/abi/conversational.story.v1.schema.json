{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaos.conversational.story.v1",
  "title": "AdaOS Conversation Story",
  "type": "object",
  "required": ["schema", "id", "workflow_type", "locale", "channel", "actor", "start", "steps"],
  "properties": {
    "schema": { "const": "adaos.conversational.story.v1" },
    "id": { "$ref": "#/$defs/id" },
    "title": { "type": ["string", "null"], "maxLength": 240 },
    "workflow_type": { "$ref": "#/$defs/id" },
    "locale": { "type": "string", "minLength": 2, "maxLength": 40 },
    "channel": { "type": "string", "minLength": 1, "maxLength": 80 },
    "actor": {
      "type": "object",
      "required": ["id", "permissions", "roles"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 240 },
        "permissions": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 160 }
        },
        "roles": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 80 }
        }
      },
      "additionalProperties": false
    },
    "start": {
      "type": "object",
      "required": ["instance_id", "state", "generation", "context"],
      "properties": {
        "instance_id": { "type": "string", "minLength": 1, "maxLength": 240 },
        "state": { "$ref": "#/$defs/id" },
        "generation": { "type": "integer", "minimum": 0 },
        "context": { "type": "object" }
      },
      "additionalProperties": false
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": ["expect"],
        "properties": {
          "user": { "type": ["string", "null"], "maxLength": 8000 },
          "event": { "type": ["object", "null"] },
          "expect": {
            "type": "object",
            "required": ["output"],
            "properties": {
              "proposal": {
                "type": ["object", "null"],
                "required": ["kind", "command", "arguments"],
                "properties": {
                  "kind": { "enum": ["workflow_command", "skill_invocation", "question", "unrelated"] },
                  "command": { "type": ["string", "null"], "maxLength": 160 },
                  "arguments": { "type": "object" },
                  "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
                },
                "additionalProperties": false
              },
              "command": { "type": ["string", "null"], "maxLength": 160 },
              "transition_id": { "type": ["string", "null"], "maxLength": 160 },
              "state": { "type": ["string", "null"], "maxLength": 160 },
              "reason_code": { "type": ["string", "null"], "maxLength": 240 },
              "output": {
                "type": "object",
                "required": ["kind"],
                "properties": {
                  "kind": {
                    "enum": [
                      "clarification",
                      "confirmation",
                      "accepted",
                      "progress",
                      "result",
                      "repair",
                      "refusal",
                      "handoff"
                    ]
                  },
                  "output_ref": { "type": ["string", "null"], "maxLength": 160 },
                  "summary": { "type": ["string", "null"], "maxLength": 12000 },
                  "actions": {
                    "type": "array",
                    "maxItems": 100,
                    "items": { "$ref": "#/$defs/id" }
                  },
                  "next_expected_input": { "enum": ["action", "text", "form", "none"] }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "metadata": { "type": "object" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$" }
  },
  "additionalProperties": false
}
