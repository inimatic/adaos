{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adaos.dev/abi/development_feedback.v1.schema.json",
  "title": "AdaOS Development Feedback v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "feedback_id", "revision", "source", "category", "status",
    "summary", "blocking", "confidence", "impact", "target_refs",
    "evidence_refs", "relation_refs", "ticket_refs", "comments",
    "dedup_key", "occurrence_count", "history", "created_at", "updated_at"
  ],
  "properties": {
    "schema": {"const": "adaos.development_feedback.v1"},
    "feedback_id": {"type": "string", "pattern": "^devfeedback\\.[A-Za-z0-9]+$"},
    "revision": {"type": "integer", "minimum": 1},
    "source": {
      "enum": ["pre_codex_llm", "codex", "validator", "builder", "human_review", "legacy_builder_session"]
    },
    "category": {
      "enum": [
        "missing_capability", "ambiguous_contract", "conflicting_contract",
        "inefficient_contract", "insufficient_context", "observability_gap",
        "validation_gap", "policy_block", "result_rejected"
      ]
    },
    "status": {"enum": ["observed", "triaged", "accepted", "rejected", "promoted"]},
    "summary": {"type": "string", "minLength": 3, "maxLength": 4000},
    "details": {"type": "string", "maxLength": 12000},
    "recommendation": {"type": "string", "maxLength": 4000},
    "blocking": {"type": "boolean"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "impact": {
      "type": "array", "maxItems": 8, "uniqueItems": true,
      "items": {"enum": ["blocker", "correctness", "reliability", "efficiency", "generalization", "comprehension", "observability", "policy"]}
    },
    "target_refs": {
      "type": "array", "maxItems": 50, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]*:.+$", "maxLength": 500}
    },
    "evidence_refs": {
      "type": "array", "maxItems": 100,
      "items": {"type": "object", "additionalProperties": true}
    },
    "relation_refs": {
      "type": "array", "maxItems": 100,
      "items": {"type": "object", "additionalProperties": true}
    },
    "ticket_refs": {
      "type": "array", "maxItems": 20, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^dticket\\.[A-Za-z0-9]+$"}
    },
    "comments": {
      "type": "array", "maxItems": 500,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["comment_id", "body", "actor", "created_at"],
        "properties": {
          "comment_id": {"type": "string", "pattern": "^devfeedback-comment\\.[A-Za-z0-9]+$"},
          "body": {"type": "string", "minLength": 1, "maxLength": 4000},
          "actor": {"type": "string", "minLength": 1, "maxLength": 200},
          "created_at": {"type": "string", "format": "date-time"}
        }
      }
    },
    "classification": {"type": "object", "additionalProperties": true},
    "promotion": {"type": "object", "additionalProperties": true},
    "dedup_key": {"type": "string", "minLength": 1, "maxLength": 500},
    "occurrence_count": {"type": "integer", "minimum": 1},
    "history": {
      "type": "array", "maxItems": 1000,
      "items": {"type": "object", "additionalProperties": true}
    },
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  }
}
