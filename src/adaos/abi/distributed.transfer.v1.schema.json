{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "distributed.transfer.v1.schema.json",
  "title": "AdaOS Distributed Transfer v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "transfer_id", "operation_id", "partition_id", "source_instance_id", "target_instance_id", "authority_epoch", "state", "checkpoint", "manifest_digest", "item_count", "byte_count", "resume_token_ref", "started_at", "updated_at"],
  "properties": {
    "schema": { "const": "adaos.distributed.transfer.v1" }, "transfer_id": { "$ref": "#/$defs/token" }, "operation_id": { "$ref": "#/$defs/token" }, "partition_id": { "$ref": "#/$defs/token" }, "source_instance_id": { "$ref": "#/$defs/token" }, "target_instance_id": { "$ref": "#/$defs/token" }, "authority_epoch": { "type": "integer", "minimum": 1 }, "state": { "enum": ["preparing", "transferring", "verifying", "complete", "failed", "uncertain"] }, "checkpoint": { "$ref": "#/$defs/nullableToken" }, "manifest_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }, "item_count": { "type": "integer", "minimum": 0 }, "byte_count": { "type": "integer", "minimum": 0 }, "resume_token_ref": { "$ref": "#/$defs/nullableToken" }, "started_at": { "type": "string", "format": "date-time" }, "updated_at": { "type": "string", "format": "date-time" }
  },
  "$defs": { "token": { "type": "string", "minLength": 1, "maxLength": 500 }, "nullableToken": { "type": ["string", "null"], "minLength": 1, "maxLength": 500 } }
}
