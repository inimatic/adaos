{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adaos.dev/abi/environment.profile.v1.schema.json",
  "title": "AdaOS Environment Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "profile_ref", "profile_class", "modes", "provider_features", "guarantees", "authorities", "profile_digest"],
  "properties": {
    "schema": {"const": "adaos.environment.profile.v1"},
    "profile_ref": {"type": "string", "pattern": "^profile:"},
    "profile_class": {"enum": ["local", "public-connected"]},
    "modes": {"type": "array", "minItems": 1, "items": {"enum": ["simulation", "sandbox", "production"]}, "uniqueItems": true},
    "provider_features": {"$ref": "#/$defs/textSet"},
    "guarantees": {
      "type": "object", "additionalProperties": false,
      "required": ["consistency", "durability", "isolation"],
      "properties": {
        "consistency": {"$ref": "#/$defs/textSet"},
        "durability": {"$ref": "#/$defs/textSet"},
        "isolation": {"$ref": "#/$defs/textSet"}
      }
    },
    "authorities": {"$ref": "#/$defs/textSet"},
    "ingress_guarantees": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["profile_ref", "guarantees"],
        "properties": {
          "profile_ref": {"type": "string", "pattern": "^ingress-profile:"},
          "guarantees": {
            "type": "object",
            "additionalProperties": false,
            "required": ["single_use", "local_acceptance", "encrypted_delivery"],
            "properties": {
              "single_use": {"type": "boolean"},
              "local_acceptance": {"type": "boolean"},
              "encrypted_delivery": {"type": "boolean"}
            }
          }
        }
      }
    },
    "profile_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "textSet": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  }
}
