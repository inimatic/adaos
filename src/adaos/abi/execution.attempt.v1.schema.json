{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaos.execution.attempt.v1",
  "title": "AdaOS Execution Attempt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "attempt_id",
    "owner_ref",
    "spec_id",
    "spec_digest",
    "provider_id",
    "provider_attempt_id",
    "idempotency_key",
    "status",
    "created_at",
    "updated_at",
    "started_at",
    "finished_at",
    "pid",
    "process_create_time",
    "exit_code",
    "failure",
    "stdout",
    "stderr",
    "metadata"
  ],
  "properties": {
    "schema": { "const": "adaos.execution.attempt.v1" },
    "attempt_id": { "type": "string", "minLength": 1 },
    "owner_ref": { "type": "string", "pattern": "^(skill|service|core):[a-z0-9_.-]+$" },
    "spec_id": { "type": "string", "minLength": 1 },
    "spec_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "provider_id": { "type": "string", "minLength": 1 },
    "provider_attempt_id": { "type": "string", "minLength": 1 },
    "idempotency_key": { "type": "string", "minLength": 1 },
    "status": { "enum": ["accepted", "submitting", "running", "cancelling", "unknown", "succeeded", "failed", "cancelled", "lost"] },
    "created_at": { "type": "string", "minLength": 1 },
    "updated_at": { "type": "string", "minLength": 1 },
    "started_at": { "type": ["string", "null"] },
    "finished_at": { "type": ["string", "null"] },
    "pid": { "type": ["integer", "null"], "minimum": 1 },
    "process_create_time": { "type": ["number", "null"] },
    "exit_code": { "type": ["integer", "null"] },
    "failure": { "type": ["object", "null"] },
    "stdout": { "oneOf": [{ "$ref": "content.ref.v1.schema.json" }, { "type": "null" }] },
    "stderr": { "oneOf": [{ "$ref": "content.ref.v1.schema.json" }, { "type": "null" }] },
    "metadata": { "type": "object" }
  }
}
