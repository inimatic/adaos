{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaos.image_annotations.v1",
  "title": "Native image annotations",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "width", "height", "layers"],
  "properties": {
    "schema": {"const": "adaos.image_annotations.v1"},
    "width": {"type": "integer", "minimum": 1},
    "height": {"type": "integer", "minimum": 1},
    "layers": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/layer"}}
  },
  "$defs": {
    "layer": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "label", "side", "role", "strokes"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 128},
        "label": {"type": "string"},
        "side": {"enum": ["original", "result"]},
        "role": {"type": "string"},
        "visible": {"type": "boolean"},
        "editable": {"type": "boolean"},
        "color": {"type": "string", "pattern": "^#[a-fA-F0-9]{6}$"},
        "opacity": {"type": "number", "minimum": 0, "maximum": 1},
        "mask": {"type": ["string", "object"]},
        "encoding": {"enum": ["alpha", "luminance"]},
        "strokes": {"type": "array", "maxItems": 500, "items": {"$ref": "#/$defs/stroke"}}
      },
      "dependentRequired": {"mask": ["encoding"]}
    },
    "stroke": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "radius", "points"],
      "properties": {
        "kind": {"enum": ["add", "subtract"]},
        "radius": {"type": "number", "exclusiveMinimum": 0},
        "points": {
          "type": "array", "minItems": 1, "maxItems": 512,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["x", "y"],
            "properties": {"x": {"type": "number", "minimum": 0}, "y": {"type": "number", "minimum": 0}}
          }
        }
      }
    }
  },
  "$comment": "Owners additionally validate <=50MP, unique layer IDs, <=500 total strokes, native point bounds, mask media dimensions and source/result artifact ownership. Raster bases are immutable; ordered corrections are rasterized at native resolution."
}
