{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adaos.dev/abi/integration.ingress_audit_evidence.v1.schema.json",
  "title": "AdaOS Integration Ingress Audit Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "evidence_ref", "attempt_ref", "profile_ref", "endpoint_ref", "state_hash", "outcome", "observed_at", "redaction", "evidence_digest"],
  "properties": {
    "schema": {"const": "adaos.integration.ingress_audit_evidence.v1"},
    "evidence_ref": {"type": "string", "pattern": "^ingress-evidence:"},
    "attempt_ref": {"type": "string", "pattern": "^callback-attempt:"},
    "profile_ref": {"type": "string", "pattern": "^ingress-profile:"},
    "endpoint_ref": {"type": "string", "pattern": "^ingress-endpoint:"},
    "state_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "outcome": {"enum": ["issued", "accepted", "denied", "expired", "replayed", "rejected", "provider_failed"]},
    "observed_at": {"type": "string", "format": "date-time"},
    "redaction": {"type": "object", "additionalProperties": false, "required": ["raw_state", "authorization_code", "provider_payload"], "properties": {"raw_state": {"const": "omitted"}, "authorization_code": {"const": "omitted"}, "provider_payload": {"const": "omitted"}}},
    "evidence_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
