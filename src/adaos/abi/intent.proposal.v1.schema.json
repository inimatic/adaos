{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaos.intent.proposal.v1",
  "title": "AdaOS Intent Proposal",
  "type": "object",
  "required": [
    "schema", "proposal_id", "conversation_id", "source_message_id",
    "source_text", "locale", "input_context", "semantic_acts", "alternatives",
    "allowed_command_snapshot", "model", "provenance", "trace", "disposition",
    "clarification", "supersedes_proposal_id", "committed_response_ref",
    "retention", "created_at", "updated_at"
  ],
  "properties": {
    "schema": { "const": "adaos.intent.proposal.v1" },
    "proposal_id": { "$ref": "#/$defs/id" },
    "conversation_id": { "type": "string", "minLength": 1, "maxLength": 240 },
    "source_message_id": { "type": "string", "minLength": 1, "maxLength": 240 },
    "source_text": { "type": "string", "minLength": 1, "maxLength": 8000 },
    "locale": { "type": "string", "minLength": 2, "maxLength": 40 },
    "input_context": {
      "type": "object",
      "required": ["channel", "modality", "actor_ref", "principal_ref", "reply_route_ref", "context_ref"],
      "properties": {
        "channel": { "type": "string", "minLength": 1, "maxLength": 80 },
        "modality": { "enum": ["text", "voice", "event", "control", "multimodal"] },
        "actor_ref": { "oneOf": [{ "$ref": "#/$defs/ref" }, { "type": "null" }] },
        "principal_ref": { "oneOf": [{ "$ref": "#/$defs/ref" }, { "type": "null" }] },
        "reply_route_ref": { "oneOf": [{ "$ref": "#/$defs/ref" }, { "type": "null" }] },
        "context_ref": { "oneOf": [{ "$ref": "#/$defs/ref" }, { "type": "null" }] }
      },
      "additionalProperties": false
    },
    "semantic_acts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["act_id", "kind", "text", "target_ref", "interaction_id", "command", "skill_invocation", "arguments", "confidence"],
        "properties": {
          "act_id": { "$ref": "#/$defs/id" },
          "kind": { "enum": ["interaction_answer", "workflow_command", "skill_invocation", "feedback", "new_issue", "question", "context_selection", "unrelated"] },
          "text": { "type": "string", "minLength": 1, "maxLength": 4000 },
          "target_ref": { "oneOf": [{ "$ref": "#/$defs/ref" }, { "type": "null" }] },
          "interaction_id": { "type": ["string", "null"], "maxLength": 240 },
          "command": { "type": ["string", "null"], "maxLength": 160 },
          "skill_invocation": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "required": ["skill_id", "operation_id", "arguments", "action_policy"],
                "properties": {
                  "skill_id": { "$ref": "#/$defs/id" },
                  "operation_id": { "$ref": "#/$defs/id" },
                  "arguments": { "type": "object" },
                  "action_policy": { "$ref": "#/$defs/actionPolicy" }
                },
                "additionalProperties": false
              }
            ]
          },
          "arguments": { "type": "object" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "allOf": [
          {
            "if": { "properties": { "kind": { "const": "workflow_command" } } },
            "then": { "properties": { "command": { "type": "string", "minLength": 1 } } }
          },
          {
            "if": { "properties": { "kind": { "const": "skill_invocation" } } },
            "then": { "properties": { "skill_invocation": { "type": "object" } } }
          }
        ],
        "additionalProperties": false
      }
    },
    "alternatives": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["alternative_id", "kind", "confidence", "target_ref", "interaction_id", "action_id", "command"],
        "properties": {
          "alternative_id": { "$ref": "#/$defs/id" },
          "kind": { "enum": ["interaction_answer", "workflow_command", "skill_invocation", "question", "unrelated"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "target_ref": { "oneOf": [{ "$ref": "#/$defs/ref" }, { "type": "null" }] },
          "interaction_id": { "type": ["string", "null"], "maxLength": 240 },
          "action_id": { "type": ["string", "null"], "maxLength": 160 },
          "command": { "type": ["string", "null"], "maxLength": 160 }
        },
        "additionalProperties": false
      }
    },
    "allowed_command_snapshot": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": ["interaction_id", "interaction_generation", "workflow_ref", "actions"],
        "properties": {
          "interaction_id": { "$ref": "#/$defs/id" },
          "interaction_generation": { "type": "integer", "minimum": 0 },
          "workflow_ref": { "oneOf": [{ "$ref": "#/$defs/ref" }, { "type": "null" }] },
          "actions": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "required": ["action_id", "command", "value", "target_ref", "expected_generation", "risk", "confirmation_required"],
              "properties": {
                "action_id": { "$ref": "#/$defs/id" },
                "command": { "$ref": "#/$defs/id" },
                "value": {},
                "target_ref": { "oneOf": [{ "$ref": "#/$defs/ref" }, { "type": "null" }] },
                "expected_generation": { "type": "integer", "minimum": 0 },
                "risk": { "type": "string", "minLength": 1, "maxLength": 80 },
                "confirmation_required": { "type": "boolean" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "model": {
      "type": "object",
      "required": ["provider", "name", "version"],
      "properties": {
        "provider": { "type": "string", "minLength": 1, "maxLength": 120 },
        "name": { "type": "string", "minLength": 1, "maxLength": 240 },
        "version": { "type": "string", "minLength": 1, "maxLength": 120 }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["source", "package_ref", "package_digest", "prompt_digest", "context_digest"],
      "properties": {
        "source": { "enum": ["deterministic", "nlu", "llm", "control", "story"] },
        "package_ref": { "oneOf": [{ "$ref": "#/$defs/ref" }, { "type": "null" }] },
        "package_digest": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
        "prompt_digest": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
        "context_digest": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "trace": { "$ref": "#/$defs/trace" },
    "turn_trace_id": { "type": ["string", "null"], "maxLength": 240 },
    "disposition": { "enum": ["proposed", "clarification_required", "rejected", "committed", "corrected"] },
    "clarification": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["reason_code", "prompt", "candidates"],
          "properties": {
            "reason_code": { "$ref": "#/$defs/id" },
            "prompt": { "type": ["string", "null"], "maxLength": 4000 },
            "candidates": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "object",
                "required": ["interaction_id", "action_id"],
                "properties": {
                  "interaction_id": { "type": ["string", "null"], "maxLength": 240 },
                  "action_id": { "type": ["string", "null"], "maxLength": 160 }
                },
                "additionalProperties": false
              }
            },
            "interaction_id": { "type": ["string", "null"], "maxLength": 240 },
            "action_id": { "type": ["string", "null"], "maxLength": 160 },
            "risk": { "type": ["string", "null"], "maxLength": 80 }
          },
          "additionalProperties": false
        }
      ]
    },
    "supersedes_proposal_id": { "type": ["string", "null"], "maxLength": 240 },
    "committed_response_ref": { "oneOf": [{ "$ref": "#/$defs/ref" }, { "type": "null" }] },
    "retention": {
      "type": "object",
      "required": ["class", "redaction"],
      "properties": {
        "class": { "enum": ["ephemeral", "normal", "audit"] },
        "redaction": { "enum": ["none", "policy", "required"] }
      },
      "additionalProperties": false
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,239}$" },
    "ref": {
      "type": "object",
      "required": ["kind", "id"],
      "properties": {
        "schema": { "type": ["string", "null"], "maxLength": 120 },
        "kind": { "type": "string", "minLength": 1, "maxLength": 120 },
        "id": { "type": "string", "minLength": 1, "maxLength": 240 },
        "version": { "type": ["string", "null"], "maxLength": 120 },
        "generation": { "type": ["integer", "null"], "minimum": 0 },
        "digest": { "type": ["string", "null"], "maxLength": 120 }
      },
      "additionalProperties": false
    },
    "trace": {
      "type": "object",
      "required": ["trace_id", "span_id", "parent_span_id", "traceparent"],
      "properties": {
        "trace_id": { "type": ["string", "null"], "pattern": "^[0-9a-f]{32}$" },
        "span_id": { "type": ["string", "null"], "pattern": "^[0-9a-f]{16}$" },
        "parent_span_id": { "type": ["string", "null"], "pattern": "^[0-9a-f]{16}$" },
        "traceparent": { "type": ["string", "null"], "maxLength": 128 }
      },
      "additionalProperties": false
    },
    "actionPolicy": {
      "type": "object",
      "required": ["schema", "risk_class", "side_effect", "confirmation"],
      "properties": {
        "schema": { "const": "adaos.conversation.action_policy.v1" },
        "risk_class": { "enum": ["read", "local_reversible", "isolated_write", "trial_activation", "workspace_activation", "publication", "destructive"] },
        "side_effect": { "enum": ["none", "reversible", "external", "destructive"] },
        "confirmation": { "enum": ["none", "required", "rich_review"] },
        "required_capabilities": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "policy_refs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 300 } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
