{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaos.intent.proposal.v1",
  "title": "AdaOS Intent Proposal",
  "type": "object",
  "required": [
    "schema", "proposal_id", "conversation_id", "source_message_id",
    "source_text", "locale", "semantic_acts", "alternatives",
    "allowed_command_snapshot", "model", "disposition", "clarification",
    "supersedes_proposal_id", "committed_response_ref", "retention",
    "created_at", "updated_at"
  ],
  "properties": {
    "schema": { "const": "adaos.intent.proposal.v1" },
    "proposal_id": { "type": "string", "minLength": 1, "maxLength": 240 },
    "conversation_id": { "type": "string", "minLength": 1, "maxLength": 240 },
    "source_message_id": { "type": "string", "minLength": 1, "maxLength": 240 },
    "source_text": { "type": "string", "minLength": 1, "maxLength": 8000 },
    "locale": { "type": "string", "minLength": 2, "maxLength": 40 },
    "semantic_acts": {
      "type": "array", "minItems": 1, "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["act_id", "kind", "text", "target_ref", "interaction_id", "command", "arguments", "confidence"],
        "properties": {
          "act_id": { "type": "string", "minLength": 1, "maxLength": 160 },
          "kind": { "enum": ["interaction_answer", "workflow_command", "feedback", "new_issue", "question", "context_selection", "unrelated"] },
          "text": { "type": "string", "minLength": 1, "maxLength": 4000 },
          "target_ref": { "type": ["object", "null"] },
          "interaction_id": { "type": ["string", "null"], "maxLength": 240 },
          "command": { "type": ["string", "null"], "maxLength": 160 },
          "arguments": { "type": "object" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "additionalProperties": false
      }
    },
    "alternatives": { "type": "array", "maxItems": 20, "items": { "type": "object" } },
    "allowed_command_snapshot": { "type": "array", "maxItems": 200, "items": { "type": "object" } },
    "model": {
      "type": "object", "required": ["provider", "name", "version"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "disposition": { "enum": ["proposed", "clarification_required", "rejected", "committed", "corrected"] },
    "clarification": { "type": ["object", "null"] },
    "supersedes_proposal_id": { "type": ["string", "null"], "maxLength": 240 },
    "committed_response_ref": { "type": ["object", "null"] },
    "retention": {
      "type": "object", "required": ["class", "redaction"],
      "properties": {
        "class": { "enum": ["ephemeral", "normal", "audit"] },
        "redaction": { "enum": ["none", "policy", "required"] }
      },
      "additionalProperties": false
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
