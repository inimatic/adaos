{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "adaos.max.delivery_receipt.v1",
 "type": "object",
 "required": ["schema", "receipt_id", "delivery_attempt_id", "operation_key", "transport", "delivered", "external_message_ids", "error", "completed_at"],
 "properties": {
  "schema": {"const": "adaos.max.delivery_receipt.v1"},
  "receipt_id": {"type": "string", "minLength": 1, "maxLength": 240},
  "delivery_attempt_id": {"type": "string", "minLength": 1, "maxLength": 240},
  "operation_key": {"type": "string", "minLength": 1, "maxLength": 512},
  "transport": {"const": "max"}, "delivered": {"type": "boolean"},
  "external_message_ids": {"type": "array", "maxItems": 100, "items": {"type": "string", "minLength": 1, "maxLength": 240}},
  "error": {"type": ["string", "null"], "maxLength": 240},
  "completed_at": {"type": "string", "minLength": 1, "maxLength": 80}
 }, "additionalProperties": false
}
