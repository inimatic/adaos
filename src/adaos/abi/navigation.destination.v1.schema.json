{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inimatic.com/abi/navigation.destination.v1.schema.json",
  "title": "AdaOS Navigation Destination v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "intent"],
  "properties": {
    "schema": { "const": "adaos.navigation.destination.v1" },
    "intent": {
      "enum": ["connect.register", "auth.login", "webspace.open", "drive.download", "drive.view"]
    },
    "zone": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$" },
    "public_token": { "type": "string", "minLength": 1, "maxLength": 256 },
    "subnet_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "webspace_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "space_kind": {
      "enum": ["workspace", "development", "preview", "trial"]
    },
    "expected_scenario_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "expected_revision": { "type": "string", "minLength": 1, "maxLength": 128 },
    "preview_stage": {
      "enum": ["prototype", "automation", "trial", "publication"]
    },
    "user_code": { "type": "string", "minLength": 1, "maxLength": 128 },
    "pair_code": { "type": "string", "minLength": 1, "maxLength": 128 },
    "auto_login": { "type": "boolean" },
    "try_local_hub": { "type": "boolean" }
  },
  "allOf": [
    {
      "if": { "properties": { "intent": { "const": "connect.register" } } },
      "then": { "required": ["user_code"] }
    },
    {
      "if": { "properties": { "intent": { "const": "webspace.open" } } },
      "then": { "required": ["zone", "subnet_id", "webspace_id", "space_kind"] }
    },
    {
      "if": { "properties": { "intent": { "enum": ["drive.download", "drive.view"] } } },
      "then": { "required": ["zone", "public_token"] }
    }
  ]
}
