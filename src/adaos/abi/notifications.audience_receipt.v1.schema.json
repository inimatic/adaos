{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaos.notifications.audience_receipt.v1",
  "type": "object", "additionalProperties": false,
  "required": ["receipts", "next_cursor", "skipped_count", "status"],
  "properties": {
    "receipts": {"type": "array", "maxItems": 25, "items": {"type": "object",
      "additionalProperties": false, "required": ["schema", "intent_id", "notification_id", "content_revision", "status"],
      "properties": {
        "schema": {"const": "adaos.notifications.receipt.v1"},
        "intent_id": {"type": "string", "maxLength": 240},
        "notification_id": {"type": ["string", "null"], "maxLength": 240},
        "content_revision": {"type": "integer", "minimum": 0},
        "status": {"enum": ["committed", "suppressed", "stale"]}
      }}},
    "next_cursor": {"type": ["string", "null"], "maxLength": 240},
    "skipped_count": {"type": "integer", "minimum": 0, "maximum": 25},
    "status": {"enum": ["committed", "expired_or_erased"]}
  }
}
