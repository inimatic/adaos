{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaos.notifications.preferences.v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "revision", "defaults", "rules", "quiet_hours", "budgets"],
  "properties": {
    "schema": {"const": "adaos.notifications.preferences.v1"},
    "revision": {"type": "integer", "minimum": 0},
    "defaults": {"$ref": "#/$defs/choice"},
    "rules": {"type": "array", "maxItems": 200, "items": {"$ref": "#/$defs/rule"}},
    "quiet_hours": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "start", "end", "timezone"],
      "properties": {
        "enabled": {"type": "boolean"},
        "start": {"type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"},
        "end": {"type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"},
        "timezone": {"type": "string", "minLength": 1, "maxLength": 80},
        "weekdays": {"type": "array", "minItems": 1, "maxItems": 7, "uniqueItems": true, "items": {"type": "integer", "minimum": 0, "maximum": 6}}
      }
    },
    "budgets": {
      "type": "object", "additionalProperties": false,
      "required": ["per_hour", "producer_per_minute", "digest_seconds"],
      "properties": {
        "per_hour": {"type": "integer", "minimum": 1, "maximum": 1000},
        "producer_per_minute": {"type": "integer", "minimum": 1, "maximum": 100},
        "digest_seconds": {"type": "integer", "minimum": 60, "maximum": 86400}
      }
    }
  },
  "$defs": {
    "choice": {
      "type": "object", "additionalProperties": false, "required": ["mode", "endpoint_ids"],
      "properties": {
        "mode": {"enum": ["off", "center_only", "digest", "immediate"]},
        "endpoint_ids": {"type": "array", "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 240}},
        "quiet_exception": {"type": "boolean"},
        "escalate_after_seconds": {"type": "integer", "minimum": 1, "maximum": 86400}
      }
    },
    "rule": {
      "type": "object", "additionalProperties": false, "required": ["scope", "choice"],
      "properties": {
        "scope": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "subnet_ref": {"type": "string", "minLength": 1, "maxLength": 240},
            "application_id": {"type": "string", "minLength": 1, "maxLength": 240},
            "category_id": {"type": "string", "minLength": 1, "maxLength": 128},
            "source_id": {"type": "string", "minLength": 1, "maxLength": 240}
          }
        },
        "choice": {"$ref": "#/$defs/choice"}
      }
    }
  }
}
