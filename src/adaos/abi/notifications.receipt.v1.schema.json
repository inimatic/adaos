{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaos.notifications.receipt.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "intent_id",
    "notification_id",
    "content_revision",
    "status"
  ],
  "properties": {
    "schema": {
      "const": "adaos.notifications.receipt.v1"
    },
    "intent_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "notification_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 240
    },
    "content_revision": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "enum": [
        "committed",
        "suppressed",
        "stale"
      ]
    }
  }
}
