{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaos.pending_action.baseline_evidence.v1",
  "title": "AdaOS Pending Action Baseline Evidence",
  "type": "object",
  "required": [
    "schema",
    "audit",
    "component_revisions",
    "topology",
    "sdk_discovery",
    "sample",
    "failures",
    "artifacts",
    "redaction",
    "digest"
  ],
  "properties": {
    "schema": { "const": "adaos.pending_action.baseline_evidence.v1" },
    "audit": {
      "type": "object",
      "required": ["schema", "observed_at", "inventory", "counts", "redaction"]
    },
    "component_revisions": {
      "type": "object",
      "required": ["core", "client", "application", "runtime", "sdk", "prompt"],
      "properties": {
        "core": { "$ref": "#/$defs/revision" },
        "client": { "$ref": "#/$defs/revision" },
        "application": { "$ref": "#/$defs/revision" },
        "runtime": { "$ref": "#/$defs/revision" },
        "sdk": { "$ref": "#/$defs/revision" },
        "prompt": { "$ref": "#/$defs/revision" }
      },
      "additionalProperties": { "$ref": "#/$defs/revision" }
    },
    "topology": { "type": "object", "maxProperties": 40 },
    "sdk_discovery": { "type": "object", "maxProperties": 40 },
    "sample": {
      "type": "object",
      "required": ["size"],
      "properties": { "size": { "type": "integer", "minimum": 1 } },
      "additionalProperties": true
    },
    "failures": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["stage", "code", "count", "retriable"],
        "properties": {
          "stage": { "type": "string", "minLength": 1, "maxLength": 100 },
          "code": { "type": "string", "minLength": 1, "maxLength": 160 },
          "count": { "type": "integer", "minimum": 1 },
          "retriable": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "artifacts": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["role", "digest", "bytes", "redaction"],
        "properties": {
          "role": { "type": "string", "minLength": 1, "maxLength": 100 },
          "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "bytes": { "type": "integer", "minimum": 0 },
          "redaction": { "type": "string", "minLength": 1, "maxLength": 160 }
        },
        "additionalProperties": false
      }
    },
    "redaction": { "type": "string", "minLength": 1, "maxLength": 500 },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  },
  "additionalProperties": false,
  "$defs": {
    "revision": { "type": "string", "minLength": 1, "maxLength": 200 }
  }
}
