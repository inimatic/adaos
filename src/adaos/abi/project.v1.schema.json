{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaos.project.v1",
  "title": "AdaOS distributable project source manifest",
  "type": "object",
  "$defs": {
    "i18nText": {
      "type": "object",
      "properties": {
        "key": {"type": "string", "minLength": 1, "maxLength": 300},
        "fallback": {"type": "string", "maxLength": 4000},
        "params": {"type": "object", "maxProperties": 50}
      },
      "patternProperties": {
        "^[a-z]{2}(?:[-_][A-Za-z]{2})?$": {"type": "string", "maxLength": 4000}
      },
      "additionalProperties": false
    },
    "permissionDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "purpose"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$"},
        "title": {"type": "string", "minLength": 1, "maxLength": 160},
        "purpose": {"type": "string", "minLength": 1, "maxLength": 500},
        "authorization_details": {"type": "object"},
        "approval_policy": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$"},
        "sensitive": {"type": "boolean"}
      }
    },
    "permissionProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "required", "optional"],
      "properties": {
        "schema": {"const": "adaos.application.permission_profile.v1"},
        "required": {"type": "array", "maxItems": 200, "items": {"$ref": "#/$defs/permissionDeclaration"}},
        "optional": {"type": "array", "maxItems": 200, "items": {"$ref": "#/$defs/permissionDeclaration"}},
        "secrets": {"type": "array", "maxItems": 100, "items": {"type": "object"}},
        "data_practices": {"type": "object"},
        "llm_model_use": {"type": "array", "maxItems": 100, "items": {"type": "object"}},
        "notifications": {"type": "array", "maxItems": 100, "items": {"type": "object"}},
        "background_actions": {"type": "array", "maxItems": 100, "items": {"type": "object"}},
        "external_providers": {"type": "array", "maxItems": 100, "items": {"type": "object"}},
        "privacy_labels": {"type": "object"}
      }
    },
    "applicationRole": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "grants"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$"},
        "title": {"type": "string", "minLength": 1, "maxLength": 160},
        "grants": {
          "type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$"}
        },
        "assignable_to": {
          "type": "array", "maxItems": 10, "uniqueItems": true,
          "items": {"enum": ["owner", "co_owner", "admin", "member", "child", "guest"]}
        },
        "default_for": {"type": "object"},
        "requires_permissions": {
          "type": "array", "maxItems": 200, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$"}
        },
        "sensitive": {"type": "boolean"}
      }
    }
  },
  "required": ["schema", "kind", "id", "version", "profiles", "components", "entrypoints", "catalog", "lifecycle"],
  "properties": {
    "schema": {"const": "adaos.project.v1"},
    "kind": {"const": "project"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"},
    "profiles": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 160}},
    "permissions": {
      "type": "array",
      "maxItems": 200,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$"}
    },
    "permission_profile": {"$ref": "#/$defs/permissionProfile"},
    "application_roles": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/applicationRole"}
    },
    "components": {
      "type": "object",
      "required": ["owned", "dependencies"],
      "properties": {
        "owned": {
          "type": "array", "minItems": 0, "maxItems": 100, "uniqueItems": true,
          "items": {
            "type": "object", "required": ["ref", "role"],
            "properties": {
              "ref": {"type": "string", "pattern": "^(skill|scenario):[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
              "role": {"enum": ["primary", "implementation", "supporting"]},
              "exposure": {"enum": ["application", "project_only", "advanced"]},
              "lifecycle": {"enum": ["bound", "shared"]},
              "relations": {
                "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true,
                "items": {"enum": ["realizes", "presents", "evaluates", "uses"]}
              }
            },
            "additionalProperties": false
          }
        },
        "dependencies": {
          "type": "array", "maxItems": 200,
          "items": {
            "type": "object", "required": ["ref"],
            "properties": {
              "ref": {"type": "string", "pattern": "^(project|skill|scenario):[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
              "version": {"type": ["string", "null"], "maxLength": 80},
              "lifecycle": {"enum": ["shared"]},
              "relations": {
                "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true,
                "items": {"enum": ["realizes", "presents", "evaluates", "uses"]}
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "entrypoints": {
      "type": "array", "maxItems": 50,
      "items": {
        "type": "object", "required": ["id", "presentation", "bindings"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,79}$"},
          "presentation": {"type": "string", "pattern": "^scenario:[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
          "default": {"type": "boolean"},
          "bindings": {"type": "object", "maxProperties": 50, "additionalProperties": {"type": ["string", "number", "boolean", "null"]}}
        },
        "additionalProperties": false
      }
    },
    "catalog": {
      "type": "object", "required": ["title", "description", "categories", "tags"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 300},
        "title_i18n": {"$ref": "#/$defs/i18nText"},
        "description": {"type": "string", "maxLength": 4000},
        "description_i18n": {"$ref": "#/$defs/i18nText"},
        "categories": {"type": "array", "maxItems": 50, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 80}},
        "tags": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 80}}
      },
      "additionalProperties": false
    },
    "publication": {
      "type": "object",
      "properties": {
        "stage": {"enum": ["alpha", "beta", "stable", "deprecated", "internal"]},
        "visibility": {"enum": ["listed", "unlisted", "hidden"]},
        "channel": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,79}$"}
      },
      "additionalProperties": false
    },
    "install": {
      "type": "object",
      "properties": {
        "default": {"type": "boolean"},
        "features": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": ["id", "title", "components"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,79}$"},
              "title": {"type": "string", "minLength": 1, "maxLength": 300},
              "title_i18n": {"$ref": "#/$defs/i18nText"},
              "description": {"type": "string", "maxLength": 2000},
              "description_i18n": {"$ref": "#/$defs/i18nText"},
              "default": {"type": "boolean"},
              "optional": {"type": "boolean"},
              "components": {
                "type": "array",
                "minItems": 1,
                "maxItems": 100,
                "uniqueItems": true,
                "items": {"type": "string", "pattern": "^(skill|scenario):[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"}
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "compatibility": {
      "type": "object",
      "properties": {
        "required_entrypoints": {
          "type": "array", "maxItems": 50, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,79}$"}
        },
        "required_contracts": {
          "type": "array", "maxItems": 200, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 240}
        },
        "validation_profiles": {
          "type": "array", "maxItems": 100, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 160}
        }
      },
      "additionalProperties": false
    },
    "development": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "initiator_ref": {
          "type": "string",
          "pattern": "^(project|skill|scenario):[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "domain_packs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
          }
        }
      },
      "additionalProperties": false
    },
    "lifecycle": {
      "type": "object", "required": ["uninstall"],
      "properties": {
        "uninstall": {
          "type": "object", "required": ["components", "runtime_data", "source_artifacts"],
          "properties": {
            "components": {"enum": ["remove_if_unreferenced", "retain"]},
            "runtime_data": {"enum": ["retain", "remove"]},
            "source_artifacts": {"enum": ["retain", "remove"]}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "created_at": {"type": "string", "format": "date-time"},
    "created_by": {"type": "string", "minLength": 1, "maxLength": 300}
  },
  "additionalProperties": false
}
