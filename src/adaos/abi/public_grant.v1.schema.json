{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inimatic.com/abi/public_grant.v1.schema.json",
  "title": "AdaOS Public Grant v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "grant_kind", "face_id", "resource", "capabilities", "readonly", "status"],
  "properties": {
    "schema": { "const": "adaos.public_grant.v1" },
    "grant_kind": { "type": "string", "minLength": 1, "maxLength": 128 },
    "face_id": { "type": "string", "minLength": 1, "maxLength": 160 },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name"],
      "properties": {
        "kind": { "type": "string", "minLength": 1, "maxLength": 64 },
        "name": { "type": "string", "maxLength": 512 },
        "path": { "type": "string", "maxLength": 2048 }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,63}$"
      },
      "uniqueItems": true
    },
    "readonly": { "type": "boolean" },
    "status": { "enum": ["active", "ready", "revoked", "expired", "disabled"] },
    "expires_at": {
      "anyOf": [
        { "type": "string", "format": "date-time" },
        { "type": "null" }
      ]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
