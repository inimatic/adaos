{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inimatic.com/abi/public_site_delivery_pointer.v1.schema.json",
  "title": "AdaOS Public Site Delivery Pointer v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "site_id", "deployment_digest", "bundle_digest", "renderer_abi", "client_release", "artifacts", "published_at", "generation", "pointer_digest"],
  "properties": {
    "schema": { "const": "adaos.public_site_delivery_pointer.v1" },
    "site_id": { "$ref": "#/$defs/id" },
    "deployment_digest": { "$ref": "#/$defs/digest" },
    "bundle_digest": { "$ref": "#/$defs/digest" },
    "renderer_abi": { "$ref": "#/$defs/rendererAbi" },
    "client_release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "release_id", "renderer_abi", "source_origin", "base_path", "entry", "assets", "release_digest"],
      "properties": {
        "schema": { "const": "adaos.public_site_client_release.v1" },
        "release_id": { "$ref": "#/$defs/id" },
        "renderer_abi": { "$ref": "#/$defs/rendererAbi" },
        "source_origin": { "type": "string", "format": "uri", "pattern": "^https://" },
        "base_path": { "type": "string", "pattern": "^/(?:[A-Za-z0-9_.-]+/)*$", "maxLength": 256 },
        "entry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scripts", "styles"],
          "properties": {
            "scripts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/path" }, "uniqueItems": true },
            "styles": { "type": "array", "items": { "$ref": "#/$defs/path" }, "uniqueItems": true }
          }
        },
        "assets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "digest", "size_bytes", "media_type"],
            "properties": {
              "path": { "$ref": "#/$defs/path" },
              "digest": { "$ref": "#/$defs/digest" },
              "size_bytes": { "type": "integer", "minimum": 1, "maximum": 1073741824 },
              "media_type": { "type": "string", "pattern": "^[a-z0-9.+-]+/[a-zA-Z0-9.+-]+$", "maxLength": 120 }
            }
          }
        },
        "release_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "published_at": { "type": "string", "format": "date-time" },
    "generation": { "type": "integer", "minimum": 1 },
    "previous_pointer_digest": { "$ref": "#/$defs/digest" },
    "pointer_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest", "size_bytes", "media_type", "kind"],
      "properties": {
        "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$", "maxLength": 512 },
        "digest": { "$ref": "#/$defs/digest" },
        "size_bytes": { "type": "integer", "minimum": 0, "maximum": 1073741824 },
        "media_type": { "type": "string", "pattern": "^[a-z0-9.+-]+/[a-zA-Z0-9.+-]+$", "maxLength": 120 },
        "kind": { "enum": ["asset", "projection", "component_package", "component_release_set", "deployment"] }
      }
    },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$" },
    "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$", "maxLength": 512 },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "rendererAbi": { "type": "string", "pattern": "^adaos\\.public-renderer\\.v[1-9][0-9]*$" }
  }
}
