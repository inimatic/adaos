{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inimatic.com/abi/public_site_routing_descriptor.v1.schema.json",
  "title": "AdaOS Public Site Routing Descriptor v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "site_id", "platform_path", "canonical_url", "deployment_digest", "bundle_digest", "component_set_digest", "renderer_abi", "pointer_digest", "client_release", "artifacts", "zones", "generation", "published_at", "descriptor_digest"],
  "properties": {
    "schema": { "const": "adaos.public_site_routing_descriptor.v1" },
    "site_id": { "$ref": "#/$defs/id" },
    "platform_path": { "type": "string", "pattern": "^st_[a-z0-9]{6,32}$" },
    "canonical_url": { "type": "string", "format": "uri", "pattern": "^https://" },
    "deployment_digest": { "$ref": "#/$defs/digest" },
    "bundle_digest": { "$ref": "#/$defs/digest" },
    "component_set_digest": { "$ref": "#/$defs/digest" },
    "renderer_abi": { "$ref": "#/$defs/rendererAbi" },
    "pointer_digest": { "$ref": "#/$defs/digest" },
    "client_release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release_id", "release_digest"],
      "properties": {
        "release_id": { "$ref": "#/$defs/id" },
        "release_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "zones": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["zone_id", "provider", "artifact_base_url", "priority"],
        "properties": {
          "zone_id": { "$ref": "#/$defs/id" },
          "provider": { "enum": ["cloudflare", "regru", "firebase", "s3"] },
          "artifact_base_url": { "type": "string", "format": "uri", "pattern": "^https://.*/$", "maxLength": 512 },
          "priority": { "type": "integer", "minimum": 1, "maximum": 1000 },
          "region": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,80}$" }
        }
      }
    },
    "generation": { "type": "integer", "minimum": 1 },
    "published_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "descriptor_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest", "size_bytes", "media_type", "kind"],
      "properties": {
        "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$", "maxLength": 512 },
        "digest": { "$ref": "#/$defs/digest" },
        "size_bytes": { "type": "integer", "minimum": 0, "maximum": 1073741824 },
        "media_type": { "type": "string", "pattern": "^[a-z0-9.+-]+/[a-zA-Z0-9.+-]+$", "maxLength": 120 },
        "kind": { "enum": ["asset", "projection", "component_package", "component_release_set", "deployment"] }
      }
    },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "rendererAbi": { "type": "string", "pattern": "^adaos\\.public-renderer\\.v[1-9][0-9]*$" }
  }
}
