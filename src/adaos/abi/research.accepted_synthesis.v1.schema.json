{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaos.research.accepted_synthesis.v1",
  "title": "AdaOS Accepted Research Synthesis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "accepted_id",
    "synthesis_id",
    "synthesis_revision",
    "synthesis_digest",
    "accepted_components",
    "decision",
    "created_at",
    "digest"
  ],
  "properties": {
    "schema": {"const": "adaos.research.accepted_synthesis.v1"},
    "schema_version": {"const": "1.0.0"},
    "accepted_id": {"$ref": "#/$defs/id"},
    "synthesis_id": {"$ref": "#/$defs/id"},
    "synthesis_revision": {"type": "integer", "minimum": 1},
    "synthesis_digest": {"$ref": "#/$defs/digest"},
    "accepted_components": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_snapshot_digest",
        "literature_scope_digest",
        "concept_model_digest",
        "claim_set_digest",
        "argument_map_digest",
        "related_work_map_digest",
        "source_coverage_digest",
        "novelty_ledger_digest",
        "research_agenda_digest"
      ],
      "properties": {
        "source_snapshot_digest": {"$ref": "#/$defs/digest"},
        "literature_scope_digest": {"$ref": "#/$defs/digest"},
        "concept_model_digest": {"$ref": "#/$defs/digest"},
        "claim_set_digest": {"$ref": "#/$defs/digest"},
        "argument_map_digest": {"$ref": "#/$defs/digest"},
        "related_work_map_digest": {"$ref": "#/$defs/digest"},
        "source_coverage_digest": {"$ref": "#/$defs/digest"},
        "novelty_ledger_digest": {"$ref": "#/$defs/digest"},
        "threat_model_digest": {"$ref": "#/$defs/digest"},
        "research_agenda_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_id",
        "decision",
        "target_synthesis_digest",
        "accepted_by",
        "accepted_at",
        "scope",
        "phase_b_authorized",
        "research_release_created"
      ],
      "properties": {
        "decision_id": {"$ref": "#/$defs/id"},
        "decision": {"const": "accepted_research_synthesis"},
        "target_synthesis_digest": {"$ref": "#/$defs/digest"},
        "accepted_by": {"type": "string", "pattern": "^(human|operator|user):[A-Za-z0-9_.:@-]{1,199}$"},
        "accepted_at": {"type": "string", "minLength": 1, "maxLength": 80},
        "scope": {"const": "phase_a_independent_comparison"},
        "rationale": {"type": "string", "maxLength": 4000},
        "phase_b_authorized": {"const": false},
        "research_release_created": {"const": false}
      }
    },
    "created_at": {"type": "string", "minLength": 1, "maxLength": 80},
    "digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
