{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaos.research.inquiry_acceptance.v1",
  "title": "AdaOS Scientific Inquiry Projection Acceptance",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "acceptance_id", "inquiry_id", "projection_digest", "projection_revision", "decision", "accepted_by", "accepted_at", "rationale", "digest"],
  "properties": {
    "schema": {"const": "adaos.research.inquiry_acceptance.v1"},
    "schema_version": {"const": "1.0.0"},
    "acceptance_id": {"$ref": "#/$defs/id"},
    "inquiry_id": {"$ref": "#/$defs/id"},
    "projection_digest": {"$ref": "#/$defs/digest"},
    "projection_revision": {"type": "integer", "minimum": 0},
    "decision": {"enum": ["accept_for_research_task", "accept_for_engineering_task", "reuse_known_solution", "defer_intractable", "stop", "request_revision"]},
    "accepted_by": {"type": "string", "minLength": 1, "maxLength": 240},
    "accepted_at": {"type": "string", "minLength": 1, "maxLength": 80},
    "rationale": {"type": "string", "minLength": 1, "maxLength": 8000},
    "digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
