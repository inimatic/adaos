{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaos.research.source_discovery.v1",
  "title": "AdaOS Research Source Discovery Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "discovery_id",
    "inquiry_id",
    "projection_digest",
    "search_request_refs",
    "candidates",
    "search_notes",
    "producer",
    "usage",
    "created_at",
    "digest"
  ],
  "properties": {
    "schema": {"const": "adaos.research.source_discovery.v1"},
    "schema_version": {"const": "1.0.0"},
    "discovery_id": {"$ref": "#/$defs/id"},
    "inquiry_id": {"$ref": "#/$defs/id"},
    "projection_digest": {"$ref": "#/$defs/digest"},
    "search_request_refs": {
      "type": "array",
      "items": {"type": "string", "pattern": "^search-request:[A-Za-z0-9_.:-]+$"},
      "minItems": 1,
      "maxItems": 50,
      "uniqueItems": true
    },
    "candidates": {
      "type": "array",
      "maxItems": 30,
      "items": {"$ref": "#/$defs/candidate"}
    },
    "search_notes": {"type": "string", "maxLength": 8000},
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "model", "provider_job_id", "tool"],
      "properties": {
        "kind": {"const": "researcher_llm"},
        "model": {"type": "string", "minLength": 1, "maxLength": 200},
        "provider_job_id": {"type": "string", "minLength": 1, "maxLength": 300},
        "tool": {"const": "web_search"}
      }
    },
    "usage": {"$ref": "#/$defs/usage"},
    "created_at": {"type": "string", "minLength": 1, "maxLength": 80},
    "digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,299}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "title",
        "url",
        "source_type",
        "authors",
        "year",
        "identifiers",
        "open_access",
        "relevance",
        "supports_refs",
        "discovery_status",
        "warnings"
      ],
      "properties": {
        "candidate_id": {"$ref": "#/$defs/id"},
        "title": {"type": "string", "minLength": 1, "maxLength": 2000},
        "url": {"type": "string", "pattern": "^https?://", "maxLength": 4000},
        "source_type": {"enum": ["paper", "dataset", "standard", "software", "other"]},
        "authors": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 500}, "maxItems": 200},
        "year": {"type": ["integer", "null"], "minimum": 1000, "maximum": 3000},
        "identifiers": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "doi": {"type": ["string", "null"], "maxLength": 500},
            "arxiv": {"type": ["string", "null"], "maxLength": 200},
            "openalex": {"type": ["string", "null"], "maxLength": 500}
          }
        },
        "open_access": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "url", "license"],
          "properties": {
            "status": {"enum": ["claimed", "unknown"]},
            "url": {"type": ["string", "null"], "pattern": "^https?://", "maxLength": 4000},
            "license": {"type": ["string", "null"], "maxLength": 300}
          }
        },
        "relevance": {"type": "string", "minLength": 1, "maxLength": 4000},
        "supports_refs": {"type": "array", "items": {"type": "string", "pattern": "^search-request:[A-Za-z0-9_.:-]+$"}, "minItems": 1, "maxItems": 50, "uniqueItems": true},
        "discovery_status": {"const": "candidate_not_admitted"},
        "warnings": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 1000}, "maxItems": 30}
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accounting_scope", "input_tokens", "cached_input_tokens", "output_tokens", "reasoning_tokens", "total_tokens", "accuracy"],
      "properties": {
        "accounting_scope": {"const": "researcher_llm"},
        "input_tokens": {"type": "integer", "minimum": 0},
        "cached_input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "reasoning_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0},
        "accuracy": {"enum": ["provider_reported", "unavailable"]}
      }
    }
  }
}
