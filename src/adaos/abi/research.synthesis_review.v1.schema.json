{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaos.research.synthesis_review.v1",
  "title": "AdaOS Research Synthesis Review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "review_id",
    "target_synthesis_digest",
    "reviewer",
    "criteria",
    "findings",
    "verdict",
    "summary",
    "usage",
    "created_at",
    "digest"
  ],
  "properties": {
    "schema": {"const": "adaos.research.synthesis_review.v1"},
    "schema_version": {"const": "1.0.0"},
    "review_id": {"$ref": "#/$defs/id"},
    "target_synthesis_digest": {"$ref": "#/$defs/digest"},
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor", "model", "request_id"],
      "properties": {
        "actor": {"const": "llm"},
        "model": {"type": "string", "minLength": 1, "maxLength": 240},
        "request_id": {"type": "string", "minLength": 1, "maxLength": 240},
        "provider_job_id": {"type": "string", "minLength": 1, "maxLength": 240}
      }
    },
    "criteria": {
      "const": [
        "source_grounding",
        "conceptual_coherence",
        "nearest_neighbor_positioning",
        "novelty_calibration",
        "falsifiability",
        "phase_a_boundary",
        "threat_coverage",
        "draft_readiness"
      ]
    },
    "findings": {
      "type": "array",
      "items": {"$ref": "#/$defs/finding"},
      "maxItems": 500
    },
    "verdict": {"enum": ["acceptable_for_human_review", "revise", "reject"]},
    "summary": {"type": "string", "minLength": 1, "maxLength": 8000},
    "usage": {"$ref": "#/$defs/usage"},
    "created_at": {"type": "string", "minLength": 1, "maxLength": 80},
    "digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_id", "severity", "criterion", "target_refs", "message", "required_change"],
      "properties": {
        "finding_id": {"$ref": "#/$defs/id"},
        "severity": {"enum": ["blocking", "major", "minor", "note"]},
        "criterion": {
          "enum": [
            "source_grounding",
            "conceptual_coherence",
            "nearest_neighbor_positioning",
            "novelty_calibration",
            "falsifiability",
            "phase_a_boundary",
            "threat_coverage",
            "draft_readiness"
          ]
        },
        "target_refs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "maxLength": 2000},
          "maxItems": 100
        },
        "message": {"type": "string", "minLength": 1, "maxLength": 5000},
        "required_change": {"type": "string", "minLength": 1, "maxLength": 5000}
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accounting_scope",
        "input_tokens",
        "cached_input_tokens",
        "output_tokens",
        "reasoning_tokens",
        "total_tokens",
        "accuracy"
      ],
      "properties": {
        "accounting_scope": {"const": "researcher_llm"},
        "input_tokens": {"type": "integer", "minimum": 0},
        "cached_input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "reasoning_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0},
        "accuracy": {"enum": ["provider_reported", "unavailable"]}
      }
    }
  }
}
