{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adaos.dev/abi/resource.definition.v1.schema.json",
  "title": "AdaOS Resource Definition v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "resource_type",
    "version",
    "title",
    "authority",
    "record_schema_ref",
    "query",
    "operations",
    "views",
    "events",
    "i18n",
    "access",
    "privacy"
  ],
  "properties": {
    "schema": { "const": "adaos.resource.definition.v1" },
    "resource_type": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "authority": { "type": "object", "additionalProperties": true },
    "scope": { "type": "object", "additionalProperties": true },
    "record_schema_ref": { "type": "string", "minLength": 1 },
    "query": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "default": { "type": "string" },
        "filters": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "sort": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "cursor": { "type": "boolean" },
        "include": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "kind"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 },
          "label": { "type": "string" },
          "input_schema_ref": { "type": "string" },
          "output_schema_ref": { "type": "string" },
          "risk": { "enum": ["read", "low", "medium", "high", "destructive"] },
          "requires": { "type": "array", "items": { "type": "string" } },
          "required_capabilities": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "views": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "kind"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 },
          "title": { "type": "string" }
        }
      }
    },
    "events": { "type": "object", "additionalProperties": true },
    "i18n": { "type": "object", "additionalProperties": true },
    "access": { "type": "object", "additionalProperties": true },
    "privacy": { "type": "object", "additionalProperties": true },
    "readiness": { "type": "object", "additionalProperties": true },
    "workflow_links": { "type": "object", "additionalProperties": true },
    "metadata": { "type": "object", "additionalProperties": true }
  }
}
