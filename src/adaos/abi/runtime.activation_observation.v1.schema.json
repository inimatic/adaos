{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adaos.dev/abi/runtime.activation_observation.v1.schema.json",
  "title": "AdaOS Runtime Activation Observation v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "status",
    "component_type",
    "component_id",
    "failed_stage",
    "error",
    "source",
    "report_policy",
    "space"
  ],
  "properties": {
    "schema": { "const": "adaos.runtime.activation_observation.v1" },
    "status": { "const": "failed" },
    "component_type": { "enum": ["skill", "scenario"] },
    "component_id": { "type": "string", "minLength": 1 },
    "skill_id": { "type": ["string", "null"] },
    "scenario_id": { "type": ["string", "null"] },
    "failed_stage": { "type": "string", "minLength": 1 },
    "error": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "report_policy": { "enum": ["project_inbox", "diagnostic_only"] },
    "space": { "type": "string", "minLength": 1 },
    "webspace_id": { "type": ["string", "null"] },
    "attempted_version": { "type": ["string", "null"] },
    "slot": { "type": ["string", "null"] },
    "operation_id": { "type": ["string", "null"] }
  }
}
