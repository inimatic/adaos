{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inimatic.com/abi/site.v1.schema.json",
  "title": "AdaOS Semantic Public Site v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "profile", "id", "revision", "locale", "identity", "theme", "assets", "resources", "routes"],
  "properties": {
    "$schema": { "const": "adaos.site.v1" },
    "profile": { "const": "public_site" },
    "id": { "$ref": "#/$defs/id" },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "created_at", "prompt_packet_ref"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "created_at": { "type": "string", "format": "date-time" },
        "prompt_packet_ref": { "$ref": "#/$defs/relativeRef" },
        "base_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "locale": { "type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$" },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "canonical_origin"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "category": { "type": "string", "maxLength": 240 },
        "favicon_asset_ref": { "$ref": "#/$defs/id" },
        "canonical_origin": { "type": "string", "format": "uri", "pattern": "^https://" }
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tokens"],
      "properties": {
        "tokens": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z][A-Za-z0-9.]{1,63}$" },
          "additionalProperties": { "type": ["string", "number", "boolean"] }
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source_path", "public_path", "media_type"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "source_path": { "$ref": "#/$defs/relativeRef" },
          "public_path": { "$ref": "#/$defs/relativeRef" },
          "media_type": { "type": "string", "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$" },
          "alt": { "type": "string", "maxLength": 1000 },
          "provenance": { "type": "string", "maxLength": 2000 },
          "rights": { "type": "string", "maxLength": 2000 },
          "digest": { "$ref": "#/$defs/digest" }
        }
      }
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "public", "data"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "type": { "type": "string", "pattern": "^site\\.[A-Za-z][A-Za-z0-9_.-]{0,95}$" },
          "version": { "type": "string", "pattern": "^v[1-9][0-9]*$" },
          "public": { "type": "boolean" },
          "data": { "type": ["object", "array"] }
        }
      }
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/route" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "relativeRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "not": { "pattern": "^(?:[A-Za-z][A-Za-z0-9+.-]*:|/)" }
    },
    "path": { "type": "string", "pattern": "^/(?:[A-Za-z0-9_-]+/?)*$", "maxLength": 2048 },
    "linkMetadata": {
      "type": "object",
      "additionalProperties": { "type": "string", "maxLength": 2000 }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "canonical_url", "metadata", "json_ld", "sections"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "path": { "$ref": "#/$defs/path" },
        "canonical_url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "description", "robots", "open_graph", "twitter"],
          "properties": {
            "title": { "type": "string", "minLength": 1, "maxLength": 240 },
            "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
            "robots": { "type": "string", "minLength": 1, "maxLength": 160 },
            "theme_color": { "type": "string", "pattern": "^#[a-fA-F0-9]{6}$" },
            "open_graph": { "$ref": "#/$defs/linkMetadata" },
            "twitter": { "$ref": "#/$defs/linkMetadata" }
          }
        },
        "json_ld": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "object" }
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "component", "resource_ref"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "component": { "type": "string", "pattern": "^site\\.[A-Za-z][A-Za-z0-9.]{0,95}$" },
              "resource_ref": { "$ref": "#/$defs/id" },
              "anchor_id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$" }
            }
          }
        }
      }
    }
  }
}
