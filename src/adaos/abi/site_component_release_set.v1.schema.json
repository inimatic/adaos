{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inimatic.com/abi/site_component_release_set.v1.schema.json",
  "title": "AdaOS Public Site Component Release Set v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "set_id", "set_digest", "channel", "renderer_abi", "status", "packages", "qualified_at", "qualification_digest"],
  "properties": {
    "schema": { "const": "adaos.site_component_release_set.v1" },
    "set_id": { "type": "string", "pattern": "^site-set-[A-Za-z0-9_.-]{1,120}$" },
    "set_digest": { "$ref": "#/$defs/digest" },
    "channel": { "enum": ["dev2027", "main"] },
    "renderer_abi": { "$ref": "#/$defs/rendererAbi" },
    "status": { "enum": ["candidate", "recommended", "supported", "deprecated", "migration_required", "eol", "revoked"] },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["family", "package_id", "version", "digest", "artifact_ref"],
        "properties": {
          "family": { "type": "string", "pattern": "^site\\.[a-z][a-z0-9.-]{0,63}$" },
          "package_id": { "type": "string", "minLength": 1, "maxLength": 160 },
          "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
          "digest": { "$ref": "#/$defs/digest" },
          "artifact_ref": { "$ref": "#/$defs/ref" }
        }
      }
    },
    "qualified_at": { "type": "string", "format": "date-time" },
    "qualification_digest": { "$ref": "#/$defs/digest" },
    "predecessor_set_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "rendererAbi": { "type": "string", "pattern": "^adaos\\.public-renderer\\.v[1-9][0-9]*$" },
    "ref": { "type": "string", "minLength": 1, "maxLength": 2048, "not": { "pattern": "^javascript:" } }
  }
}
