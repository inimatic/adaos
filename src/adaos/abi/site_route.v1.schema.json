{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inimatic.com/abi/site_route.v1.schema.json",
  "title": "AdaOS Public Site Route Artifact v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "site_id", "route_id", "path", "locale", "canonical_url", "source_digest", "head", "json_ld", "visible_content", "runtime_graph_ref", "public_resource_refs", "source_map_ref"],
  "properties": {
    "schema": { "const": "adaos.site_route.v1" },
    "site_id": { "$ref": "#/$defs/id" },
    "route_id": { "$ref": "#/$defs/id" },
    "path": { "$ref": "#/$defs/path" },
    "locale": { "type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$" },
    "canonical_url": { "type": "string", "format": "uri", "pattern": "^https://" },
    "source_digest": { "$ref": "#/$defs/digest" },
    "head": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "robots", "open_graph", "twitter"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 240 },
        "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "robots": { "type": "string", "minLength": 1, "maxLength": 160 },
        "theme_color": { "type": "string", "pattern": "^#[a-fA-F0-9]{6}$" },
        "open_graph": { "$ref": "#/$defs/stringMap" },
        "twitter": { "$ref": "#/$defs/stringMap" }
      }
    },
    "json_ld": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "visible_content": { "type": "array", "items": { "type": "string" } },
    "runtime_graph_ref": { "$ref": "#/$defs/ref" },
    "public_resource_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "ref"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "ref": { "$ref": "#/$defs/ref" }
        }
      }
    },
    "source_map_ref": { "$ref": "#/$defs/ref" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "path": { "type": "string", "pattern": "^/(?:[A-Za-z0-9_-]+/?)*$", "maxLength": 2048 },
    "ref": { "type": "string", "minLength": 1, "maxLength": 2048, "not": { "pattern": "^(?:[A-Za-z][A-Za-z0-9+.-]*:|/)" } },
    "stringMap": { "type": "object", "additionalProperties": { "type": "string", "maxLength": 2000 } }
  }
}
