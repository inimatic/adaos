{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaos.skill_factory.dev_ready_event.v1",
  "title": "AdaOS Skill Factory Dev Ready Event",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema", "event_id", "task_id", "target", "forge", "result", "next_action"],
  "properties": {
    "schema": { "const": "adaos.skill_factory.dev_ready_event.v1" },
    "event_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "subnet_id": { "type": ["string", "null"] },
    "target": { "type": "object", "additionalProperties": true },
    "forge": { "type": "object", "additionalProperties": true },
    "result": { "type": "object", "additionalProperties": true },
    "next_action": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
