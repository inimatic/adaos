{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaos.skill_factory.dev_result.v1",
  "title": "AdaOS Skill Factory Dev Result",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema", "task_id", "status", "commit_hash", "branch", "changed_paths", "provenance"],
  "properties": {
    "schema": { "const": "adaos.skill_factory.dev_result.v1" },
    "task_id": { "type": "string", "minLength": 1 },
    "node_id": { "type": ["string", "null"] },
    "status": { "type": "string", "enum": ["completed"] },
    "commit_hash": { "type": "string", "minLength": 1 },
    "branch": { "type": "string", "minLength": 1 },
    "changed_paths": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "tests": { "type": "object", "additionalProperties": true },
    "validation": { "type": "object", "additionalProperties": true },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "schema": { "const": "adaos.skill_factory.task_provenance.v1" },
        "task_id": { "type": "string", "minLength": 1 },
        "dev_node_id": { "type": ["string", "null"] },
        "runner_version": { "type": "string" },
        "image_digest": { "type": ["string", "null"] },
        "instruction_packet_hash": { "type": ["string", "null"] },
        "dependency_changes": {
          "type": "array",
          "items": { "type": "object", "additionalProperties": true }
        },
        "snapshot_refs": {
          "type": "array",
          "items": { "type": "object", "additionalProperties": true }
        },
        "reported_at": { "type": "string", "format": "date-time" }
      }
    },
    "dependency_delta": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "changed": { "type": "boolean" },
        "files": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "changes": {
          "type": "array",
          "items": { "type": "object", "additionalProperties": true }
        },
        "review_required": { "type": "boolean" }
      }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "open_questions": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
