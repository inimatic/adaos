{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaos.skill_factory.dev_task_assignment.v1",
  "title": "AdaOS Skill Factory Dev Task Assignment",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema", "task_id", "target", "forge", "mcp", "codex", "policy"],
  "properties": {
    "schema": { "const": "adaos.skill_factory.dev_task_assignment.v1" },
    "task_id": { "type": "string", "minLength": 1 },
    "request_id": { "type": "string" },
    "subnet_id": { "type": ["string", "null"] },
    "target": { "$ref": "#/$defs/targetRef" },
    "forge": {
      "type": "object",
      "additionalProperties": true,
      "required": ["base_branch", "branch", "sparse_paths"],
      "properties": {
        "repo_url": { "type": ["string", "null"] },
        "forge_project": { "type": "string" },
        "base_branch": { "type": "string", "minLength": 1 },
        "branch": { "type": "string", "minLength": 1 },
        "branch_creator": { "type": "string", "enum": ["dev_node", "root"] },
        "sparse_paths": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        }
      }
    },
    "mcp": {
      "type": "object",
      "additionalProperties": true,
      "required": ["endpoint", "token_ref", "scope"],
      "properties": {
        "endpoint": { "type": "string", "minLength": 1 },
        "token_ref": { "type": "string", "minLength": 1 },
        "scope": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "codex": {
      "type": "object",
      "additionalProperties": true,
      "required": ["instruction_file", "working_dir", "mode"],
      "properties": {
        "instruction_file": { "type": "string", "minLength": 1 },
        "working_dir": { "type": "string", "minLength": 1 },
        "mode": { "type": "string" }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "network": { "type": "string" },
        "secrets_visible_to_llm": { "type": "boolean" },
        "require_tests": { "type": "boolean" },
        "require_commit": { "type": "boolean" },
        "cleanup_after_completion": { "type": "boolean" },
        "allowed_result_paths": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "realization": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "schema": { "const": "adaos.skill_factory.realization_policy.v1" },
            "classification": { "type": "string", "enum": ["allowed", "manual_only", "disallowed"] },
            "manual_approval_required": { "type": "boolean" },
            "disallowed": { "type": "boolean" },
            "risk_classes": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "reasons": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "snapshot_context": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "schema": { "const": "adaos.skill_factory.task_context.v1" },
        "generated_at": { "type": "string", "format": "date-time" },
        "freshness": { "type": "object", "additionalProperties": true },
        "redaction": { "type": "object", "additionalProperties": true },
        "privacy": { "type": "object", "additionalProperties": true },
        "provenance": {
          "type": "array",
          "items": { "type": "object", "additionalProperties": true }
        },
        "mock_data": { "type": "object", "additionalProperties": true },
        "byte_budget": { "type": "integer", "minimum": 1 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "schema": { "const": "adaos.skill_factory.task_evidence.v1" },
        "expected_paths": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "provenance_required": { "type": "boolean" },
        "dependency_delta_review": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "targetRef": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "id"],
      "properties": {
        "type": { "type": "string" },
        "id": { "type": "string", "minLength": 1 }
      }
    }
  }
}
