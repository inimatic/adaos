{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaos.storage.relational.binding.v1",
  "title": "AdaOS Relational Storage Binding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "capability",
    "binding_id",
    "provider_id",
    "owner_ref",
    "logical_name",
    "isolation",
    "locator",
    "migration_owner",
    "protocol_version",
    "capabilities",
    "secret_ref",
    "requirements"
  ],
  "properties": {
    "schema": { "const": "adaos.storage.relational.binding.v1" },
    "capability": { "const": "storage.relational" },
    "binding_id": { "type": "string", "minLength": 1 },
    "provider_id": { "type": "string", "minLength": 1 },
    "owner_ref": { "type": "string", "pattern": "^(skill|service|core):[a-z0-9_.-]+$" },
    "logical_name": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,62}$" },
    "isolation": { "enum": ["file", "database", "schema"] },
    "locator": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]*:[a-z0-9_./-]+$"
    },
    "migration_owner": { "type": "string", "pattern": "^(skill|service|core):[a-z0-9_.-]+$" },
    "protocol_version": { "const": "1.0" },
    "capabilities": { "type": "object" },
    "secret_ref": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*:[a-z0-9_./-]+$"
        }
      ]
    },
    "requirements": { "$ref": "storage.relational_requirement.v1.schema.json" }
  }
}
