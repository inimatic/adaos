{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaos.telegram.delivery_receipt.v1",
  "type": "object",
  "required": [
    "schema", "receipt_id", "delivery_attempt_id", "operation_key",
    "delivered", "transport", "external_message_ids", "completed_at"
  ],
  "properties": {
    "schema": {"const": "adaos.telegram.delivery_receipt.v1"},
    "receipt_id": {"type": "string", "minLength": 1, "maxLength": 240},
    "delivery_attempt_id": {"type": "string", "minLength": 1, "maxLength": 240},
    "operation_key": {"type": "string", "minLength": 1, "maxLength": 1000},
    "delivered": {"type": "boolean"},
    "transport": {"type": "string", "minLength": 1, "maxLength": 120},
    "external_message_ids": {
      "type": "array", "maxItems": 100,
      "items": {"type": "string", "maxLength": 240}
    },
    "duplicate_suppressed": {"type": "integer", "minimum": 0},
    "error": {"type": ["string", "null"], "maxLength": 4000},
    "completed_at": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
