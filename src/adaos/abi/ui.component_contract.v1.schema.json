{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "adaos.ui.component_contract.v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "contract_id", "version", "owner", "projection_version", "applicability", "semantic_schema", "state_ownership", "field_types", "input_shapes", "shape_refs", "realizations", "components", "mappings", "constraints", "fixtures", "obligations", "discovery_policy"],
  "properties": {
    "schema": {"const": "adaos.ui.component_contract.v1"}, "contract_id": {"type": "string", "minLength": 1}, "owner": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}, "projection_version": {"type": "string", "minLength": 1}, "semantic_schema": {"const": "adaos.webui.semantic.v2"},
    "applicability": {"type": "object", "additionalProperties": false, "required": ["stage", "mode", "environment"], "properties": {"stage": {"const": "prototype"}, "mode": {"const": "local_reversible"}, "environment": {"const": "web"}}},
    "state_ownership": {"type": "object", "additionalProperties": {"type": "string"}}, "field_types": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}},
    "realizations": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["owner", "implementation", "effects", "authority"], "properties": {"owner": {"type": "string"}, "implementation": {"type": "string"}, "effects": {"$ref": "#/$defs/strings"}, "authority": {"type": "string"}}}},
    "input_shapes": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "object"}},
    "shape_refs": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": {"type": "string"}}},
    "components": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "role", "implementation", "module", "properties", "events", "effects", "required_inputs", "dependencies", "loading"], "properties": {
      "id": {"type": "string", "minLength": 1}, "role": {"type": "string", "minLength": 1}, "implementation": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*Component$"}, "module": {"type": "string", "pattern": "^\\.\\./renderer/widgets/[a-z0-9.-]+$"}, "properties": {"type": "object", "additionalProperties": {"enum": ["array", "boolean", "string", "number"]}}, "events": {"$ref": "#/$defs/strings"}, "effects": {"$ref": "#/$defs/strings"}, "required_inputs": {"$ref": "#/$defs/strings"}, "dependencies": {"$ref": "#/$defs/strings"}, "loading": {"const": "common"}}}},
    "mappings": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "relation", "source_roles", "condition", "required", "alternatives", "obligations"], "properties": {"id": {"type": "string"}, "relation": {"enum": ["projection", "refinement", "alternative"]}, "source_roles": {"$ref": "#/$defs/strings"}, "condition": {"type": "string"}, "required": {"$ref": "#/$defs/strings"}, "alternatives": {"$ref": "#/$defs/strings"}, "obligations": {"$ref": "#/$defs/strings"}}}},
    "constraints": {"type": "object", "additionalProperties": false, "required": ["i18n", "responsive", "external_effects", "mutation_authority", "confirmation", "risk"], "properties": {"i18n": {"$ref": "#/$defs/strings"}, "responsive": {"$ref": "#/$defs/strings"}, "external_effects": {"const": "unsupported"}, "mutation_authority": {"const": "active_preview"}, "confirmation": {"const": "declared_or_legacy_safety_default"}, "risk": {"const": "local_reversible"}}},
    "fixtures": {"$ref": "#/$defs/strings"}, "obligations": {"$ref": "#/$defs/strings"}, "discovery_policy": {"type": "object", "additionalProperties": false, "required": ["inline", "known_locator", "unknown_identity", "unavailable"], "properties": {"inline": {"type": "string"}, "known_locator": {"type": "string"}, "unknown_identity": {"type": "string"}, "unavailable": {"type": "string"}}}
  }, "$defs": {"strings": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}
}
