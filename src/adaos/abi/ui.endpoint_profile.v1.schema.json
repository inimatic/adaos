{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaos.ui.endpoint_profile.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "profile_id", "version", "stage", "source_abi", "projection_abi", "layout", "bindings", "components", "limits"],
  "properties": {
    "schema": {"const": "adaos.ui.endpoint_profile.v1"},
    "profile_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "stage": {"const": "experimental"},
    "source_abi": {"const": "adaos.webui.v1"},
    "projection_abi": {"const": "adaos.ui.endpoint_projection.v1"},
    "layout": {"const": "stack"},
    "bindings": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "visibility", "icons"],
      "properties": {
        "state": {"const": "exact_state_path"},
        "visibility": {"const": "state_literal_equality"},
        "icons": {"const": "decorative_with_required_text"}
      }
    },
    "components": {
      "type": "object", "additionalProperties": false, "required": ["ui.actions"],
      "properties": {
        "ui.actions": {
          "type": "object", "additionalProperties": false,
          "required": ["source_ref", "widget_fields", "input_fields", "button_fields", "action_fields", "action_types"],
          "properties": {
            "source_ref": {"const": "adaos.webui.v1#/$defs/widgetConfig"},
            "widget_fields": {"$ref": "#/$defs/strings"},
            "input_fields": {"$ref": "#/$defs/strings"},
            "button_fields": {"$ref": "#/$defs/strings"},
            "action_fields": {"$ref": "#/$defs/strings"},
            "action_types": {"type": "array", "const": ["callSkill"]}
          }
        }
      }
    },
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["max_widgets", "max_buttons_per_widget", "max_label_chars", "max_payload_bytes", "max_state_bytes", "max_source_bytes", "max_depth", "max_action_bytes", "max_ttl_seconds"],
      "properties": {
        "max_widgets": {"$ref": "#/$defs/positive"},
        "max_buttons_per_widget": {"$ref": "#/$defs/positive"},
        "max_label_chars": {"$ref": "#/$defs/positive"},
        "max_payload_bytes": {"$ref": "#/$defs/positive"},
        "max_state_bytes": {"$ref": "#/$defs/positive"},
        "max_source_bytes": {"$ref": "#/$defs/positive"},
        "max_depth": {"$ref": "#/$defs/positive"},
        "max_action_bytes": {"$ref": "#/$defs/positive"},
        "max_ttl_seconds": {"$ref": "#/$defs/positive"}
      }
    }
  },
  "$defs": {
    "strings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "positive": {"type": "integer", "minimum": 1}
  }
}
