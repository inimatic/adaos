{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaos.ui.endpoint_projection.v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "profile", "source", "scope", "layout", "widgets"],
  "properties": {
    "schema": {"const": "adaos.ui.endpoint_projection.v1"},
    "profile": {
      "type": "object", "additionalProperties": false,
      "required": ["profile_id", "version", "digest"],
      "properties": {
        "profile_id": {"$ref": "#/$defs/id"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "digest", "page_id", "widget_ids"],
      "properties": {
        "schema": {"const": "adaos.webui.v1"}, "digest": {"$ref": "#/$defs/digest"},
        "page_id": {"$ref": "#/$defs/id"},
        "widget_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    },
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["endpoint_id", "surface_id", "state_revision", "generation", "expires_at"],
      "properties": {
        "endpoint_id": {"$ref": "#/$defs/id"}, "surface_id": {"$ref": "#/$defs/id"},
        "state_revision": {"$ref": "#/$defs/id"}, "generation": {"type": "integer", "minimum": 1},
        "expires_at": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "layout": {"const": "stack"},
    "widgets": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "type", "title", "inputs"],
        "properties": {
          "id": {"$ref": "#/$defs/id"}, "type": {"const": "ui.actions"}, "title": {"type": "string", "minLength": 1},
          "inputs": {
            "type": "object", "additionalProperties": false,
            "required": ["variant", "size", "stretch", "buttons"],
            "properties": {
              "variant": {"enum": ["toolbar", "row", "stack"]}, "size": {"enum": ["small", "medium", "large"]},
              "stretch": {"type": "boolean"},
              "buttons": {
                "type": "array",
                "items": {
                  "type": "object", "additionalProperties": false,
                  "required": ["id", "label", "disabled", "action_ref", "icon", "kind"],
                  "properties": {
                    "id": {"$ref": "#/$defs/id"}, "label": {"type": "string", "minLength": 1},
                    "disabled": {"type": "boolean"}, "action_ref": {"type": "string", "minLength": 1, "maxLength": 257},
                    "icon": {"type": "string", "maxLength": 128}, "kind": {"enum": ["default", "primary", "secondary", "danger"]}
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
