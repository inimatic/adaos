{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaos.ui.task_progress.v1",
  "title": "Authoritative task progress",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "status"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 0},
    "status": {"enum": ["queued", "running", "input_required", "cancelling", "completed", "failed", "cancelled", "unknown"]},
    "label": {"type": "string"},
    "message": {"type": "string"},
    "error": {"type": "string"},
    "stage_id": {"type": "string"},
    "started_at": {"type": "string"},
    "updated_at": {"type": "string"},
    "can_cancel": {"type": "boolean"},
    "progress": {
      "type": "object", "additionalProperties": false, "required": ["completed", "total"],
      "properties": {"completed": {"type": "number", "minimum": 0}, "total": {"type": "number", "exclusiveMinimum": 0}, "unit": {"type": "string"}}
    },
    "stages": {
      "type": "array", "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "label", "status"],
        "properties": {
          "id": {"type": "string", "minLength": 1}, "label": {"type": "string"},
          "status": {"enum": ["pending", "running", "completed", "failed", "cancelled", "skipped"]}
        }
      }
    }
  },
  "$comment": "Owners additionally enforce completed<=total and unique stage IDs. Renderer never derives progress or completion from elapsed time."
}
