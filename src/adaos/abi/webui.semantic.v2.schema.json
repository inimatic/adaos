{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaos.webui.semantic.v2",
  "title": "AdaOS Builder multi-resource semantic Prototype document",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "document_id",
    "brief_ref",
    "brief_digest",
    "title",
    "layout",
    "resources",
    "relationships",
    "views",
    "commands",
    "representative_states",
    "requirement_bindings",
    "capability_gaps"
  ],
  "properties": {
    "schema": { "const": "adaos.webui.semantic.v2" },
    "document_id": { "$ref": "#/$defs/id" },
    "brief_ref": { "type": "string", "pattern": "^brief:[a-f0-9]{24}$" },
    "brief_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "title": { "$ref": "#/$defs/localizedText" },
    "layout": { "$ref": "#/$defs/layout" },
    "resources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/resource" }
    },
    "relationships": {
      "type": "array",
      "maxItems": 16,
      "items": { "$ref": "#/$defs/relationship" }
    },
    "views": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "$ref": "#/$defs/view" }
    },
    "capability_surfaces": {
      "type": "array",
      "maxItems": 8,
      "items": { "$ref": "#/$defs/capabilitySurface" }
    },
    "commands": {
      "type": "array",
      "maxItems": 24,
      "items": { "$ref": "#/$defs/command" }
    },
    "representative_states": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "view_ref", "proof", "filters", "min_items"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "label": { "$ref": "#/$defs/localizedText" },
          "view_ref": { "$ref": "#/$defs/id" },
          "proof": { "$ref": "#/$defs/stateProof" },
          "filters": {
            "type": "array",
            "items": { "$ref": "#/$defs/statePredicate" }
          },
          "min_items": { "type": "integer", "minimum": 0 },
          "max_items": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "requirement_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirement_ref", "semantic_refs"],
        "properties": {
          "requirement_ref": { "type": "string", "minLength": 1 },
          "semantic_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(resource|relationship|field|view|query|surface|command|state):[A-Za-z0-9_.:-]+$"
            }
          }
        }
      }
    },
    "automation_requirements": {
      "type": "array", "maxItems": 32,
      "items": { "$ref": "#/$defs/automationRequirement" }
    },
    "capability_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirement_ref", "code", "detail"],
        "properties": {
          "requirement_ref": { "type": "string", "minLength": 1 },
          "code": { "type": "string", "minLength": 1 },
          "detail": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "automationRequirement": {
      "type": "object", "additionalProperties": false,
      "required": ["requirement_ref", "reason", "disclosure", "acceptance"],
      "properties": {
        "requirement_ref": { "type": "string", "minLength": 1 },
        "reason": { "enum": ["business_rule", "external_integration"] },
        "statement": { "type": "string", "minLength": 1 },
        "disclosure": {
          "type": "object", "additionalProperties": false,
          "anyOf": [{ "required": ["en"] }, { "required": ["ru"] }],
          "properties": {
            "en": { "type": "string", "minLength": 1, "maxLength": 500 },
            "ru": { "type": "string", "minLength": 1, "maxLength": 500 }
          }
        },
        "acceptance": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    },
    "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$" },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pattern"],
      "properties": {
        "pattern": { "enum": ["flow", "split", "grid", "focus_detail", "workbench"] },
        "density": { "enum": ["compact", "comfortable"] },
        "content_width": { "enum": ["fluid", "reading", "wide"] },
        "scroll": { "enum": ["page", "regions"] },
        "regions": {
          "type": "array", "minItems": 1, "maxItems": 8,
          "items": { "$ref": "#/$defs/layoutRegion" }
        }
      }
    },
    "layoutRegion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "priority", "scroll", "wide", "compact", "min_px", "preferred_px", "max_px", "grow"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "role": { "enum": ["navigation", "toolbar", "collection", "main", "detail", "inspector", "utility", "status", "commands"] },
        "priority": { "type": "integer", "minimum": 0, "maximum": 100 },
        "scroll": { "enum": ["page", "region", "none"] },
        "wide": { "enum": ["pane", "stack"] },
        "compact": { "enum": ["stack", "drawer", "sheet", "hidden", "overflow", "route"] },
        "min_px": { "type": ["integer", "null"], "minimum": 160, "maximum": 1600 },
        "preferred_px": { "type": ["integer", "null"], "minimum": 160, "maximum": 1600 },
        "max_px": { "type": ["integer", "null"], "minimum": 160, "maximum": 2400 },
        "grow": { "type": "number", "minimum": 0, "maximum": 10 }
      }
    },
    "capabilitySurface": {
      "$ref": "#/$defs/sitePreviewSurface"
    },
    "sitePreviewSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "capability_ref", "region_role", "title", "site_id", "route", "min_height_px"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "capability_ref": { "type": "string", "const": "visual.sitePreview" },
        "region_role": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/localizedText" },
        "site_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
        "route": { "type": "string", "pattern": "^/(?:[A-Za-z0-9._~-]+/?)*$", "maxLength": 256 },
        "min_height_px": { "type": "integer", "minimum": 320, "maximum": 1200 }
      }
    },
    "localizedText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key"],
      "anyOf": [{ "required": ["en"] }, { "required": ["ru"] }],
      "properties": {
        "key": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$" },
        "en": { "type": "string", "minLength": 1, "maxLength": 500 },
        "ru": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "identity_field_refs", "item_semantics", "item_label", "fields", "records"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "identity_field_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "item_semantics": { "type": "string", "minLength": 1, "maxLength": 500 },
        "item_label": { "$ref": "#/$defs/localizedText" },
        "read_only_when": { "$ref": "#/$defs/condition" },
        "fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 40,
          "items": { "$ref": "#/$defs/field" }
        },
        "records": {
          "type": "array",
          "maxItems": 100,
          "items": { "type": "object" }
        }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from_resource_ref", "from_field_ref", "to_resource_ref", "to_field_ref", "cardinality"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "from_resource_ref": { "$ref": "#/$defs/id" },
        "from_field_ref": { "$ref": "#/$defs/id" },
        "to_resource_ref": { "$ref": "#/$defs/id" },
        "to_field_ref": { "$ref": "#/$defs/id" },
        "label_field_refs": { "type": "array", "maxItems": 3, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "cardinality": { "enum": ["one_to_one", "one_to_many", "many_to_one", "many_to_many"] }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "label"],
      "properties": {
        "value": { "type": ["string", "number", "boolean"] },
        "label": { "$ref": "#/$defs/localizedText" }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_ref", "operator"],
      "properties": {
        "field_ref": { "$ref": "#/$defs/id" },
        "operator": { "enum": ["equals", "not_equals", "nonempty", "empty"] },
        "value": { "type": ["string", "number", "boolean", "null"] }
      }
    },
    "statePredicate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_ref", "operator"],
      "oneOf": [
        {
          "required": ["value"],
          "not": { "required": ["compare_field_ref"] }
        },
        {
          "required": ["compare_field_ref"],
          "not": { "required": ["value"] }
        }
      ],
      "properties": {
        "field_ref": { "$ref": "#/$defs/id" },
        "operator": { "enum": ["eq", "neq", "lt", "lte", "gt", "gte"] },
        "value": { "type": ["string", "number", "boolean", "null"] },
        "compare_field_ref": { "$ref": "#/$defs/id" }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "value_type", "required", "editable"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "$ref": "#/$defs/localizedText" },
        "help_text": { "$ref": "#/$defs/localizedText" },
        "placeholder": { "$ref": "#/$defs/localizedText" },
        "value_type": {
          "enum": ["short_text", "long_text", "number", "date", "boolean", "choice", "multi_choice", "attachment"]
        },
        "required": { "type": "boolean" },
        "editable": { "type": "boolean" },
        "multiple": { "type": "boolean" },
        "max_items": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "items": { "$ref": "#/$defs/option" }
        },
        "visible_when": { "$ref": "#/$defs/condition" },
        "display_format": { "enum": ["markdown"] }
      }
    },
    "emptyState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "properties": {
        "title": { "$ref": "#/$defs/localizedText" },
        "detail": { "$ref": "#/$defs/localizedText" }
      }
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "resource_ref", "role", "region_role", "title", "field_refs"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "resource_ref": { "$ref": "#/$defs/id" },
        "role": { "enum": ["collection", "details", "editor"] },
        "media": { "anyOf": [{ "$ref": "#/$defs/media" }, { "type": "null" }] },
        "region_role": { "$ref": "#/$defs/id" },
        "surface": { "enum": ["inline", "modal", "side_sheet"] },
        "presentation": { "enum": ["list", "table", "cards", "board", "tree", "chart", "accordion"] },
        "compact_presentation": {
          "anyOf": [{ "type": "string", "enum": ["cards"] }, { "type": "null" }],
          "description": "Optional compact-screen override for a table collection."
        },
        "presentation_options": { "anyOf": [{ "$ref": "#/$defs/presentationOptions" }, { "type": "null" }] },
        "section": { "anyOf": [{ "$ref": "#/$defs/viewSection" }, { "type": "null" }] },
        "field_display": { "type": "array", "maxItems": 24, "items": { "$ref": "#/$defs/fieldDisplay" } },
        "scope_filters": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/scopeFilter" } },
        "selection": { "anyOf": [{ "$ref": "#/$defs/selectionPolicy" }, { "type": "null" }] },
        "initial_selection_id": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "selection_filter": { "anyOf": [{ "$ref": "#/$defs/selectionFilter" }, { "type": "null" }] },
        "activation_source_view_ref": {
          "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }],
          "description": "Details-only link to the collection whose row activation reveals this projection. Null for collections/editors and for details that are not activated from a collection row."
        },
        "title": { "$ref": "#/$defs/localizedText" },
        "field_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "filter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["field_ref", "state_ref"],
          "properties": {
            "field_ref": { "$ref": "#/$defs/id" },
            "state_ref": { "$ref": "#/$defs/id" }
          }
        },
        "query_controls": {
          "type": "array",
          "maxItems": 6,
          "items": { "$ref": "#/$defs/queryControl" }
        },
        "empty_state": { "$ref": "#/$defs/emptyState" }
      },
      "allOf": [
        {
          "if": { "properties": { "role": { "const": "collection" } } },
          "then": { "required": ["presentation"] },
          "else": { "not": { "required": ["presentation"] } }
        }
      ]
    },
    "selectionFilter": {
      "type": "object", "additionalProperties": false,
      "required": ["field_ref", "source_view_ref", "effect", "empty_selection"],
      "properties": {
        "field_ref": { "$ref": "#/$defs/id" },
        "source_view_ref": { "$ref": "#/$defs/id" },
        "source_field_ref": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "effect": { "enum": ["filter", "emphasize"] },
        "empty_selection": { "type": "string", "const": "show_all" }
      }
    },
    "selectionPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "indicator", "row_activation"],
      "properties": {
        "mode": { "enum": ["none", "single"] },
        "indicator": { "enum": ["none", "radio", "row_accent"] },
        "row_activation": { "enum": ["none", "select", "open_details"] }
      }
    },
    "queryControl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "label"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["search", "filter"] },
        "label": { "$ref": "#/$defs/localizedText" },
        "field_ref": { "$ref": "#/$defs/id" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "filter" } } },
          "then": { "required": ["field_ref"] }
        }
      ]
    },
    "stateProof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "visible_field_refs"],
      "properties": {
        "kind": { "enum": ["collection_empty", "collection_items", "field_predicate", "query_empty"] },
        "visible_field_refs": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    },
    "scopeFilter": {
      "type": "object", "additionalProperties": false, "required": ["field_ref", "value"],
      "properties": { "field_ref": { "$ref": "#/$defs/id" }, "value": { "type": ["string", "number", "boolean"] } }
    },
    "viewSection": {
      "type": "object", "additionalProperties": false, "required": ["id", "title", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "title": { "$ref": "#/$defs/localizedText" },
        "kind": { "enum": ["tab", "settings"] }
      }
    },
    "presentationOptions": {
      "type": "object", "additionalProperties": false,
      "required": ["group_field_ref", "parent_field_ref", "value_field_ref", "draggable"],
      "properties": {
        "group_field_ref": { "type": ["string", "null"] },
        "parent_field_ref": { "type": ["string", "null"] },
        "value_field_ref": { "type": ["string", "null"] },
        "draggable": { "type": "boolean" }
      }
    },
    "fieldDisplay": {
      "type": "object", "additionalProperties": false, "required": ["field_ref", "overflow", "align"],
      "properties": {
        "field_ref": { "$ref": "#/$defs/id" },
        "overflow": { "enum": ["wrap", "truncate"] },
        "align": { "enum": ["start", "center", "end"] }
      }
    },
    "media": {
      "type": "object", "additionalProperties": false,
      "required": ["source_field_ref", "kind_field_ref", "poster_field_ref"],
      "properties": {
        "source_field_ref": { "$ref": "#/$defs/id" },
        "kind_field_ref": { "type": ["string", "null"] },
        "poster_field_ref": { "type": ["string", "null"] }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "view_ref", "label", "input_field_refs"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["create", "update", "transition", "delete"] },
        "view_ref": {
          "$ref": "#/$defs/id",
          "description": "The single editor view that owns and renders this command."
        },
        "label": { "$ref": "#/$defs/localizedText" },
        "confirmation": {
          "$ref": "#/$defs/localizedText",
          "description": "User-facing confirmation required before this mutating command is dispatched. Transition and delete commands default to confirmation in the v1 compiler when omitted."
        },
        "input_field_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "fixed_values": { "type": "object" },
        "exposure": { "$ref": "#/$defs/commandExposure" },
        "guard": {
          "type": "object",
          "additionalProperties": false,
          "required": ["when", "require_nonempty"],
          "properties": {
            "when": { "$ref": "#/$defs/condition" },
            "require_nonempty": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/id" }
            }
          }
        }
      }
    },
    "commandExposure": {
      "type": "object", "additionalProperties": false,
      "required": ["placement", "presentation"],
      "properties": {
        "placement": { "enum": ["collection_header", "row_action", "editor_primary", "editor_danger"] },
        "presentation": { "enum": ["button", "icon"] }
      }
    }
  }
}
