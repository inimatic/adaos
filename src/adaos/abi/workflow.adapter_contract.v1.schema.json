{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaos.workflow.adapter_contract.v1",
  "title": "AdaOS Workflow Adapter Contract",
  "type": "object",
  "required": ["schema", "adapter_id", "kind", "owner", "implementation", "input_schema", "output_schema", "params_schema", "side_effects", "risk_classes", "permission_ceiling", "sandbox", "contract_digest"],
  "properties": {
    "schema": { "const": "adaos.workflow.adapter_contract.v1" },
    "adapter_id": { "$ref": "#/$defs/id" },
    "kind": { "enum": ["guard", "activity", "compensation"] },
    "owner": {
      "type": "object",
      "required": ["scope", "package"],
      "properties": {
        "scope": { "enum": ["platform", "package", "dependency"] },
        "package": { "type": ["string", "null"], "maxLength": 200 }
      },
      "additionalProperties": false
    },
    "implementation": { "type": "string", "minLength": 1, "maxLength": 300 },
    "input_schema": { "type": "object" },
    "output_schema": { "type": "object" },
    "params_schema": { "type": "object" },
    "side_effects": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["none", "reversible", "external", "destructive"] }
    },
    "risk_classes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["read", "local_reversible", "isolated_write", "trial_activation", "workspace_activation", "publication", "destructive"] }
    },
    "permission_ceiling": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 160 }
    },
    "sandbox": { "enum": ["pure", "core", "isolated", "trusted_package"] },
    "contract_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$" }
  },
  "additionalProperties": false
}
