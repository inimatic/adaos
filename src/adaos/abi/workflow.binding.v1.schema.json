{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaos.workflow.binding.v1",
  "title": "AdaOS Workflow Adapter Binding",
  "type": "object",
  "required": ["schema", "workflow_type", "definition_version", "definition_digest", "registry_digest", "adapters", "binding_digest"],
  "properties": {
    "schema": { "const": "adaos.workflow.binding.v1" },
    "workflow_type": { "$ref": "#/$defs/id" },
    "definition_version": { "type": "string", "minLength": 1, "maxLength": 80 },
    "definition_digest": { "$ref": "#/$defs/digest" },
    "registry_digest": { "$ref": "#/$defs/digest" },
    "adapters": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["adapter_id", "kind", "contract_digest", "owner"],
        "properties": {
          "adapter_id": { "$ref": "#/$defs/id" },
          "kind": { "enum": ["guard", "activity", "compensation"] },
          "contract_digest": { "$ref": "#/$defs/digest" },
          "owner": {
            "type": "object",
            "required": ["scope", "package"],
            "properties": {
              "scope": { "enum": ["platform", "package", "dependency"] },
              "package": { "type": ["string", "null"], "maxLength": 200 }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "binding_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  },
  "additionalProperties": false
}
