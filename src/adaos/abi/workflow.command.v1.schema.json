{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaos.workflow.command.v1",
  "title": "AdaOS Governed Workflow Command",
  "type": "object",
  "required": [
    "schema",
    "command_id",
    "workflow_type",
    "instance_ref",
    "actor_ref",
    "expected_generation",
    "idempotency_key",
    "input",
    "context_ref",
    "reply_route_ref",
    "created_at"
  ],
  "properties": {
    "schema": { "const": "adaos.workflow.command.v1" },
    "command_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$" },
    "workflow_type": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$" },
    "instance_ref": { "$ref": "#/$defs/ref" },
    "actor_ref": { "$ref": "#/$defs/ref" },
    "expected_generation": { "type": "integer", "minimum": 0 },
    "idempotency_key": { "type": "string", "minLength": 1, "maxLength": 300 },
    "input": { "type": "object" },
    "context_ref": { "oneOf": [{ "$ref": "#/$defs/ref" }, { "type": "null" }] },
    "reply_route_ref": { "oneOf": [{ "$ref": "#/$defs/ref" }, { "type": "null" }] },
    "created_at": { "type": "string", "format": "date-time" },
    "turn_trace_id": { "type": ["string", "null"], "maxLength": 240 },
    "trace": { "type": ["object", "null"] }
  },
  "$defs": {
    "ref": {
      "type": "object",
      "required": ["schema", "kind", "id"],
      "properties": {
        "schema": { "const": "adaos.workflow.ref.v1" },
        "kind": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": ["string", "null"] },
        "generation": { "type": ["integer", "null"], "minimum": 0 },
        "digest": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
