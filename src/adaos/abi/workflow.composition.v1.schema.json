{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaos.workflow.composition.v1",
  "title": "AdaOS Governed Workflow Composition",
  "type": "object",
  "required": [
    "schema",
    "composition_id",
    "parent_ref",
    "parent_authority",
    "children",
    "join",
    "partial_outcome",
    "cancellation",
    "compensation",
    "evidence_aggregation",
    "late_result"
  ],
  "properties": {
    "schema": { "const": "adaos.workflow.composition.v1" },
    "composition_id": { "$ref": "#/$defs/id" },
    "parent_ref": { "$ref": "#/$defs/ref" },
    "parent_authority": { "$ref": "#/$defs/authority" },
    "children": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "child_id",
          "workflow_type",
          "definition_version",
          "correlation_key",
          "required",
          "delegated_authority"
        ],
        "properties": {
          "child_id": { "$ref": "#/$defs/id" },
          "workflow_type": { "$ref": "#/$defs/id" },
          "definition_version": { "$ref": "#/$defs/version" },
          "correlation_key": { "type": "string", "minLength": 1, "maxLength": 300 },
          "required": { "type": "boolean" },
          "delegated_authority": { "$ref": "#/$defs/authority" }
        },
        "additionalProperties": false
      }
    },
    "join": {
      "type": "object",
      "required": ["mode", "quorum"],
      "properties": {
        "mode": { "enum": ["all", "any", "quorum"] },
        "quorum": { "type": ["integer", "null"], "minimum": 1 }
      },
      "additionalProperties": false
    },
    "partial_outcome": { "enum": ["fail", "continue_partial", "wait"] },
    "cancellation": { "enum": ["propagate", "detach"] },
    "compensation": { "enum": ["reverse_completed", "none"] },
    "evidence_aggregation": { "enum": ["all", "successful_only", "none"] },
    "late_result": { "enum": ["reject", "audit", "reconcile"] }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"
    },
    "authority": {
      "type": "object",
      "required": ["actors", "permissions"],
      "properties": {
        "actors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 200 }
        },
        "permissions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 200 }
        }
      },
      "additionalProperties": false
    },
    "ref": {
      "type": "object",
      "required": ["schema", "kind", "id"],
      "properties": {
        "schema": { "const": "adaos.workflow.ref.v1" },
        "kind": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": ["string", "null"] },
        "generation": { "type": ["integer", "null"], "minimum": 0 },
        "digest": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
