{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaos.workflow.definition_artifact.v1",
  "title": "AdaOS Workflow Definition Artifact Binding",
  "type": "object",
  "required": ["schema", "component", "package_digest", "definition", "validation", "binding_digest", "adapter_locks", "definition_changed", "binding_changed", "migration_id"],
  "properties": {
    "schema": { "const": "adaos.workflow.definition_artifact.v1" },
    "component": { "type": "string", "minLength": 1, "maxLength": 240 },
    "package_digest": { "$ref": "#/$defs/digest" },
    "definition": { "$ref": "#/$defs/contractLock" },
    "validation": { "oneOf": [{ "$ref": "#/$defs/contractLock" }, { "type": "null" }] },
    "binding_digest": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
    "adapter_locks": {
      "type": "array",
      "items": { "$ref": "workflow.binding.v1.schema.json#/$defs/adapterLock" }
    },
    "definition_changed": { "type": "boolean" },
    "binding_changed": { "type": "boolean" },
    "migration_id": { "type": ["string", "null"], "maxLength": 200 }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "contractLock": {
      "type": "object",
      "required": ["lock_id", "digest"],
      "properties": {
        "lock_id": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
