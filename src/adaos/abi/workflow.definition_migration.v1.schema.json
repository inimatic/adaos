{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaos.workflow.definition_migration.v1",
  "title": "AdaOS Governed Workflow Definition Migration",
  "type": "object",
  "required": [
    "schema",
    "migration_id",
    "workflow_type",
    "from_definition_version",
    "to_definition_version",
    "allowed_source_states",
    "state_map",
    "context_set",
    "context_remove",
    "authority",
    "explanation"
  ],
  "properties": {
    "schema": { "const": "adaos.workflow.definition_migration.v1" },
    "migration_id": { "$ref": "#/$defs/id" },
    "workflow_type": { "$ref": "#/$defs/id" },
    "from_definition_version": { "$ref": "#/$defs/version" },
    "to_definition_version": { "$ref": "#/$defs/version" },
    "allowed_source_states": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "state_map": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/id" }
    },
    "context_set": { "type": "object" },
    "context_remove": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "authority": {
      "type": "object",
      "required": ["actors", "permissions"],
      "properties": {
        "actors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 200 }
        },
        "permissions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 200 }
        }
      },
      "additionalProperties": false
    },
    "explanation": { "type": "string", "minLength": 1, "maxLength": 1000 }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"
    }
  },
  "additionalProperties": false
}
