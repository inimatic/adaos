{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaos.workflow.ingress_conformance.v1",
  "title": "AdaOS Cross-Channel Workflow Ingress Conformance",
  "type": "object",
  "required": [
    "schema", "valid", "generated_at", "required_channels",
    "semantic_digest", "channels", "diagnostics"
  ],
  "properties": {
    "schema": { "const": "adaos.workflow.ingress_conformance.v1" },
    "valid": { "type": "boolean" },
    "generated_at": { "type": "string", "format": "date-time" },
    "required_channels": {
      "type": "array",
      "const": ["web", "telegram", "text", "sdk"]
    },
    "semantic_digest": {
      "type": ["string", "null"],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "channels": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "channel", "invocation_id", "semantic_digest", "workflow_type",
          "command_id", "expected_generation", "target_ref", "guard",
          "executor", "execution"
        ],
        "properties": {
          "channel": { "enum": ["web", "telegram", "text", "sdk"] },
          "invocation_id": { "type": "string", "minLength": 1, "maxLength": 240 },
          "semantic_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "workflow_type": { "type": "string", "minLength": 1, "maxLength": 160 },
          "command_id": { "type": "string", "minLength": 1, "maxLength": 160 },
          "expected_generation": { "type": "integer", "minimum": 0 },
          "target_ref": { "type": ["object", "null"] },
          "guard": {
            "type": "object",
            "required": ["accepted", "reason_code", "transition_id"],
            "properties": {
              "accepted": { "type": "boolean" },
              "reason_code": { "type": ["string", "null"], "maxLength": 240 },
              "transition_id": { "type": ["string", "null"], "maxLength": 160 }
            },
            "additionalProperties": false
          },
          "executor": {
            "type": "object",
            "required": ["available", "adapter_id", "executor_id", "reason_code"],
            "properties": {
              "available": { "type": "boolean" },
              "adapter_id": { "type": ["string", "null"], "maxLength": 240 },
              "executor_id": { "type": ["string", "null"], "maxLength": 240 },
              "reason_code": { "type": ["string", "null"], "maxLength": 240 }
            },
            "additionalProperties": true
          },
          "execution": {
            "type": "object",
            "required": ["accepted", "status", "reason_code"],
            "properties": {
              "accepted": { "type": "boolean" },
              "status": { "type": "string", "minLength": 1, "maxLength": 80 },
              "reason_code": { "type": ["string", "null"], "maxLength": 240 }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "diagnostics": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["code", "severity", "path", "message"],
        "properties": {
          "code": { "type": "string", "minLength": 1, "maxLength": 240 },
          "severity": { "enum": ["warning", "error"] },
          "path": { "type": "string", "minLength": 1, "maxLength": 500 },
          "message": { "type": "string", "minLength": 1, "maxLength": 1000 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
