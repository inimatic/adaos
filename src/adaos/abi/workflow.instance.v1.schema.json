{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaos.workflow.instance.v1",
  "title": "AdaOS Governed Workflow Instance",
  "type": "object",
  "required": ["schema", "instance_id", "workflow_type", "definition_version", "state", "generation", "context", "history", "idempotency"],
  "properties": {
    "schema": { "const": "adaos.workflow.instance.v1" },
    "instance_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "workflow_type": { "type": "string", "minLength": 1, "maxLength": 160 },
    "definition_version": { "type": "string", "minLength": 1, "maxLength": 80 },
    "state": { "type": "string", "minLength": 1, "maxLength": 160 },
    "generation": { "type": "integer", "minimum": 0 },
    "context": { "type": "object" },
    "history": { "type": "array", "maxItems": 200, "items": { "type": "object" } },
    "idempotency": { "type": "array", "maxItems": 200, "items": { "type": "object" } },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
