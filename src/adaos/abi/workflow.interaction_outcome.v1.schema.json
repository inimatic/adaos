{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaos.workflow.interaction_outcome.v1",
  "title": "AdaOS Workflow Interaction Outcome",
  "type": "object",
  "required": [
    "schema", "interaction_id", "response_id", "dispatch_id", "status",
    "terminal", "reason_code", "effect_assertion", "outcome"
  ],
  "properties": {
    "schema": {"const": "adaos.workflow.interaction_outcome.v1"},
    "interaction_id": {"type": "string", "minLength": 1, "maxLength": 240},
    "response_id": {"type": "string", "minLength": 1, "maxLength": 240},
    "dispatch_id": {"type": "string", "minLength": 1, "maxLength": 240},
    "status": {
      "enum": [
        "pending", "dispatching", "dispatched", "succeeded", "failed",
        "rejected", "input_required", "outcome_unknown", "cancelled"
      ]
    },
    "terminal": {"type": "boolean"},
    "reason_code": {"type": ["string", "null"], "maxLength": 160},
    "effect_assertion": {"type": ["object", "null"]},
    "outcome": {"type": "object"}
  },
  "additionalProperties": false
}
