{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaos.workflow.invocation.v1",
  "title": "AdaOS Canonical Workflow Invocation",
  "type": "object",
  "required": [
    "schema", "invocation_id", "source", "conversation_id",
    "interaction_ref", "response_ref", "target_ref", "risk",
    "confirmation_required", "command", "created_at"
  ],
  "properties": {
    "schema": { "const": "adaos.workflow.invocation.v1" },
    "invocation_id": { "type": "string", "minLength": 1, "maxLength": 240 },
    "source": { "enum": ["web", "telegram", "text", "intent", "sdk", "system"] },
    "conversation_id": { "type": ["string", "null"], "maxLength": 240 },
    "interaction_ref": { "oneOf": [{ "$ref": "#/$defs/ref" }, { "type": "null" }] },
    "response_ref": { "oneOf": [{ "$ref": "#/$defs/ref" }, { "type": "null" }] },
    "target_ref": { "type": ["object", "null"] },
    "risk": {
      "enum": [
        "read", "local_reversible", "isolated_write", "trial_activation",
        "workspace_activation", "publication", "destructive"
      ]
    },
    "confirmation_required": { "type": "boolean" },
    "command": { "$ref": "workflow.command.v1.schema.json" },
    "created_at": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object" },
    "turn_trace_id": { "type": ["string", "null"], "maxLength": 240 },
    "trace": { "type": ["object", "null"] }
  },
  "$defs": {
    "ref": {
      "type": "object",
      "required": ["schema", "kind", "id"],
      "properties": {
        "schema": { "const": "adaos.workflow.ref.v1" },
        "kind": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": ["string", "null"] },
        "generation": { "type": ["integer", "null"], "minimum": 0 },
        "digest": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
