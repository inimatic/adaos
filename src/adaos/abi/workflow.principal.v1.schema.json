{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaos.workflow.principal.v1",
  "title": "AdaOS Verified Workflow Principal",
  "type": "object",
  "required": ["schema", "actor_id", "issuer", "subject", "authentication", "roles", "permissions", "claims_digest"],
  "properties": {
    "schema": { "const": "adaos.workflow.principal.v1" },
    "actor_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "issuer": { "type": "string", "minLength": 1, "maxLength": 200 },
    "subject": { "type": "string", "minLength": 1, "maxLength": 300 },
    "authentication": { "enum": ["anonymous", "verified"] },
    "roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["guest", "registered"] }
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 160 }
    },
    "claims_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  },
  "additionalProperties": false
}
