{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaos.workflow.publication_admission.v1",
  "title": "AdaOS Workflow Publication Admission",
  "type": "object",
  "required": [
    "schema",
    "release_digest",
    "slot_id",
    "observed_lock_digest",
    "desired_lock_digest",
    "desired_lock_updated_at",
    "packages",
    "workflow_admission",
    "admission_digest",
    "status"
  ],
  "properties": {
    "schema": { "const": "adaos.workflow.publication_admission.v1" },
    "release_digest": { "$ref": "#/$defs/digest" },
    "slot_id": { "type": "string", "minLength": 1, "maxLength": 160 },
    "observed_lock_digest": {
      "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }]
    },
    "desired_lock_digest": { "$ref": "#/$defs/digest" },
    "desired_lock_updated_at": { "type": "string", "format": "date-time" },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "component",
          "package_digest",
          "manifest_digest",
          "definition_digest",
          "validation_digest",
          "binding_digest",
          "role_policy_digest"
        ],
        "properties": {
          "component": { "type": "string", "minLength": 1, "maxLength": 240 },
          "package_digest": { "$ref": "#/$defs/digest" },
          "manifest_digest": { "$ref": "#/$defs/digest" },
          "definition_digest": {
            "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }]
          },
          "validation_digest": {
            "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }]
          },
          "binding_digest": {
            "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }]
          },
          "role_policy_digest": {
            "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }]
          }
        },
        "additionalProperties": false
      }
    },
    "workflow_admission": { "$ref": "workflow.admission.v1.schema.json" },
    "admission_digest": { "$ref": "#/$defs/digest" },
    "status": { "const": "admitted" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  },
  "additionalProperties": false
}
