{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaos.workflow.publication_admission.v1",
  "title": "AdaOS Workflow Publication Admission",
  "type": "object",
  "required": [
    "schema",
    "release_digest",
    "slot_id",
    "observed_lock_digest",
    "desired_lock_digest",
    "desired_lock_updated_at",
    "packages",
    "workflow_admission",
    "admission_digest",
    "status"
  ],
  "properties": {
    "schema": { "const": "adaos.workflow.publication_admission.v1" },
    "release_digest": { "$ref": "#/$defs/digest" },
    "slot_id": { "type": "string", "minLength": 1, "maxLength": 160 },
    "observed_lock_digest": {
      "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }]
    },
    "desired_lock_digest": { "$ref": "#/$defs/digest" },
    "desired_lock_updated_at": { "type": "string", "format": "date-time" },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "component",
          "package_digest",
          "manifest_digest",
          "definition_digest",
          "validation_digest",
          "binding_digest",
          "role_policy_digest"
        ],
        "properties": {
          "component": { "type": "string", "minLength": 1, "maxLength": 240 },
          "package_digest": { "$ref": "#/$defs/digest" },
          "manifest_digest": { "$ref": "#/$defs/digest" },
          "definition_digest": {
            "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }]
          },
          "validation_digest": {
            "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }]
          },
          "binding_digest": {
            "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }]
          },
          "role_policy_digest": {
            "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }]
          }
        },
        "additionalProperties": false
      }
    },
    "workflow_admission": { "$ref": "workflow.admission.v1.schema.json" },
    "shared_skill_rebindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "schema",
          "status",
          "skill_ref",
          "active_package_digest",
          "candidate_package_digest",
          "active_consumers",
          "contract_fingerprint",
          "policy",
          "evidence_digest"
        ],
        "properties": {
          "schema": {
            "const": "adaos.artifact.contract_preserving_rebinding.v1"
          },
          "status": { "const": "admissible" },
          "skill_ref": { "type": "string", "pattern": "^skill:[^\\s]+$" },
          "active_package_digest": { "$ref": "#/$defs/digest" },
          "candidate_package_digest": { "$ref": "#/$defs/digest" },
          "active_consumers": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 240 }
          },
          "contract_fingerprint": {
            "type": "object",
            "required": ["contract_members", "entrypoints"],
            "properties": {
              "contract_members": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": { "$ref": "#/$defs/digest" }
              },
              "entrypoints": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "array",
                  "minItems": 4,
                  "maxItems": 4,
                  "items": { "type": "string" }
                }
              }
            },
            "additionalProperties": false
          },
          "policy": {
            "const": "exact_capability_binding_and_entrypoint_equivalence"
          },
          "evidence_digest": { "$ref": "#/$defs/digest" }
        },
        "additionalProperties": false
      }
    },
    "admission_digest": { "$ref": "#/$defs/digest" },
    "status": { "const": "admitted" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  },
  "additionalProperties": false
}
