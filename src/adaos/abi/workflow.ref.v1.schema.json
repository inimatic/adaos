{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaos.workflow.ref.v1",
  "title": "AdaOS Governed Workflow Typed Reference",
  "type": "object",
  "required": ["schema", "kind", "id"],
  "properties": {
    "schema": { "const": "adaos.workflow.ref.v1" },
    "kind": {
      "enum": [
        "principal",
        "aggregate",
        "workflow",
        "task",
        "artifact",
        "evidence",
        "interaction",
        "command_context",
        "reply_route",
        "component",
        "release",
        "view"
      ]
    },
    "id": { "type": "string", "minLength": 1, "maxLength": 500 },
    "version": { "type": ["string", "null"], "maxLength": 160 },
    "generation": { "type": ["integer", "null"], "minimum": 0 },
    "digest": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" }
  },
  "additionalProperties": false
}
