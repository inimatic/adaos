{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adaos.dev/abi/workspace.lock.v1.schema.json",
  "title": "AdaOS Workspace Lock v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "lock_revision",
    "updated_at",
    "slots",
    "components",
    "bindings",
    "lock_digest"
  ],
  "properties": {
    "schema": { "const": "adaos.workspace.lock.v1" },
    "lock_revision": { "type": "integer", "minimum": 1 },
    "previous_lock_revision": { "type": "integer", "minimum": 1 },
    "updated_at": { "type": "string", "minLength": 1 },
    "slots": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["project_id", "release", "release_digest"],
        "properties": {
          "project_id": { "$ref": "#/$defs/artifactId" },
          "release": { "type": "string", "minLength": 1 },
          "release_digest": { "$ref": "#/$defs/digest" },
          "audience": { "type": "string", "minLength": 1 }
        }
      }
    },
    "components": {
      "type": "array",
      "items": { "type": "object" }
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["consumer", "dependency", "package_digest"],
        "properties": {
          "consumer": { "type": "string", "minLength": 1 },
          "dependency": { "type": "string", "minLength": 1 },
          "package_digest": { "$ref": "#/$defs/digest" }
        }
      }
    },
    "lock_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "artifactId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
