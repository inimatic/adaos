{
  "$schema": "../../../../src/adaos/abi/webui.v1.schema.json",
  "apps": [
    {
      "id": "voice_assistant_app",
      "title": "Voice Assistant",
      "subtitle": "Local Android assistant",
      "icon": "mic-outline",
      "launchModal": "voice_assistant_modal",
      "action": {
        "navigate": "voice_assistant.voice_assistant_modal"
      }
    }
  ],
  "registry": {
    "modals": {
      "voice_assistant_modal": {
        "title": "Voice Assistant",
        "schema": {
          "id": "voice_assistant_modal",
          "layout": {
            "type": "single",
            "pattern": "stack",
            "areas": [
              {
                "id": "main",
                "role": "main"
              }
            ]
          },
          "widgets": [
            {
              "id": "android-voice-input",
              "type": "ui.voiceInput",
              "area": "main",
              "title": "Speak",
              "inputs": {
                "startLabel": "Listen",
                "stopLabel": "Stop",
                "sendCommand": "dialog.user_message",
                "scope": "local",
                "channelSelector": true,
                "agentSelector": true,
                "agentSelectorLabel": "Ассистент",
                "agentChip": true,
                "autoSpeak": true,
                "autoSpeakFrom": "hub",
                "autoSpeakLang": "ru-RU",
                "listeningMode": "activation",
                "activationAliases": [
                  "Ада",
                  "AdaOS",
                  "ассистент"
                ],
                "meta": {
                  "route_id": "voice_chat",
                  "voice_chat_scope": "local"
                },
                "stt": {
                  "provider": "browser",
                  "lang": "ru-RU",
                  "autoSend": true,
                  "pushToTalk": false,
                  "readyCue": false,
                  "autoStart": true,
                  "listeningMode": "activation"
                }
              },
              "dataSource": {
                "kind": "y",
                "path": "data/voice_chat",
                "scope": "local"
              }
            },
            {
              "id": "android-voice-chat",
              "type": "ui.chat",
              "area": "main",
              "title": "Conversation",
              "dataSource": {
                "kind": "y",
                "path": "data/voice_chat",
                "scope": "local",
                "observeRoot": true
              },
              "inputs": {
                "sendCommand": "dialog.user_message",
                "scope": "local",
                "alignRightFrom": "user",
                "placeholder": "Ask an assistant about node status or weather",
                "historyButton": false,
                "meta": {
                  "route_id": "voice_chat",
                  "voice_chat_scope": "local"
                }
              }
            }
          ],
          "interface": {
            "schema": "adaos.ui.modal.interface.v1",
            "routes": {
              "voice_assistant": {
                "view": "voice_assistant.voice_assistant_modal"
              }
            },
            "defaultRoute": "voice_assistant"
          }
        },
        "implements": [
          "voice_assistant.voice_assistant_modal"
        ]
      }
    },
    "widgets": {}
  },
  "ydoc_defaults": {
    "data/voice_chat": {
      "messages": [],
      "status": "ready",
      "assistant": {
        "id": "agent:android:local",
        "label": "AdaOS Mobile",
        "voice": "ru-RU",
        "scope": "local"
      }
    }
  },
  "contributions": [
    {
      "extensionPoint": "desktop.apps",
      "type": "app",
      "id": "voice_assistant_app",
      "autoInstall": true
    }
  ],
  "interface": {
    "schema": "adaos.ui.skill_interface.v1",
    "views": {
      "voice_assistant.voice_assistant_modal": {
        "title": "Voice Assistant",
        "surfaces": [
          "modal"
        ],
        "params": {}
      }
    },
    "defaultView": "voice_assistant.voice_assistant_modal"
  }
}
